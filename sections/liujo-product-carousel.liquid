          demo_img_back: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw7e7b58ae/images/E-ZB7305D041679212-4-N.jpeg?sw=594&sh=826'
        -%}

        {%- render 'liujo-product-card',
          demo_id: 'zb7307',
          demo_title: 'Oversized jacket in denim with rhinestones',
