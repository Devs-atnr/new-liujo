{% comment %}
  LIU JO PRODUCT CAROUSEL SECTION
  Matches the "Explore the Looks" draggable product list carousel on https://www.liujo.com
{% endcomment %}

<div class="liujo-product-carousel-section liujo-product-carousel-section--{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="liujo-product-carousel" data-liujo-carousel>
  <style>
    .liujo-product-carousel-section--{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 40 }}px;
      background-color: {{ section.settings.bg_color | default: '#ffffff' }};
      width: 100%;
      overflow: hidden;
      box-sizing: border-box;
    }
    .liujo-product-carousel-section--{{ section.id }} .liujo-carousel-track-wrapper {
      padding: 0 !important;
      width: 100%;
      box-sizing: border-box;
      position: relative;
      overflow: hidden;
    }
    .liujo-product-carousel-section--{{ section.id }} .liujo-carousel-track {
      display: flex;
      flex-wrap: nowrap;
      gap: {{ section.settings.gap_desktop | default: 0 }}px !important;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scroll-behavior: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none !important;
      margin: 0;
      padding: 0;
      list-style: none;
      width: 100%;
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
    }
    .liujo-product-carousel-section--{{ section.id }} .liujo-carousel-track::-webkit-scrollbar {
      display: none !important;
    }
    .liujo-product-carousel-section--{{ section.id }} .liujo-carousel-track,
    .liujo-product-carousel-section--{{ section.id }} .liujo-carousel-track *,
    .liujo-product-carousel-section--{{ section.id }} .liujo-product-card-wrap,
    .liujo-product-carousel-section--{{ section.id }} .liujo-product-card-wrap img,
    .liujo-product-carousel-section--{{ section.id }} .liujo-product-card-wrap a {
      -webkit-user-drag: none !important;
      user-drag: none !important;
    }
    .liujo-product-carousel-section--{{ section.id }} .liujo-product-card-wrap {
      flex: 0 0 calc(100% / {{ section.settings.columns_desktop | default: 6 }}) !important;
      min-width: calc(100% / {{ section.settings.columns_desktop | default: 6 }}) !important;
      max-width: calc(100% / {{ section.settings.columns_desktop | default: 6 }}) !important;
      margin: 0 !important;
      padding: 0 !important;
      box-sizing: border-box;
      scroll-snap-align: start;
    }
    @media (max-width: 1024px) {
      .liujo-product-carousel-section--{{ section.id }} .liujo-product-card-wrap {
        flex: 0 0 25% !important;
        min-width: 25% !important;
        max-width: 25% !important;
      }
    }
    @media (max-width: 767px) {
      .liujo-product-carousel-section--{{ section.id }} .liujo-carousel-track {
        gap: {{ section.settings.gap_mobile | default: 0 }}px !important;
      }
      .liujo-product-carousel-section--{{ section.id }} .liujo-product-card-wrap {
        flex: 0 0 calc(100% / {{ section.settings.columns_mobile | default: 2 }}) !important;
        min-width: calc(100% / {{ section.settings.columns_mobile | default: 2 }}) !important;
        max-width: calc(100% / {{ section.settings.columns_mobile | default: 2 }}) !important;
      }
    }
    {% unless section.settings.show_arrows %}
      .liujo-product-carousel-section--{{ section.id }} .liujo-carousel-arrow {
        display: none !important;
      }
    {% endunless %}
  </style>

  {%- if section.settings.show_header and section.settings.title != blank -%}
    <div class="liujo-section-header" style="text-align: center; margin-bottom: 24px;">
      <h2 class="liujo-title-display">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <div class="liujo-subtitle" style="margin-top: 8px;">{{ section.settings.subtitle }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="liujo-carousel-track-wrapper">
    <!-- Prev Arrow Button -->
    <button type="button" class="liujo-carousel-arrow arrow-prev" data-carousel-prev aria-label="Previous Products">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>

    <div class="liujo-carousel-track" data-carousel-track>
      {%- assign selected_collection = collections[section.settings.collection] -%}
      {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
        {%- for product in selected_collection.products limit: section.settings.products_to_show -%}
          {%- render 'liujo-product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
