          demo_img_front: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw9e6fac8b/images/E-ZB7307D041679212-4-N.jpeg?sw=594&sh=826',
          demo_img_back: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw2127c151/images/E-ZB7307D041679212-3-N.jpeg?sw=594&sh=826'
        -%}

        {%- render 'liujo-product-card',
          demo_id: 'zb7301',
          demo_title: 'Flare jeans with scarf',
          demo_price: '€ 219.00',
          demo_img_front: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw0fc7c95b/images/E-ZB7301T055B79215-4-N.jpeg?sw=594&sh=826',
          demo_img_back: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dwb9dbf93d/images/E-ZB7301T055B79215-3-N.jpeg?sw=594&sh=826'
        -%}

        {%- render 'liujo-product-card',
          demo_id: 'zb7302',
          demo_title: 'Shirt in denim with digital print',
          demo_price: '€ 179.00',
          demo_img_front: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw579b6e6e/images/E-ZB7302T055B79215-3-N.jpeg?sw=594&sh=826',
          demo_img_back: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dwc796710a/images/E-ZB7302T055B79215-4-N.jpeg?sw=594&sh=826'
        -%}

        {%- render 'liujo-product-card',
          demo_id: 'zb7303',
          demo_title: 'Jacket in denim with alamari',
          demo_price: '€ 259.00',
          demo_img_front: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw5aa23c3f/images/E-ZB7303D042979253-3-N.jpeg?sw=594&sh=826',
          demo_img_back: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw47caca33/images/E-ZB7303D042979253-4-N.jpeg?sw=594&sh=826'
        -%}

        {%- render 'liujo-product-card',
          demo_id: 'zb7304',
          demo_title: 'Cropped Jeans low-waisted',
          demo_price: '€ 199.00',
          demo_img_front: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw8e4668b4/images/E-ZB7304D485479260-4-N.jpeg?sw=594&sh=826',
          demo_img_back: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dwa22d26ba/images/E-ZB7304D485479260-3-N.jpeg?sw=594&sh=826'
        -%}

        {%- render 'liujo-product-card',
          demo_id: 'zb4b70',
          demo_title: 'Ankle boots in suede chocolate',
          demo_price: '€ 279.00',
          demo_img_front: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dwad3a193a/images/E-4B7001PX002S1815-7-N.jpeg?sw=594&sh=826',
          demo_img_back: 'https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw398aeb5d/images/E-4B7001PX002S1815-6-N.jpeg?sw=594&sh=826'
        -%}
      {%- endif -%}
    </div>

    <!-- Next Arrow Button -->
    <button type="button" class="liujo-carousel-arrow arrow-next" data-carousel-next aria-label="Next Products">
      <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>

  {%- if section.settings.show_view_all and section.settings.collection != blank -%}
    <div style="text-align: center; margin-top: 40px;">
      <a href="{{ collections[section.settings.collection].url }}" class="btn-editorial-outline">
        {{ section.settings.view_all_label | default: 'View all products' }}
      </a>
    </div>
  {%- endif -%}
</div>

<script>
  (function() {
    function initHomepageCarousel() {
      var section = document.querySelector('.liujo-product-carousel-section--{{ section.id }}');
      if (!section) return;
      var track = section.querySelector('[data-carousel-track]');
      if (!track || track._hasLiuJoDrag) return;
      track._hasLiuJoDrag = true;

      track.querySelectorAll('img, a').forEach(function(el) {
        el.setAttribute('draggable', 'false');
      });

      // Mouse Wheel Horizontal Scroll
      var wheelTimer = null;
      track.addEventListener('wheel', function(e) {
        var delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        if (Math.abs(delta) > 0) {
          var canScrollRight = delta > 0 && (track.scrollLeft + track.clientWidth < track.scrollWidth - 4);
          var canScrollLeft = delta < 0 && track.scrollLeft > 4;
          if (canScrollRight || canScrollLeft) {
            e.preventDefault();
            track.style.scrollSnapType = 'none';
            track.scrollLeft += delta * 1.25;
            clearTimeout(wheelTimer);
            wheelTimer = setTimeout(function() {
              track.style.scrollSnapType = 'x proximity';
            }, 120);
          }
        }
      }, { passive: false });

      // Mouse Drag
      var isDown = false;
      var startX = 0;
      var scrollLeft = 0;
      var hasDragged = false;

      track.addEventListener('mousedown', function(e) {
        if (e.button !== 0) return;
        if (e.target.closest('button, [data-liujo-wishlist]')) return;
        isDown = true;
        hasDragged = false;
        startX = e.pageX;
        scrollLeft = track.scrollLeft;
      });

      window.addEventListener('mousemove', function(e) {
        if (!isDown) return;
        var diff = e.pageX - startX;
        if (Math.abs(diff) > 5) {
          hasDragged = true;
          track.classList.add('is-dragging');
          track.style.scrollSnapType = 'none';
          e.preventDefault();
        }
        if (hasDragged) {
          track.scrollLeft = scrollLeft - (diff * 1.35);
        }
      });

      window.addEventListener('mouseup', function() {
        if (!isDown) return;
        isDown = false;
        track.classList.remove('is-dragging');
        track.style.scrollSnapType = 'x proximity';
        setTimeout(function() {
          hasDragged = false;
        }, 150);
      });

      // Capture phase click listener prevents opening link when dragged
      track.addEventListener('click', function(e) {
        if (hasDragged) {
          e.preventDefault();
          e.stopPropagation();
          return false;
        }
      }, true);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHomepageCarousel);
    } else {
      initHomepageCarousel();
    }
  })();
</script>

{% schema %}
{
  "name": "Liu Jo Product Carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show Header (Title / Subtitle)",
      "default": false
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Explore the Looks"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The latest styles handpicked for this season"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "default": 8,
      "label": "Number of products to show"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop Columns Visible",
      "options": [
        { "value": "4", "label": "4 Columns" },
        { "value": "5", "label": "5 Columns" },
        { "value": "6", "label": "6 Columns (Reference Image Parity)" }
      ],
      "default": "6"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns Visible",
      "options": [
        { "value": "2", "label": "2 Columns (Reference Image Parity)" },
        { "value": "3", "label": "3 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Desktop Gap",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Mobile Gap",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Button Label",
      "default": "See all Clothing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Liu Jo Product Carousel"
    }
  ]
}
{% endschema %}
