<section class="care-page care-page--{{ section.settings.page_type }}" id="CarePage-{{ section.id }}">
  <div class="care-page__hero"><h1>{{ section.settings.heading | escape }}</h1></div>
  <div class="care-page__content">
    {% case section.settings.page_type %}
      {% when 'profile' %}
        <div class="care-page__actions">
          <a class="care-page__button" href="{{ routes.account_login_url }}">{{ section.settings.login_label | escape }} <span aria-hidden="true">→</span></a>
          <a class="care-page__button" href="{{ routes.account_register_url }}">{{ section.settings.register_label | escape }} <span aria-hidden="true">→</span></a>
        </div>
      {% when 'order' %}
        <h2>{{ section.settings.subheading | escape }}</h2><div class="rte">{{ section.settings.body }}</div>
        <form class="care-page__form" action="{{ section.settings.form_action | default: routes.root_url }}" method="get">
          <label>{{ section.settings.order_label | escape }}<input name="{{ section.settings.order_param | escape }}" required autocomplete="off"></label>
          <label>{{ section.settings.email_label | escape }}<input type="email" name="{{ section.settings.email_param | escape }}" required autocomplete="email"></label>
          <button class="care-page__submit" type="submit">{{ section.settings.submit_label | escape }}</button>
        </form>
      {% when 'returns' %}
        <h2>{{ section.settings.subheading | escape }}</h2><div class="rte">{{ section.settings.body }}</div>
        {% if section.settings.form_action != blank %}
          <form class="care-page__form" action="{{ section.settings.form_action | escape }}" method="get">
            <label>{{ section.settings.order_label | escape }}<input name="{{ section.settings.order_param | escape }}" required></label>
            <label>{{ section.settings.email_label | escape }}<input type="email" name="{{ section.settings.email_param | escape }}" required autocomplete="email"></label>
            <button class="care-page__submit" type="submit">{{ section.settings.submit_label | escape }}</button>
          </form>
        {% else %}<p class="care-page__note">{{ section.settings.integration_note | escape }}</p>{% endif %}
      {% when 'wishlist' %}
        <div class="care-page__wishlist" data-wishlist-key="{{ section.settings.wishlist_storage_key | escape }}" data-empty="{{ section.settings.empty_message | escape }}" aria-live="polite"></div>
    {% endcase %}
  </div>
</section>
<style>
#CarePage-{{ section.id }}{max-width:1500px;margin:0 auto;padding:{{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;color:#090909}.care-page__hero{min-height:140px;display:flex;align-items:center;justify-content:center;background:#f6f7f8;text-align:center;padding:24px;margin-bottom:26px}.care-page__hero h1{font-size:clamp(22px,2vw,28px);font-weight:500;text-transform:uppercase;margin:0}.care-page__content h2{font-size:18px;text-transform:uppercase}.care-page__content{font-size:14px;line-height:1.55}.care-page__actions{display:grid;gap:12px;max-width:520px}.care-page__button{display:flex;justify-content:space-between;align-items:center;padding:18px 20px;border:1px solid #dedede;color:inherit;text-decoration:none;font-weight:600;text-transform:uppercase}.care-page__button:hover{background:#000;color:#fff}.care-page__button span{font-size:24px}.care-page__form{display:grid;grid-template-columns:1fr 1fr;gap:18px 14px;margin-top:26px}.care-page__form label{display:grid;gap:8px;font-size:12px;text-transform:uppercase}.care-page__form input{height:50px;border:1px solid #d5d5d5;padding:10px;font:inherit}.care-page__submit{grid-column:1;min-height:52px;margin-top:10px;border:0;background:#000;color:#fff;font:inherit;font-weight:600;text-transform:uppercase;cursor:pointer}.care-page__note{padding:16px;background:#f6f7f8}.care-page__wishlist{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:20px}.care-page__product{color:inherit;text-decoration:none}.care-page__product img{width:100%;height:auto;display:block}.care-page__product-title{margin:10px 0 4px;font-weight:600}.care-page__empty{margin:0}@media(max-width:749px){#CarePage-{{ section.id }}{padding-left:16px;padding-right:16px}.care-page__hero{min-height:100px}.care-page__form{grid-template-columns:1fr}.care-page__submit{grid-column:1}}
</style>
{% if section.settings.page_type == 'wishlist' %}
<script>
(()=>{const root=document.querySelector('#CarePage-{{ section.id }} [data-wishlist-key]');if(!root)return;let items=[];try{items=JSON.parse(localStorage.getItem(root.dataset.wishlistKey)||'[]')}catch(e){}if(!Array.isArray(items)||!items.length){root.innerHTML='<p class="care-page__empty"></p>';root.firstElementChild.textContent=root.dataset.empty;return}root.replaceChildren(...items.map(item=>{const a=document.createElement('a');a.className='care-page__product';a.href=item.url||'#';if(item.image){const img=document.createElement('img');img.src=item.image;img.alt=item.title||'';a.append(img)}const title=document.createElement('p');title.className='care-page__product-title';title.textContent=item.title||'Product';a.append(title);if(item.price){const price=document.createElement('span');price.textContent=item.price;a.append(price)}return a}))})();
</script>
{% endif %}
{% schema %}
{"name":"Customer care page","settings":[{"type":"select","id":"page_type","label":"Page type","options":[{"value":"profile","label":"Profile links"},{"value":"order","label":"Monitor your order"},{"value":"returns","label":"Exchanges and returns"},{"value":"wishlist","label":"Wishlist"}],"default":"order"},{"type":"text","id":"heading","label":"Page heading","default":"Monitor your order"},{"type":"text","id":"subheading","label":"Section heading","default":"Monitor your order"},{"type":"richtext","id":"body","label":"Description","default":"<p>Enter the order number and email address used at checkout.</p>"},{"type":"text","id":"login_label","label":"Login link label","default":"Log in"},{"type":"text","id":"register_label","label":"Create account link label","default":"Create account"},{"type":"text","id":"order_label","label":"Order field label","default":"Order number"},{"type":"text","id":"email_label","label":"Email field label","default":"Order email"},{"type":"text","id":"order_param","label":"Order query parameter","default":"order"},{"type":"text","id":"email_param","label":"Email query parameter","default":"email"},{"type":"text","id":"submit_label","label":"Submit label","default":"Submit"},{"type":"url","id":"form_action","label":"Tracking or returns service URL","info":"Add the URL provided by your tracking or returns service."},{"type":"text","id":"integration_note","label":"Returns integration note","default":"Connect your returns portal URL in this section's settings to enable the return form."},{"type":"text","id":"wishlist_storage_key","label":"Wishlist local storage key","default":"wishlist"},{"type":"text","id":"empty_message","label":"Empty wishlist message","default":"There are no products"},{"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":100,"step":4,"unit":"px","default":40},{"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":100,"step":4,"unit":"px","default":40}],"presets":[{"name":"Customer care page"}]}
{% endschema %}
