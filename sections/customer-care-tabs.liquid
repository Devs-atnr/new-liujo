{% comment %}Editable customer-care tabs; each block supplies one left menu item and its right-panel content.{% endcomment %}
<section id="CustomerCare-{{ section.id }}" class="cc-tabs">
  <div class="cc-layout">
    <aside class="cc-side" aria-label="Customer care navigation">
      {% assign cc_groups = 'profile,care' | split: ',' %}
      {% for group in cc_groups %}
        {% assign has_items = false %}{% for block in section.blocks %}{% if block.settings.group == group %}{% assign has_items = true %}{% break %}{% endif %}{% endfor %}
        {% if has_items %}<div class="cc-group"><h2>{% if group == 'profile' %}{{ section.settings.profile_heading | escape }}{% else %}{{ section.settings.care_heading | escape }}{% endif %}</h2><nav>
          {% for block in section.blocks %}{% if block.settings.group == group %}<button type="button" class="cc-link" data-cc-button="{{ block.id }}" aria-controls="cc-panel-{{ section.id }}-{{ block.id }}" aria-selected="false" role="tab" {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span><span aria-hidden="true">→</span></button>{% endif %}{% endfor %}
        </nav></div>{% endif %}
      {% endfor %}
      {% if section.settings.show_contact %}<div class="cc-contact"><h2>{{ section.settings.contact_heading | escape }}</h2>{% if section.settings.phone != blank %}<a href="tel:{{ section.settings.phone | remove: ' ' | escape }}">☎<span>{{ section.settings.phone | escape }}</span></a>{% endif %}{% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email | escape }}">✉<span>{{ section.settings.email_label | escape }}</span></a>{% endif %}</div>{% endif %}
    </aside>
    <div class="cc-main">
      {% for block in section.blocks %}<article id="cc-panel-{{ section.id }}-{{ block.id }}" class="cc-panel" data-cc-panel="{{ block.id }}" role="tabpanel" tabindex="0" aria-labelledby="cc-button-{{ block.id }}" {{ block.shopify_attributes }}>
        {% if block.settings.banner %}<header class="cc-banner"><h1>{{ block.settings.title | default: block.settings.label | escape }}</h1></header>{% else %}<h1 class="cc-title">{{ block.settings.title | default: block.settings.label | escape }}</h1>{% endif %}
        <div class="cc-body rte">{{ block.settings.body }}</div>
        {% if block.settings.order_form %}<form class="cc-form" action="{{ block.settings.form_action | default: routes.root_url }}" method="get"><label>Order number<input name="order" required></label><label>Order email<input type="email" name="email" autocomplete="email" required></label><button type="submit">{{ block.settings.submit_label | escape }}</button></form>{% endif %}
      </article>{% endfor %}
      {% if section.blocks.size == 0 %}<p>Add tab blocks in the theme editor.</p>{% endif %}
    </div>
  </div>
</section>
<style>
#CustomerCare-{{ section.id }}{color:#090909}.cc-layout{display:grid;grid-template-columns:minmax(240px,.82fr) minmax(0,1.6fr);gap:clamp(24px,3.6vw,48px);max-width:{{ section.settings.max_width }}px;margin:auto;padding:{{ section.settings.top }}px 24px {{ section.settings.bottom }}px}.cc-group+.cc-group{margin-top:30px}.cc-group h2{margin:0;padding:12px 20px;background:#4b4b4b;color:white;font-size:15px;text-transform:uppercase}.cc-group nav{border:1px solid #dedede;border-top:0}.cc-link{width:100%;min-height:51px;padding:12px 18px 12px 20px;display:flex;justify-content:space-between;align-items:center;gap:14px;border:0;border-bottom:1px solid #dedede;background:white;color:#080808;text-align:left;font:inherit;font-size:14px;font-weight:600;text-transform:uppercase;cursor:pointer}.cc-link:last-child{border-bottom:0}.cc-link:hover,.cc-link[aria-selected=true]{background:#000;color:#fff}.cc-link span+span{font-size:25px;font-weight:300}.cc-contact{margin-top:54px}.cc-contact h2{margin:0 0 24px;padding-left:20px;font-size:15px;text-transform:uppercase}.cc-contact a{display:flex;flex-direction:column;gap:4px;padding:15px 20px;border-top:1px solid #dedede;color:inherit;text-decoration:none}.cc-panel{display:none}.cc-panel.active{display:block}.cc-banner{display:flex;align-items:center;justify-content:center;min-height:140px;margin-bottom:26px;padding:24px;background:#f6f7f8;text-align:center}.cc-banner h1{margin:0;font-size:clamp(22px,2vw,28px);font-weight:500;text-transform:uppercase}.cc-title{font-size:18px;text-transform:uppercase}.cc-body{font-size:14px;line-height:1.55}.cc-form{margin-top:26px;display:grid;grid-template-columns:1fr 1fr;gap:18px 14px}.cc-form label{display:grid;gap:8px;font-size:12px;text-transform:uppercase}.cc-form input{height:50px;border:1px solid #d5d5d5;padding:10px;font:inherit}.cc-form button{grid-column:1;min-height:52px;margin-top:10px;border:0;background:#000;color:white;font:inherit;font-weight:600;text-transform:uppercase;cursor:pointer}@media(max-width:749px){.cc-layout{grid-template-columns:1fr;gap:28px;padding-left:16px;padding-right:16px}.cc-contact{margin-top:30px}.cc-banner{min-height:100px}.cc-form{grid-template-columns:1fr}.cc-form button{grid-column:1}}
</style>
<script>
(()=>{const root=document.getElementById('CustomerCare-{{ section.id }}');if(!root||root.dataset.ready)return;root.dataset.ready='1';const bs=[...root.querySelectorAll('[data-cc-button]')],ps=[...root.querySelectorAll('[data-cc-panel]')];bs.forEach(b=>{b.id='cc-button-'+b.dataset.ccButton;b.addEventListener('click',()=>show(b.dataset.ccButton,true))});function show(id,hash){const b=bs.find(x=>x.dataset.ccButton===id)||bs[0];if(!b)return;bs.forEach(x=>{let on=x===b;x.setAttribute('aria-selected',on);x.tabIndex=on?0:-1});ps.forEach(x=>{let on=x.dataset.ccPanel===b.dataset.ccButton;x.classList.toggle('active',on);x.hidden=!on});if(hash)history.replaceState(null,'',location.pathname+location.search+'#'+encodeURIComponent(b.dataset.ccButton))}bs.forEach((b,i)=>b.addEventListener('keydown',e=>{if(!['ArrowDown','ArrowUp','ArrowLeft','ArrowRight','Home','End'].includes(e.key))return;e.preventDefault();let n=e.key==='Home'?0:e.key==='End'?bs.length-1:(i+(e.key==='ArrowDown'||e.key==='ArrowRight'?1:-1)+bs.length)%bs.length;bs[n].focus();bs[n].click()}));show(decodeURIComponent(location.hash.slice(1)),false)})();
</script>
{% schema %}
{"name":"Customer care tabs","tag":"section","class":"section-customer-care-tabs","settings":[{"type":"text","id":"profile_heading","label":"Profile heading","default":"Your profile"},{"type":"text","id":"care_heading","label":"Customer care heading","default":"Customer care"},{"type":"checkbox","id":"show_contact","label":"Show contact details","default":true},{"type":"text","id":"contact_heading","label":"Contact heading","default":"Can we help you?"},{"type":"text","id":"phone","label":"Phone","default":"+44 330 8087718"},{"type":"text","id":"email","label":"Email","default":"hello@example.com"},{"type":"text","id":"email_label","label":"Email link text","default":"Send us an e-mail"},{"type":"range","id":"max_width","label":"Maximum width","min":900,"max":1800,"step":50,"unit":"px","default":1500},{"type":"range","id":"top","label":"Top spacing","min":0,"max":100,"step":4,"unit":"px","default":40},{"type":"range","id":"bottom","label":"Bottom spacing","min":0,"max":100,"step":4,"unit":"px","default":40}],"blocks":[{"type":"tab","name":"Tab","settings":[{"type":"select","id":"group","label":"Menu group","options":[{"value":"profile","label":"Your profile"},{"value":"care","label":"Customer care"}],"default":"care"},{"type":"text","id":"label","label":"Menu label","default":"Orders and shipments"},{"type":"text","id":"title","label":"Panel title","default":"Orders and shipments"},{"type":"checkbox","id":"banner","label":"Show title banner","default":true},{"type":"richtext","id":"body","label":"Panel content","default":"<p>Write this tab's page content here.</p>"},{"type":"checkbox","id":"order_form","label":"Show order lookup form","default":false},{"type":"text","id":"form_action","label":"Form destination URL","info":"Optional order tracking or returns service URL."},{"type":"text","id":"submit_label","label":"Submit button","default":"Submit"}]}],"presets":[{"name":"Customer care tabs","blocks":[{"type":"tab","settings":{"group":"profile","label":"Log in","title":"Log in","banner":false}},{"type":"tab","settings":{"group":"profile","label":"Create account","title":"Create account","banner":false}},{"type":"tab","settings":{"group":"profile","label":"Monitor your order","title":"Monitor your order","order_form":true}},{"type":"tab","settings":{"group":"profile","label":"Online exchanges and returns","title":"Online exchanges and returns","order_form":true}},{"type":"tab","settings":{"group":"profile","label":"Wishlist","title":"Wishlist","banner":false}},{"type":"tab","settings":{"group":"care","label":"Orders and shipments","title":"Orders and shipments"}},{"type":"tab","settings":{"group":"care","label":"Payments","title":"Payments"}},{"type":"tab","settings":{"group":"care","label":"Refunds and returns","title":"Refunds and returns"}},{"type":"tab","settings":{"group":"care","label":"Size guide","title":"Size guide"}},{"type":"tab","settings":{"group":"care","label":"FAQ","title":"Frequently asked questions"}}]}]}
{% endschema %}
