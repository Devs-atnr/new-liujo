{% liquid
  assign active_tab = nil
  assign first_tab = nil
  for block in section.blocks
    if block.type == 'tab'
      if first_tab == nil
        assign first_tab = block
      endif
      assign tab_url = block.settings.page.url | default: block.settings.custom_url
      if block.settings.page != blank and page.handle == block.settings.page.handle
        assign active_tab = block
      elsif tab_url != blank and request.path == tab_url
        assign active_tab = block
      endif
    endif
  endfor
  if active_tab == nil
    assign active_tab = first_tab
  endif
%}
<section id="CustomerCareHub-{{ section.id }}" class="cch">
  <div class="cch__layout">
    <aside class="cch__sidebar" aria-label="Customer care navigation">
      {% assign profile_count = 0 %}{% for block in section.blocks %}{% if block.type == 'tab' and block.settings.group == 'profile' %}{% assign profile_count = profile_count | plus: 1 %}{% endif %}{% endfor %}
      {% if profile_count > 0 %}<div class="cch__group"><h2>{{ section.settings.profile_heading | escape }}</h2><nav>{% for block in section.blocks %}{% if block.type == 'tab' and block.settings.group == 'profile' %}{% assign tab_url = block.settings.page.url | default: block.settings.custom_url %}{% assign tab_is_active = false %}{% if active_tab.id == block.id %}{% assign tab_is_active = true %}{% endif %}<a class="cch__link{% if tab_is_active %} is-active{% endif %}" href="{{ tab_url | default: '#' }}"><span>{{ block.settings.label | escape }}</span><span aria-hidden="true">→</span></a>{% endif %}{% endfor %}</nav></div>{% endif %}
      {% assign care_count = 0 %}{% for block in section.blocks %}{% if block.type == 'tab' and block.settings.group == 'care' %}{% assign care_count = care_count | plus: 1 %}{% endif %}{% endfor %}
      {% if care_count > 0 %}<div class="cch__group"><h2>{{ section.settings.care_heading | escape }}</h2><nav>{% for block in section.blocks %}{% if block.type == 'tab' and block.settings.group == 'care' %}{% assign tab_url = block.settings.page.url | default: block.settings.custom_url %}{% assign tab_is_active = false %}{% if active_tab.id == block.id %}{% assign tab_is_active = true %}{% endif %}<a class="cch__link{% if tab_is_active %} is-active{% endif %}" href="{{ tab_url | default: '#' }}"><span>{{ block.settings.label | escape }}</span><span aria-hidden="true">→</span></a>{% endif %}{% endfor %}</nav></div>{% endif %}
      {% if section.settings.show_contact %}<div class="cch__contact"><h2>{{ section.settings.contact_heading | escape }}</h2>{% if section.settings.phone != blank %}<a href="tel:{{ section.settings.phone | remove: ' ' | escape }}">☎ <span>{{ section.settings.phone | escape }}</span></a>{% endif %}{% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email | escape }}">✉ <span>{{ section.settings.email_link_label | escape }}</span></a>{% endif %}</div>{% endif %}
      {% if section.settings.legal_menu != blank %}<div class="cch__contact"><h2>{{ section.settings.legal_heading | escape }}</h2>{% for link in section.settings.legal_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div>{% endif %}
    </aside>
    <main class="cch__main">
      {% if active_tab %}
        <header class="cch__banner"><h1>{{ active_tab.settings.banner_heading | default: active_tab.settings.label | escape }}</h1></header>
        {% if active_tab.settings.content_type == 'order' %}
          <h2>{{ active_tab.settings.content_heading | default: active_tab.settings.label | escape }}</h2><div class="cch__body rte">{{ active_tab.settings.description }}</div>
          <form class="cch__form" action="{{ active_tab.settings.tracking_url | default: routes.root_url }}" method="get"><label>{{ active_tab.settings.order_label | escape }}<input name="{{ active_tab.settings.order_param | escape }}" placeholder="{{ active_tab.settings.order_placeholder | escape }}" required autocomplete="off"></label><label>{{ active_tab.settings.email_label | escape }}<input type="email" name="{{ active_tab.settings.email_param | escape }}" placeholder="{{ active_tab.settings.email_placeholder | escape }}" required autocomplete="email"></label><button type="submit">{{ active_tab.settings.submit_label | escape }}</button></form>
        {% elsif active_tab.settings.content_type == 'returns' %}
          <h2>{{ active_tab.settings.content_heading | default: active_tab.settings.label | escape }}</h2><div class="cch__body rte">{{ active_tab.settings.description }}</div><div class="cch__accordions">{% for block in section.blocks %}{% if block.type == 'returns_accordion' and block.settings.parent_tab == active_tab.settings.label %}<details class="cch__accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}<span aria-hidden="true">＋</span></summary><div class="cch__accordion-body">{{ block.settings.content }}</div></details>{% endif %}{% endfor %}</div>{% if active_tab.settings.returns_url != blank %}<a class="cch__button-link" href="{{ active_tab.settings.returns_url }}">{{ active_tab.settings.returns_button | escape }}</a>{% endif %}
        {% elsif active_tab.settings.content_type == 'size-guide' %}
          <h2>{{ active_tab.settings.content_heading | default: active_tab.settings.label | escape }}</h2><div class="cch__size" id="CCHSize-{{ section.id }}"><label class="visually-hidden" for="CCHSizeSelect-{{ section.id }}">{{ active_tab.settings.size_dropdown_label | escape }}</label><select id="CCHSizeSelect-{{ section.id }}" class="cch__select" data-size-select><option value="">{{ active_tab.settings.size_dropdown_label | escape }}</option>{% for block in section.blocks %}{% if block.type == 'size_category' and block.settings.parent_tab == active_tab.settings.label %}<option value="{{ block.id }}">{{ block.settings.category | escape }}</option>{% endif %}{% endfor %}</select>{% for block in section.blocks %}{% if block.type == 'size_category' and block.settings.parent_tab == active_tab.settings.label %}<div class="cch__size-panel" data-size-panel="{{ block.id }}" hidden {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: block.settings.category }}{% endif %}<div class="cch__html">{{ block.settings.content }}</div></div>{% endif %}{% endfor %}</div><div class="cch__body rte">{{ active_tab.settings.description }}</div>
        {% elsif active_tab.settings.content_type == 'wishlist' %}
          <h2>{{ active_tab.settings.content_heading | default: active_tab.settings.label | escape }}</h2><div class="cch__body rte">{{ active_tab.settings.description }}</div><div class="cch__products">{% assign product_count = 0 %}{% for block in section.blocks %}{% if block.type == 'wishlist_product' and block.settings.parent_tab == active_tab.settings.label and block.settings.product != blank %}{% assign product_count = product_count | plus: 1 %}<a class="cch__product" href="{{ block.settings.product.url }}" {{ block.shopify_attributes }}>{% if block.settings.product.featured_image %}{{ block.settings.product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.product.title }}{% endif %}<strong>{{ block.settings.product.title | escape }}</strong><span>{{ block.settings.product.price | money }}</span></a>{% endif %}{% endfor %}{% if product_count == 0 %}<p>{{ active_tab.settings.empty_message | escape }}</p>{% endif %}</div>
        {% else %}<h2>{{ active_tab.settings.content_heading | default: active_tab.settings.label | escape }}</h2><div class="cch__body rte">{{ active_tab.settings.description }}</div>{% endif %}
      {% else %}<p>Add a Tab block and choose its page in the theme editor.</p>{% endif %}
    </main>
  </div>
</section>
<style>
#CustomerCareHub-{{ section.id }}{color:#090909}.cch__layout{display:grid;grid-template-columns:minmax(240px,.82fr) minmax(0,1.6fr);gap:clamp(24px,3.6vw,48px);max-width:{{ section.settings.max_width }}px;margin:auto;padding:40px 24px}.cch__group{margin-bottom:30px}.cch__group h2,.cch__contact h2{margin:0;padding:12px 20px;background:#4b4b4b;color:#fff;font-size:15px;text-transform:uppercase}.cch__group nav{border:1px solid #dedede;border-top:0}.cch__link{min-height:51px;padding:12px 18px 12px 20px;display:flex;justify-content:space-between;align-items:center;gap:14px;border-bottom:1px solid #dedede;background:#fff;color:#080808;text-decoration:none;font-size:14px;font-weight:600;text-transform:uppercase}.cch__link:last-child{border-bottom:0}.cch__link:hover,.cch__link.is-active{background:#000;color:#fff}.cch__link span+span{font-size:25px;font-weight:300}.cch__contact{margin:30px 0}.cch__contact h2{margin-bottom:0}.cch__contact a{display:block;padding:15px 20px;border-top:1px solid #dedede;color:inherit;text-decoration:none}.cch__banner{display:flex;align-items:center;justify-content:center;min-height:140px;margin-bottom:26px;padding:24px;background:#f6f7f8;text-align:center}.cch__banner h1{margin:0;font-size:clamp(22px,2vw,28px);font-weight:500;text-transform:uppercase}.cch__main>h2{font-size:16px;text-transform:uppercase}.cch__body{font-size:14px;line-height:1.55}.cch__form{margin-top:26px;display:grid;grid-template-columns:1fr 1fr;gap:18px 14px}.cch__form label{display:grid;gap:8px;font-size:12px;text-transform:uppercase}.cch__form input{height:50px;border:1px solid #d5d5d5;padding:10px;font:inherit}.cch__form button,.cch__button-link{grid-column:1;min-height:52px;margin-top:10px;border:0;background:#000;color:#fff;font:inherit;font-weight:600;text-transform:uppercase;cursor:pointer;text-align:center;text-decoration:none;padding:16px}.cch__accordion{border-top:1px solid #dedede}.cch__accordion:last-child{border-bottom:1px solid #dedede}.cch__accordion summary{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:18px 0;cursor:pointer;list-style:none;font-weight:600;text-transform:uppercase}.cch__accordion summary::-webkit-details-marker{display:none}.cch__accordion-body{padding:0 0 20px}.cch__accordion-body img{max-width:100%;height:auto}.cch__select{width:100%;min-height:48px;margin:0 0 20px;padding:10px;border:1px solid #d5d5d5;background:#fff;font:inherit;text-transform:uppercase}.cch__size-panel img{max-width:100%;height:auto;display:block;margin:18px 0}.cch__html{font-size:14px;line-height:1.55}.cch__html table{width:100%;border-collapse:collapse}.cch__html th,.cch__html td{border:1px solid #dedede;padding:10px;text-align:center}.cch__products{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:20px}.cch__product{color:inherit;text-decoration:none}.cch__product img{width:100%;height:auto;display:block;margin-bottom:10px}.cch__product strong,.cch__product span{display:block;margin-top:5px}@media(max-width:749px){.cch__layout{grid-template-columns:1fr;gap:28px;padding:24px 16px}.cch__banner{min-height:100px}.cch__form{grid-template-columns:1fr}.cch__form button{grid-column:1}}
</style>
<script>
(()=>{const root=document.getElementById('CCHSize-{{ section.id }}');if(!root)return;const select=root.querySelector('[data-size-select]');const panels=[...root.querySelectorAll('[data-size-panel]')];if(!select||!panels.length)return;const update=()=>panels.forEach(panel=>panel.hidden=panel.dataset.sizePanel!==select.value);select.addEventListener('change',update);update()})();
</script>
