<section id="CustomerCare-{{ section.id }}" class="cc-shell">
  <div class="cc-layout">
    <aside class="cc-sidebar" aria-label="Customer care navigation">
      <div class="cc-group"><h2>{{ section.settings.profile_heading | escape }}</h2><nav>
        <a class="cc-link" href="{{ routes.account_login_url }}"><span>LOG IN</span><span aria-hidden="true">→</span></a>
        <a class="cc-link" href="{{ routes.account_register_url }}"><span>CREATE ACCOUNT</span><span aria-hidden="true">→</span></a>
        {% if section.settings.order_page != blank %}<a class="cc-link {% if page.handle == section.settings.order_page.handle %}is-active{% endif %}" href="{{ section.settings.order_page.url }}"><span>{{ section.settings.order_label | escape }}</span><span aria-hidden="true">→</span></a>{% endif %}
        {% if section.settings.returns_page != blank %}<a class="cc-link {% if page.handle == section.settings.returns_page.handle %}is-active{% endif %}" href="{{ section.settings.returns_page.url }}"><span>{{ section.settings.returns_label | escape }}</span><span aria-hidden="true">→</span></a>{% endif %}
        {% if section.settings.wishlist_page != blank %}<a class="cc-link {% if page.handle == section.settings.wishlist_page.handle %}is-active{% endif %}" href="{{ section.settings.wishlist_page.url }}"><span>{{ section.settings.wishlist_label | escape }}</span><span aria-hidden="true">→</span></a>{% endif %}
      </nav></div>
      {% if section.settings.care_menu != blank %}<div class="cc-group"><h2>{{ section.settings.care_heading | escape }}</h2><nav>{% for link in section.settings.care_menu.links %}<a class="cc-link {% if link.active %}is-active{% endif %}" href="{{ link.url }}"><span>{{ link.title | escape }}</span><span aria-hidden="true">→</span></a>{% endfor %}</nav></div>{% endif %}
      {% if section.settings.show_contact %}<div class="cc-contact"><h2>{{ section.settings.contact_heading | escape }}</h2>{% if section.settings.phone != blank %}<a href="tel:{{ section.settings.phone | remove: ' ' | escape }}">☎ <span>{{ section.settings.phone | escape }}</span></a>{% endif %}{% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email | escape }}">✉ <span>{{ section.settings.email_link_label | escape }}</span></a>{% endif %}</div>{% endif %}
      {% if section.settings.legal_menu != blank %}<div class="cc-contact"><h2>{{ section.settings.legal_heading | escape }}</h2>{% for link in section.settings.legal_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div>{% endif %}
    </aside>
    <main class="cc-main">
      <header class="cc-banner"><h1>{{ section.settings.page_heading | escape }}</h1></header>
      {% case section.settings.content_type %}
        {% when 'order' %}
          <h2>{{ section.settings.content_heading | escape }}</h2><div class="cc-rte rte">{{ section.settings.description }}</div>
          <form class="cc-form" action="{{ section.settings.service_url | default: routes.root_url }}" method="get">
            <label>{{ section.settings.order_field_label | escape }}<input name="{{ section.settings.order_param | escape }}" required autocomplete="off"></label>
            <label>{{ section.settings.email_field_label | escape }}<input type="email" name="{{ section.settings.email_param | escape }}" required autocomplete="email"></label>
            <button type="submit">{{ section.settings.submit_label | escape }}</button>
          </form>
        {% when 'returns' %}
          <h2>{{ section.settings.content_heading | escape }}</h2><div class="cc-rte rte">{{ section.settings.description }}</div>
          {% if section.settings.service_url != blank %}<form class="cc-form" action="{{ section.settings.service_url }}" method="get">
            <label>{{ section.settings.order_field_label | escape }}<input name="{{ section.settings.order_param | escape }}" required></label>
            <label>{{ section.settings.email_field_label | escape }}<input type="email" name="{{ section.settings.email_param | escape }}" required autocomplete="email"></label>
            <button type="submit">{{ section.settings.submit_label | escape }}</button>
          </form>{% else %}<p class="cc-note">{{ section.settings.portal_note | escape }}</p>{% endif %}
        {% when 'wishlist' %}
          <div class="cc-wishlist" data-key="{{ section.settings.wishlist_key | escape }}" data-empty="{{ section.settings.empty_message | escape }}" aria-live="polite"></div>
      {% endcase %}
    </main>
  </div>
</section>
<style>
#CustomerCare-{{ section.id }}{color:#090909}.cc-layout{display:grid;grid-template-columns:minmax(240px,.82fr) minmax(0,1.6fr);gap:clamp(24px,3.6vw,48px);max-width:{{ section.settings.max_width }}px;margin:auto;padding:40px 24px}.cc-group{margin-bottom:30px}.cc-group h2,.cc-contact h2{margin:0;padding:12px 20px;background:#4b4b4b;color:#fff;font-size:15px;text-transform:uppercase}.cc-group nav{border:1px solid #dedede;border-top:0}.cc-link{width:100%;min-height:51px;padding:12px 18px 12px 20px;display:flex;justify-content:space-between;align-items:center;gap:14px;border-bottom:1px solid #dedede;background:#fff;color:#080808;text-decoration:none;font-size:14px;font-weight:600;text-transform:uppercase}.cc-link:last-child{border-bottom:0}.cc-link:hover,.cc-link.is-active{background:#000;color:#fff}.cc-link span+span{font-size:25px;font-weight:300}.cc-contact{margin:30px 0}.cc-contact h2{margin-bottom:0}.cc-contact a{display:block;padding:15px 20px;border-top:1px solid #dedede;color:inherit;text-decoration:none}.cc-banner{display:flex;align-items:center;justify-content:center;min-height:140px;margin-bottom:26px;padding:24px;background:#f6f7f8;text-align:center}.cc-banner h1{margin:0;font-size:clamp(22px,2vw,28px);font-weight:500;text-transform:uppercase}.cc-main>h2{font-size:16px;text-transform:uppercase}.cc-rte{font-size:14px;line-height:1.55}.cc-form{margin-top:26px;display:grid;grid-template-columns:1fr 1fr;gap:18px 14px}.cc-form label{display:grid;gap:8px;font-size:12px;text-transform:uppercase}.cc-form input{height:50px;border:1px solid #d5d5d5;padding:10px;font:inherit}.cc-form button{grid-column:1;min-height:52px;margin-top:10px;border:0;background:#000;color:#fff;font:inherit;font-weight:600;text-transform:uppercase;cursor:pointer}.cc-note{padding:16px;background:#f6f7f8}.cc-wishlist{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:20px}.cc-product{color:inherit;text-decoration:none}.cc-product img{display:block;width:100%;height:auto;margin-bottom:10px}.cc-product strong,.cc-product span{display:block;margin-top:5px}@media(max-width:749px){.cc-layout{grid-template-columns:1fr;gap:28px;padding:24px 16px}.cc-banner{min-height:100px}.cc-form{grid-template-columns:1fr}.cc-form button{grid-column:1}}
</style>
{% if section.settings.content_type == 'wishlist' %}<script>
(()=>{const root=document.querySelector('#CustomerCare-{{ section.id }} [data-key]');if(!root)return;let products=[];try{products=JSON.parse(localStorage.getItem(root.dataset.key)||'[]')}catch(e){}if(!Array.isArray(products)||!products.length){const p=document.createElement('p');p.textContent=root.dataset.empty;root.append(p);return}products.forEach(product=>{const a=document.createElement('a');a.className='cc-product';a.href=product.url||'#';if(product.image){const img=document.createElement('img');img.src=product.image;img.alt=product.title||'';a.append(img)}const title=document.createElement('strong');title.textContent=product.title||'Product';a.append(title);if(product.price){const price=document.createElement('span');price.textContent=product.price;a.append(price)}root.append(a)})})();
</script>{% endif %}
{% schema %}
{"name":"Customer care tabs","settings":[{"type":"select","id":"content_type","label":"Right side content","options":[{"value":"order","label":"Order tracking"},{"value":"returns","label":"Returns and exchanges"},{"value":"wishlist","label":"Wishlist"}],"default":"order"},{"type":"page","id":"order_page","label":"Order tracking page"},{"type":"page","id":"returns_page","label":"Returns page"},{"type":"page","id":"wishlist_page","label":"Wishlist page"},{"type":"text","id":"profile_heading","label":"Profile heading","default":"Your profile"},{"type":"text","id":"order_label","label":"Order menu label","default":"Monitor your order"},{"type":"text","id":"returns_label","label":"Returns menu label","default":"Online exchanges and returns"},{"type":"text","id":"wishlist_label","label":"Wishlist menu label","default":"Wishlist"},{"type":"link_list","id":"care_menu","label":"Customer care menu"},{"type":"text","id":"care_heading","label":"Customer care heading","default":"Customer care"},{"type":"checkbox","id":"show_contact","label":"Show contact details","default":true},{"type":"text","id":"contact_heading","label":"Contact heading","default":"Can we help you?"},{"type":"text","id":"phone","label":"Phone","default":"+44 330 8087718"},{"type":"text","id":"email","label":"Email","default":"hello@example.com"},{"type":"text","id":"email_link_label","label":"Email link text","default":"Send us an e-mail"},{"type":"link_list","id":"legal_menu","label":"Privacy and legal menu"},{"type":"text","id":"legal_heading","label":"Legal heading","default":"Privacy information"},{"type":"text","id":"page_heading","label":"Right banner heading","default":"Monitor your order"},{"type":"text","id":"content_heading","label":"Right content heading","default":"Monitor your order"},{"type":"richtext","id":"description","label":"Description","default":"<p>Enter your order number and email address used at checkout.</p>"},{"type":"url","id":"service_url","label":"Tracking or returns service URL"},{"type":"text","id":"portal_note","label":"Returns portal note","default":"Add your returns portal URL in this section's settings to enable the return form."},{"type":"text","id":"order_field_label","label":"Order field label","default":"Order number"},{"type":"text","id":"order_param","label":"Order query parameter","default":"order"},{"type":"text","id":"email_field_label","label":"Email field label","default":"Order email"},{"type":"text","id":"email_param","label":"Email query parameter","default":"email"},{"type":"text","id":"submit_label","label":"Submit button","default":"Submit"},{"type":"text","id":"wishlist_key","label":"Wishlist local storage key","default":"wishlist"},{"type":"text","id":"empty_message","label":"Empty wishlist message","default":"There are no products"},{"type":"range","id":"max_width","label":"Maximum width","min":900,"max":1800,"step":50,"unit":"px","default":1500}],"presets":[{"name":"Customer care tabs"}]}
{% endschema %}
