{% comment %}
  LIU JO SOCIAL / INSTAGRAM GALLERY SECTION
  Displays a curated 6-item lookbook grid linking to social media / Instagram.
{% endcomment %}

<div class="liujo-social-gallery" data-section-id="{{ section.id }}" data-section-type="liujo-social-gallery">
  <div class="liujo-section-header">
    <h2 class="liujo-title-display">{{ section.settings.title | default: '@LIUJO ON INSTAGRAM' }}</h2>
    {%- if section.settings.subtitle != blank -%}
      <div class="liujo-subtitle" style="margin-top: 8px;">{{ section.settings.subtitle }}</div>
    {%- endif -%}
  </div>

  <div class="liujo-social-grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: 'https://www.instagram.com/liujo/' }}" target="_blank" class="liujo-social-tile" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Liu Jo Instagram Look" loading="lazy">
        {%- elsif block.settings.demo_image_url != blank -%}
          <img src="{{ block.settings.demo_image_url }}" alt="Liu Jo Instagram Look" loading="lazy">
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}

        <div class="liujo-social-tile__hover">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Liu Jo Social Gallery",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "@LIUJO ON INSTAGRAM"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Tag @liujo and #LiuJoPeople to be featured in our lookbook"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Social Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "demo_image_url",
          "label": "External Image URL"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
