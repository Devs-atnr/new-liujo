{% comment %}
  LIU JO STORE LOCATOR SECTION
  Interactive boutique locator with city filters, flagship boutique directory, and Google Maps directions.
{% endcomment %}

<div class="liujo-stores-page" data-section-id="{{ section.id }}">
  <!-- Hero Section -->
  <div class="liujo-stores-hero">
    <div class="liujo-stores-hero__inner">
      <span class="liujo-stores-hero__tag">LIU JO FOR YOU</span>
      <h1 class="liujo-stores-hero__title">Store Locator</h1>
      <p class="liujo-stores-hero__sub">Discover 283 official Liu Jo boutiques and premier flagship stores around the world.</p>
    </div>
  </div>

  <div class="liujo-stores-container">
    <!-- Search & Country Filters -->
    <div class="liujo-stores-filter-bar">
      <div class="stores-search-wrap">
        <input type="text" id="store-search-input" placeholder="Search by city, country or address..." class="stores-search-input">
      </div>
      <div class="stores-country-pills">
        <button type="button" class="country-pill is-active" data-country="all">ALL (7)</button>
        <button type="button" class="country-pill" data-country="italy">ITALY (2)</button>
        <button type="button" class="country-pill" data-country="france">FRANCE (1)</button>
        <button type="button" class="country-pill" data-country="uk">UNITED KINGDOM (1)</button>
        <button type="button" class="country-pill" data-country="spain">SPAIN (1)</button>
        <button type="button" class="country-pill" data-country="germany">GERMANY (1)</button>
        <button type="button" class="country-pill" data-country="uae">UAE (1)</button>
      </div>
    </div>

    <!-- Boutique Cards Grid -->
    <div class="liujo-stores-grid" id="liujo-stores-list">
      <!-- Boutique 1: Milan -->
      <div class="liujo-boutique-card" data-country="italy" data-keywords="milan milano italy corso vittorio emanuele">
        <div class="card-badge">FLAGSHIP BOUTIQUE</div>
        <h3 class="boutique-city">MILAN</h3>
        <h4 class="boutique-name">Liu Jo Flagship Milano</h4>
        <p class="boutique-address">Corso Vittorio Emanuele II, 30<br>20122 Milano, Italy</p>
        <p class="boutique-phone">Tel: <a href="tel:+390276003982">+39 02 7600 3982</a></p>
        <p class="boutique-hours">Opening Hours: Mon – Sun: 10:00 – 19:30 CET</p>
        <div class="boutique-actions">
          <a href="https://maps.google.com/?q=Liu+Jo+Corso+Vittorio+Emanuele+II+Milano" target="_blank" rel="noopener noreferrer" class="boutique-btn boutique-btn--map">GET DIRECTIONS ↗</a>
          <a href="/pages/retail-experience" class="boutique-btn boutique-btn--book">BOOK APPOINTMENT</a>
        </div>
      </div>

      <!-- Boutique 2: Rome -->
      <div class="liujo-boutique-card" data-country="italy" data-keywords="rome roma italy via del corso">
        <div class="card-badge">FLAGSHIP BOUTIQUE</div>
        <h3 class="boutique-city">ROME</h3>
        <h4 class="boutique-name">Liu Jo Flagship Roma</h4>
        <p class="boutique-address">Via del Corso, 138<br>00186 Roma, Italy</p>
        <p class="boutique-phone">Tel: <a href="tel:+39066784402">+39 06 678 4402</a></p>
        <p class="boutique-hours">Opening Hours: Mon – Sun: 10:00 – 20:00 CET</p>
        <div class="boutique-actions">
          <a href="https://maps.google.com/?q=Liu+Jo+Via+del+Corso+Roma" target="_blank" rel="noopener noreferrer" class="boutique-btn boutique-btn--map">GET DIRECTIONS ↗</a>
          <a href="/pages/retail-experience" class="boutique-btn boutique-btn--book">BOOK APPOINTMENT</a>
        </div>
      </div>

      <!-- Boutique 3: Paris -->
      <div class="liujo-boutique-card" data-country="france" data-keywords="paris france rue de castiglione rivoli">
        <div class="card-badge">FLAGSHIP BOUTIQUE</div>
        <h3 class="boutique-city">PARIS</h3>
        <h4 class="boutique-name">Liu Jo Flagship Paris</h4>
        <p class="boutique-address">12 Rue de Castiglione<br>75001 Paris, France</p>
        <p class="boutique-phone">Tel: <a href="tel:+33142608810">+33 1 42 60 88 10</a></p>
        <p class="boutique-hours">Opening Hours: Mon – Sat: 10:30 – 19:30 CET</p>
        <div class="boutique-actions">
          <a href="https://maps.google.com/?q=Liu+Jo+Rue+de+Castiglione+Paris" target="_blank" rel="noopener noreferrer" class="boutique-btn boutique-btn--map">GET DIRECTIONS ↗</a>
          <a href="/pages/retail-experience" class="boutique-btn boutique-btn--book">BOOK APPOINTMENT</a>
        </div>
      </div>

      <!-- Boutique 4: London -->
      <div class="liujo-boutique-card" data-country="uk" data-keywords="london uk united kingdom regent street">
        <div class="card-badge">FLAGSHIP BOUTIQUE</div>
        <h3 class="boutique-city">LONDON</h3>
