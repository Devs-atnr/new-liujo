{% comment %}
  LIU JO STORE LOCATOR (stores.liujo.com style)
  Grey search bar (search by name / city / address + "Near me"), store count + radius,
  map on the left, city filter + store cards on the right. Every store is a block.
  The map is a Google Maps embed (no API key) that follows the selected store.
{% endcomment %}

{%- liquid
  assign s_id = section.id
  assign show_here = true
  assign only_on = section.settings.only_on_pages | downcase | remove: ' ' | split: ','
  if only_on.size > 0
    assign show_here = false
    for h in only_on
      if h == page.handle
        assign show_here = true
      endif
    endfor
  endif
  if request.design_mode
    assign show_here = true
  endif

  assign cities = ''
  for block in section.blocks
    assign c = block.settings.city | strip
    if c != blank
      assign key = '|' | append: c | append: '|'
      unless cities contains key
        assign cities = cities | append: key
      endunless
    endif
  endfor
  assign city_list = cities | remove_first: '|' | split: '||'
-%}

{%- if show_here -%}
{%- if section.settings.hide_page_section and page -%}
  <style>#MainContent > .shopify-section:has(> .page-width .main-page-title) { display: none !important; }</style>
{%- endif -%}

<div class="liujo-sl liujo-sl--{{ s_id }}" data-liujo-store-locator data-zoom="{{ section.settings.map_zoom }}">
  <style>
    .liujo-sl--{{ s_id }} { padding-bottom: {{ section.settings.padding_bottom }}px; }
  </style>

  {%- if section.settings.title != blank -%}
    <div class="liujo-sl__head">
      <h1 class="liujo-sl__title">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.subtitle != blank -%}<p class="liujo-sl__subtitle">{{ section.settings.subtitle | escape }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="liujo-sl__searchbar">
    <div class="liujo-sl__inner liujo-sl__searchrow">
      <label class="liujo-sl__search">
        <span class="visually-hidden">{{ section.settings.search_placeholder | escape }}</span>
        <input type="search" placeholder="{{ section.settings.search_placeholder | escape }}" data-sl-search autocomplete="off">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      </label>
      <button type="button" class="liujo-sl__near" data-sl-near>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2.5" fill="currentColor"/><path d="M12 1v4M12 19v4M1 12h4M19 12h4"/></svg>
        <span>{{ section.settings.near_label | escape }}</span>
      </button>
    </div>
  </div>

  <div class="liujo-sl__inner">
    <div class="liujo-sl__bar">
      <p class="liujo-sl__count"><strong data-sl-count>{{ section.blocks.size }}</strong> {{ section.settings.count_label | escape }}</p>
      {%- if section.settings.show_radius -%}
        <div class="liujo-sl__radius" role="group" aria-label="{{ section.settings.radius_label | escape }}">
          <span>{{ section.settings.radius_label | escape }}</span>
          {%- for r in (1..3) -%}
            {%- liquid
              case r
                when 1
                  assign km = section.settings.radius_1
                when 2
                  assign km = section.settings.radius_2
                else
                  assign km = section.settings.radius_3
              endcase
            -%}
            <button type="button" class="liujo-sl__radius-btn" data-sl-radius="{{ km }}" aria-pressed="false">{{ km }} km</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="liujo-sl__grid">
      <div class="liujo-sl__map">
        {%- assign first = section.blocks.first -%}
        {%- if first -%}
          {%- liquid
            if first.settings.latitude != blank and first.settings.longitude != blank
              assign q = first.settings.latitude | append: ',' | append: first.settings.longitude
            else
              assign q = first.settings.name | append: ', ' | append: first.settings.address | append: ', ' | append: first.settings.city
            endif
          -%}
          <iframe data-sl-map
                  title="{{ section.settings.map_title | escape }}"
                  src="https://www.google.com/maps?q={{ q | url_encode }}&z={{ section.settings.map_zoom }}&output=embed"
                  loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        {%- endif -%}
      </div>

      <div class="liujo-sl__side">
        <div class="liujo-sl__filters">
          <label class="liujo-sl__select">
            <span class="visually-hidden">{{ section.settings.city_label | escape }}</span>
            <select data-sl-city>
              <option value="">{{ section.settings.city_label | escape }}</option>
              {%- for c in city_list -%}<option value="{{ c | downcase | escape }}">{{ c | escape }}</option>{%- endfor -%}
            </select>
          </label>
          <button type="button" class="liujo-sl__find" data-sl-find>{{ section.settings.find_label | escape }}</button>
        </div>

        <ul class="liujo-sl__list" role="list" data-sl-list>
          {%- for block in section.blocks -%}
            {%- liquid
              if block.settings.latitude != blank and block.settings.longitude != blank
                assign q = block.settings.latitude | append: ',' | append: block.settings.longitude
              else
                assign q = block.settings.name | append: ', ' | append: block.settings.address | append: ', ' | append: block.settings.city
              endif
              assign dir = block.settings.map_link
              if dir == blank
                assign dir = 'https://www.google.com/maps/dir/?api=1&destination=' | append: q
              endif
              assign search_text = block.settings.name | append: ' ' | append: block.settings.city | append: ' ' | append: block.settings.address | append: ' ' | append: block.settings.postal_code | downcase
            -%}
            <li class="liujo-sl__store{% if forloop.first %} is-active{% endif %}"
                data-sl-store
                data-q="{{ q | url_encode }}"
                data-city="{{ block.settings.city | downcase | escape }}"
                data-text="{{ search_text | escape }}"
                data-lat="{{ block.settings.latitude }}"
                data-lng="{{ block.settings.longitude }}"
                tabindex="0"
                {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="liujo-sl__store-img">{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}</div>
              {%- endif -%}
              <div class="liujo-sl__store-body">
                <p class="liujo-sl__store-name">{{ block.settings.name | escape }}</p>
                {%- if block.settings.type != blank -%}<p class="liujo-sl__store-type">{{ block.settings.type | escape }}</p>{%- endif -%}
                <p class="liujo-sl__store-addr">
                  {{ block.settings.address | escape }}
                  {%- if block.settings.postal_code != blank or block.settings.city != blank -%}<br>{{ block.settings.postal_code | escape }} {{ block.settings.city | escape }}{%- endif -%}
                </p>
                {%- if block.settings.phone != blank -%}
                  <p class="liujo-sl__store-line"><span>{{ section.settings.phone_label | escape }}</span> <a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone | escape }}</a></p>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <p class="liujo-sl__store-line"><span>E-mail</span> <a href="mailto:{{ block.settings.email }}">{{ block.settings.email | escape }}</a></p>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <div class="liujo-sl__store-hours">
                    <p class="liujo-sl__store-hours-title">{{ section.settings.hours_label | escape }}</p>
                    <div class="rte">{{ block.settings.hours }}</div>
                  </div>
                {%- endif -%}
                <p class="liujo-sl__store-distance" data-sl-distance hidden></p>
                <a class="liujo-sl__store-dir" href="{{ dir }}" target="_blank" rel="noopener">{{ section.settings.directions_label | escape }}</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <p class="liujo-sl__empty" data-sl-empty hidden>{{ section.settings.empty_label | escape }}</p>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .liujo-sl__inner { max-width: 1440px; margin: 0 auto; padding: 0 72px; box-sizing: border-box; }
  .liujo-sl__head { text-align: center; padding: 40px 20px 30px; }
  .liujo-sl__title { margin: 0; font-size: 24px; font-weight: 700; text-transform: uppercase; color: #000; }
  .liujo-sl__subtitle { margin: 8px 0 0; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: #4c4c4c; }

  .liujo-sl__searchbar { background: #f1f2f4; padding: 23px 0; }
  .liujo-sl__searchrow { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 24px; }
  .liujo-sl__search { position: relative; display: block; }
  .liujo-sl__search input {
    width: 100%; height: 47px; box-sizing: border-box; padding: 0 44px 0 16px;
    border: none; border-radius: 0; background: #fff; font: inherit; font-size: 14px; color: #000;
  }
  .liujo-sl__search input:focus { outline: 1px solid #000; }
  .liujo-sl__search svg { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #4c4c4c; pointer-events: none; }
  .liujo-sl__near {
    display: flex; align-items: center; gap: 12px; height: 47px; padding: 0 16px;
    border: none; border-radius: 0; background: #fff; color: #000; font: inherit; font-size: 14px; cursor: pointer; text-align: left;
    transition: background-color 0.2s ease;
  }
  .liujo-sl__near:hover { background: #fafafa; }
  .liujo-sl__near.is-loading { opacity: 0.6; pointer-events: none; }

  .liujo-sl__bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 30px 0 20px; }
  .liujo-sl__count { margin: 0; font-size: 16px; color: #000; }
  .liujo-sl__radius { display: flex; align-items: center; gap: 10px; font-size: 14px; }
  .liujo-sl__radius-btn {
    width: 60px; height: 31px; border: 1px solid #000; border-radius: 0; background: #fff; color: #000;
    font: inherit; font-size: 10px; cursor: pointer; transition: background-color 0.2s ease, color 0.2s ease;
  }
  .liujo-sl__radius-btn:hover, .liujo-sl__radius-btn[aria-pressed="true"] { background: #000; color: #fff; }
  .liujo-sl__radius-btn:disabled { opacity: 0.35; cursor: not-allowed; }

  .liujo-sl__grid { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 24px; align-items: start; }
  .liujo-sl__map { position: sticky; top: calc(var(--liujo-header-h-desk, 86px) + 16px); height: 640px; background: #e9e9e9; }
  .liujo-sl__map iframe { width: 100%; height: 100%; border: 0; display: block; }

  .liujo-sl__filters { display: grid; gap: 12px; margin-bottom: 20px; }
  .liujo-sl__select { position: relative; display: block; }
  .liujo-sl__select select {
    width: 100%; height: 45px; padding: 0 40px 0 14px; appearance: none; -webkit-appearance: none;
    border: 1px solid #ccc; border-radius: 0; background: #fff; font: inherit; font-size: 13px; color: #000; cursor: pointer;
  }
  .liujo-sl__select::after {
    content: ''; position: absolute; right: 16px; top: 50%; width: 7px; height: 7px; margin-top: -6px;
    border-right: 1.5px solid #000; border-bottom: 1.5px solid #000; transform: rotate(45deg); pointer-events: none;
  }
  .liujo-sl__find {
    height: 45px; border: none; border-radius: 0; background: #000; color: #fff;
    font: inherit; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .liujo-sl__find:hover { background: #333; }

  .liujo-sl__list { list-style: none; margin: 0; padding: 0; max-height: 640px; overflow-y: auto; scrollbar-width: thin; }
  .liujo-sl__store {
    display: grid; grid-template-columns: auto 1fr; gap: 14px;
    padding: 20px 16px; margin: 0; border-bottom: 1px solid #e9e9e9; border-left: 3px solid transparent;
    cursor: pointer; transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .liujo-sl__store:first-child { border-top: 1px solid #e9e9e9; }
  .liujo-sl__store:hover { background: #fafafa; }
  .liujo-sl__store.is-active { border-left-color: #000; background: #f8f9fa; }
  .liujo-sl__store[hidden] { display: none; }
  .liujo-sl__store:focus-visible { outline: 2px solid #000; outline-offset: -2px; }
  .liujo-sl__store-img { width: 90px; }
  .liujo-sl__store-img img { width: 100%; height: auto; display: block; }
  .liujo-sl__store-body { min-width: 0; grid-column: 2; }
  .liujo-sl__store:not(:has(.liujo-sl__store-img)) .liujo-sl__store-body { grid-column: 1 / -1; }
  .liujo-sl__store-name { margin: 0 0 6px; font-size: 14px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; color: #000; }
  .liujo-sl__store-type { margin: 0 0 8px; font-size: 11px; text-transform: uppercase; color: #4c4c4c; }
  .liujo-sl__store-addr, .liujo-sl__store-line { margin: 0 0 6px; font-size: 13px; line-height: 1.5; color: #000; }
  .liujo-sl__store-line span { color: #4c4c4c; }
  .liujo-sl__store-line a { color: #000; text-decoration: none; }
  .liujo-sl__store-hours { margin-top: 10px; font-size: 12px; line-height: 1.5; }
  .liujo-sl__store-hours-title { margin: 0 0 4px; font-weight: 700; text-transform: uppercase; font-size: 11px; }
  .liujo-sl__store-hours .rte p { margin: 0; }
  .liujo-sl__store-distance { margin: 8px 0 0; font-size: 12px; color: #4c4c4c; }
  .liujo-sl__store-dir {
    display: inline-block; margin-top: 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; color: #000; text-decoration: underline; text-underline-offset: 3px;
  }
  .liujo-sl__empty { padding: 30px 0; font-size: 14px; color: #4c4c4c; }

  @media (max-width: 1100px) {
    .liujo-sl__inner { padding: 0 24px; }
    .liujo-sl__searchrow, .liujo-sl__grid { grid-template-columns: minmax(0, 1fr) 340px; }
  }
  @media (max-width: 767px) {
    .liujo-sl__inner { padding: 0 16px; }
    .liujo-sl__searchbar { padding: 16px 0; }
    .liujo-sl__searchrow, .liujo-sl__grid { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .liujo-sl__bar { flex-direction: column; align-items: flex-start; padding: 20px 0 14px; }
    .liujo-sl__map { position: relative; top: auto; height: 300px; }
    .liujo-sl__list { max-height: none; overflow: visible; }
    .liujo-sl__store { padding: 18px 12px; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function km(a, b, c, d) {
      const R = 6371, t = Math.PI / 180;
      const x = Math.sin(((c - a) * t) / 2) ** 2 + Math.cos(a * t) * Math.cos(c * t) * Math.sin(((d - b) * t) / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(x));
    }
    function init(root) {
      if (root.dataset.slReady) return;
      root.dataset.slReady = '1';
      const zoom = root.dataset.zoom || '15';
      const map = root.querySelector('[data-sl-map]');
      const list = root.querySelector('[data-sl-list]');
      const stores = [...root.querySelectorAll('[data-sl-store]')];
      const search = root.querySelector('[data-sl-search]');
      const city = root.querySelector('[data-sl-city]');
      const count = root.querySelector('[data-sl-count]');
      const empty = root.querySelector('[data-sl-empty]');
      const radiusBtns = [...root.querySelectorAll('[data-sl-radius]')];
      let me = null, radius = 0;
      radiusBtns.forEach((b) => (b.disabled = true));

      function select(li, scroll) {
        stores.forEach((s) => s.classList.toggle('is-active', s === li));
        if (map) map.src = 'https://www.google.com/maps?q=' + li.dataset.q + '&z=' + zoom + '&output=embed';
        if (scroll && window.matchMedia('(max-width: 767px)').matches && map) map.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      function apply() {
        const q = (search?.value || '').trim().toLowerCase();
        const c = city?.value || '';
        let n = 0;
        stores.forEach((s) => {
          let ok = (!q || s.dataset.text.includes(q)) && (!c || s.dataset.city === c);
          const out = s.querySelector('[data-sl-distance]');
          if (me && s.dataset.lat && s.dataset.lng) {
            const d = km(me.lat, me.lng, parseFloat(s.dataset.lat), parseFloat(s.dataset.lng));
            s.dataset.dist = d;
            if (out) { out.hidden = false; out.textContent = d.toFixed(1) + ' km'; }
            if (radius && d > radius) ok = false;
          }
          s.hidden = !ok;
          if (ok) n++;
        });
        if (me) {
          stores.slice().sort((a, b) => (parseFloat(a.dataset.dist) || 1e9) - (parseFloat(b.dataset.dist) || 1e9)).forEach((s) => list.appendChild(s));
        }
        if (count) count.textContent = n;
        if (empty) empty.hidden = n > 0;
        const firstVisible = stores.find((s) => !s.hidden && s.classList.contains('is-active')) || [...list.children].find((s) => !s.hidden);
        if (firstVisible) select(firstVisible, false);
      }

      stores.forEach((s) => {
        s.addEventListener('click', (e) => { if (!e.target.closest('a')) select(s, true); });
        s.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(s, true); } });
      });
      search?.addEventListener('input', apply);
      city?.addEventListener('change', apply);
      root.querySelector('[data-sl-find]')?.addEventListener('click', apply);
      radiusBtns.forEach((b) => b.addEventListener('click', () => {
        const v = parseFloat(b.dataset.slRadius);
        radius = radius === v ? 0 : v;
        radiusBtns.forEach((x) => x.setAttribute('aria-pressed', String(parseFloat(x.dataset.slRadius) === radius)));
        apply();
      }));
      root.querySelector('[data-sl-near]')?.addEventListener('click', (e) => {
        const btn = e.currentTarget;
        if (!navigator.geolocation) return;
        btn.classList.add('is-loading');
        navigator.geolocation.getCurrentPosition((pos) => {
          btn.classList.remove('is-loading');
          me = { lat: pos.coords.latitude, lng: pos.coords.longitude };
          radiusBtns.forEach((x) => (x.disabled = false));
          apply();
          const nearest = [...list.children].find((s) => !s.hidden);
          if (nearest) select(nearest, true);
        }, () => btn.classList.remove('is-loading'), { timeout: 10000 });
      });
    }
    const run = () => document.querySelectorAll('[data-liujo-store-locator]').forEach(init);
    document.addEventListener('DOMContentLoaded', run);
    document.addEventListener('shopify:section:load', run);
    document.addEventListener('shopify:block:select', (e) => {
      const li = document.querySelector('[data-sl-store][data-shopify-editor-block*="' + e.detail.blockId + '"]');
      if (li) li.click();
    });
    run();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Liu Jo Store Locator",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Where to show"
    },
    {
      "type": "text",
      "id": "only_on_pages",
      "label": "Only show on these pages (handles)",
      "info": "Comma-separated page handles, e.g. store-locator. Empty = every page using this template."
    },
    {
      "type": "checkbox",
      "id": "hide_page_section",
      "label": "Hide the default page title/content on these pages",
      "default": true
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Store Locator"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search by store, street or city"
    },
    {
      "type": "text",
      "id": "near_label",
      "label": "Near me button",
      "default": "Near you"
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Count label",
      "default": "stores found"
    },
    {
      "type": "text",
      "id": "city_label",
      "label": "City filter",
      "default": "All cities"
    },
    {
      "type": "text",
      "id": "find_label",
      "label": "Find button",
      "default": "Find stores"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Mobile:"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Opening hours label",
      "default": "Opening hours"
    },
    {
      "type": "text",
      "id": "directions_label",
      "label": "Directions link",
      "default": "Show on Google Map"
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "No results text",
      "default": "No stores match your search."
    },
    {
      "type": "text",
      "id": "map_title",
      "label": "Map title (accessibility)",
      "default": "Store map"
    },
    {
      "type": "header",
      "content": "Radius (works after 'Near you')"
    },
    {
      "type": "checkbox",
      "id": "show_radius",
      "label": "Show radius buttons",
      "default": true
    },
    {
      "type": "text",
      "id": "radius_label",
      "label": "Radius label",
      "default": "Radius"
    },
    {
      "type": "number",
      "id": "radius_1",
      "label": "Radius 1 (km)",
      "default": 30
    },
    {
      "type": "number",
      "id": "radius_2",
      "label": "Radius 2 (km)",
      "default": 50
    },
    {
      "type": "number",
      "id": "radius_3",
      "label": "Radius 3 (km)",
      "default": 100
    },
    {
      "type": "header",
      "content": "Map & spacing"
    },
    {
      "type": "range",
      "id": "map_zoom",
      "min": 5,
      "max": 19,
      "step": 1,
      "label": "Map zoom",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
