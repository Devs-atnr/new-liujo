        <div class="card-badge">FLAGSHIP BOUTIQUE</div>
        <h3 class="boutique-city">MADRID</h3>
        <h4 class="boutique-name">Liu Jo Flagship Madrid</h4>
        <p class="boutique-address">Calle de Serrano, 12<br>28001 Madrid, Spain</p>
        <p class="boutique-phone">Tel: <a href="tel:+34915758892">+34 91 575 8892</a></p>
        <p class="boutique-hours">Opening Hours: Mon – Sat: 10:00 – 21:00 CET</p>
        <div class="boutique-actions">
          <a href="https://maps.google.com/?q=Liu+Jo+Calle+Serrano+Madrid" target="_blank" rel="noopener noreferrer" class="boutique-btn boutique-btn--map">GET DIRECTIONS ↗</a>
          <a href="/pages/retail-experience" class="boutique-btn boutique-btn--book">BOOK APPOINTMENT</a>
        </div>
      </div>

      <!-- Boutique 6: Berlin -->
      <div class="liujo-boutique-card" data-country="germany" data-keywords="berlin germany kurfurstendamm kadewe">
        <div class="card-badge">PREMIUM BOUTIQUE</div>
        <h3 class="boutique-city">BERLIN</h3>
        <h4 class="boutique-name">Liu Jo Boutique Berlin</h4>
        <p class="boutique-address">Kurfürstendamm 21-24, KaDeWe<br>10719 Berlin, Germany</p>
        <p class="boutique-phone">Tel: <a href="tel:+493021212100">+49 30 2121 2100</a></p>
        <p class="boutique-hours">Opening Hours: Mon – Sat: 10:00 – 20:00 CET</p>
        <div class="boutique-actions">
          <a href="https://maps.google.com/?q=Liu+Jo+KaDeWe+Berlin" target="_blank" rel="noopener noreferrer" class="boutique-btn boutique-btn--map">GET DIRECTIONS ↗</a>
