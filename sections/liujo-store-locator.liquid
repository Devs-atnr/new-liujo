        <h3 class="boutique-city">DUBAI</h3>
        <h4 class="boutique-name">Liu Jo The Dubai Mall</h4>
        <p class="boutique-address">Fashion Avenue, Ground Floor<br>The Dubai Mall, Dubai, UAE</p>
        <p class="boutique-phone">Tel: <a href="tel:+97143308550">+971 4 330 8550</a></p>
        <p class="boutique-hours">Opening Hours: Daily: 10:00 – 23:00 GST</p>
        <div class="boutique-actions">
          <a href="https://maps.google.com/?q=Liu+Jo+The+Dubai+Mall" target="_blank" rel="noopener noreferrer" class="boutique-btn boutique-btn--map">GET DIRECTIONS ↗</a>
          <a href="/pages/retail-experience" class="boutique-btn boutique-btn--book">BOOK APPOINTMENT</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .liujo-stores-page {
    background: #fafafa;
    color: #111;
    padding-bottom: 80px;
  }
  .liujo-stores-hero {
    background: #000;
    color: #fff;
    padding: 70px 24px;
    text-align: center;
  }
  .liujo-stores-hero__inner {
    max-width: 800px;
    margin: 0 auto;
  }
  .liujo-stores-hero__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #bbb;
    display: block;
    margin-bottom: 14px;
  }
  .liujo-stores-hero__title {
    font-size: 38px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 14px 0;
    color: #fff;
  }
  .liujo-stores-hero__sub {
    font-size: 15px;
    color: #888;
    line-height: 1.6;
    margin: 0;
  }
  .liujo-stores-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
  }
  .liujo-stores-filter-bar {
    background: #fff;
    border: 1px solid #e0e0e0;
    padding: 24px;
    margin-bottom: 36px;
  }
  .stores-search-wrap {
    margin-bottom: 20px;
  }
  .stores-search-input {
    width: 100%;
    padding: 14px 18px;
    font-size: 14px;
    border: 1px solid #ccc;
    box-sizing: border-box;
    font-family: inherit;
  }
  .stores-country-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .country-pill {
    background: #f0f0f0;
    border: none;
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
  }
  .country-pill.is-active, .country-pill:hover {
    background: #000;
    color: #fff;
  }
  .liujo-stores-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .liujo-boutique-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    padding: 30px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: box-shadow 0.2s;
  }
  .liujo-boutique-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  }
  .card-badge {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 8px;
  }
  .boutique-city {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 6px 0;
  }
  .boutique-name {
    font-size: 14px;
    font-weight: 600;
    color: #444;
    margin: 0 0 14px 0;
  }
  .boutique-address {
    font-size: 13px;
    line-height: 1.6;
    color: #666;
    margin: 0 0 10px 0;
  }
  .boutique-phone {
    font-size: 13px;
    color: #333;
    margin: 0 0 8px 0;
  }
  .boutique-phone a {
    color: #000;
    text-decoration: none;
    font-weight: 600;
  }
  .boutique-hours {
    font-size: 12px;
    color: #777;
    margin: 0 0 24px 0;
    flex-grow: 1;
  }
  .boutique-actions {
    display: flex;
    gap: 10px;
    border-top: 1px solid #eee;
    padding-top: 18px;
  }
  .boutique-btn {
    flex: 1;
    text-align: center;
    padding: 10px 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s;
  }
  .boutique-btn--map {
    background: #000;
    color: #fff;
  }
  .boutique-btn--map:hover {
    background: #333;
  }
  .boutique-btn--book {
    border: 1px solid #000;
    color: #000;
  }
  .boutique-btn--book:hover {
    background: #f4f4f4;
  }
  @media screen and (max-width: 900px) {
    .liujo-stores-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media screen and (max-width: 600px) {
    .liujo-stores-grid {
      grid-template-columns: 1fr;
    }
    .boutique-actions {
      flex-direction: column;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.getElementById('store-search-input');
    var countryBtns = document.querySelectorAll('.country-pill');
    var cards = document.querySelectorAll('.liujo-boutique-card');

    var currentCountry = 'all';

    function filterStores() {
      var query = (searchInput.value || '').toLowerCase().trim();

      cards.forEach(function(card) {
        var cardCountry = card.getAttribute('data-country');
        var cardKeywords = (card.getAttribute('data-keywords') || '') + ' ' + card.innerText.toLowerCase();

        var matchesCountry = (currentCountry === 'all' || cardCountry === currentCountry);
        var matchesQuery = !query || cardKeywords.indexOf(query) !== -1;

        if (matchesCountry && matchesQuery) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterStores);
    }

    countryBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        countryBtns.forEach(function(b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        currentCountry = btn.getAttribute('data-country');
        filterStores();
      });
    });
  });
</script>

{% schema %}
{
  "name": "Liu Jo Store Locator",
  "settings": [],
  "presets": [
    {
      "name": "Liu Jo Store Locator"
    }
  ]
}
{% endschema %}
