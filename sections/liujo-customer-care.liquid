                  <tr><td>41</td><td>8.5</td><td>11</td><td>26.5</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Belts Table -->
          <div class="size-table-container" id="size-table-belts" style="display:none;">
            <h4 class="table-title">Belts &amp; Waist Measurements</h4>
            <div class="liujo-table-wrap">
              <table class="liujo-size-table">
                <thead>
                  <tr>
                    <th>LIU JO BELT SIZE</th>
                    <th>TOTAL LENGTH (CM)</th>
                    <th>WAIST MEASUREMENT (CM)</th>
                    <th>CORRESPONDING IT SIZE</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td>S</td><td>85 cm</td><td>70 – 75 cm</td><td>38 – 40</td></tr>
                  <tr><td>M</td><td>95 cm</td><td>80 – 85 cm</td><td>42 – 44</td></tr>
                  <tr><td>L</td><td>105 cm</td><td>90 – 95 cm</td><td>46 – 48</td></tr>
                  <tr><td>XL</td><td>115 cm</td><td>100 – 105 cm</td><td>50</td></tr>
                </tbody>
              </table>
