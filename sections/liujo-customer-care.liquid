{% comment %}
  LIU JO CUSTOMER CARE SECTION
{% endcomment %}

{% render 'liujo-customer-care',
  active_tab: section.settings.active_tab,
  hero_tagline: section.settings.hero_tagline,
  hero_title: section.settings.hero_title
%}

{% schema %}
{
  "name": "Liu Jo Customer Care",
  "settings": [
    {
      "type": "select",
      "id": "active_tab",
      "label": "Active Topic Tab",
      "options": [
        { "value": "orders", "label": "Orders & Shipping Services" },
        { "value": "payments", "label": "Payments & Security" },
        { "value": "returns", "label": "Return and Exchange Policy" },
        { "value": "make_return", "label": "Make a Return Portal" },
        { "value": "size_guide", "label": "Size & Fit Guide" },
        { "value": "care", "label": "How to Take Care" },
        { "value": "faq", "label": "Frequently Asked Questions" }
      ],
      "default": "orders"
    },
    {
      "type": "text",
      "id": "hero_tagline",
      "label": "Hero Tagline",
      "default": "LIU JO CLIENT SERVICES"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title Override"
    }
  ],
  "presets": [
    {
      "name": "Liu Jo Customer Care"
    }
  ]
}
{% endschema %}
