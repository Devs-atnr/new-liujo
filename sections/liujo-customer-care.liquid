{% comment %}
  LIU JO LUXURY CUSTOMER CARE & KNOWLEDGE BASE SECTION
  Faithfully replicates the official Liu Jo Customer Care portal with responsive sidebar,
  rich accordions, shipping tables, size conversion guides, care instructions & FAQ.
{% endcomment %}

<div class="liujo-cc-page" data-section-id="{{ section.id }}">
  <!-- Customer Care Editorial Hero Banner -->
  <div class="liujo-cc-hero">
    <div class="liujo-cc-hero__inner">
      <span class="liujo-cc-hero__tag">{{ section.settings.hero_tagline | default: 'LIU JO CLIENT SERVICES' }}</span>
      <h1 class="liujo-cc-hero__title" id="liujo-cc-page-title">
        {% case section.settings.active_tab %}
          {% when 'orders' %}Orders &amp; Shipping Services
          {% when 'payments' %}Payments &amp; Security
          {% when 'returns' %}Return and Exchange Policy
          {% when 'make_return' %}Make a Return
          {% when 'size_guide' %}Size &amp; Fit Guide
          {% when 'care' %}How to Take Care
          {% when 'faq' %}Frequently Asked Questions
          {% else %}{{ section.settings.hero_title | default: 'Customer Care' }}
        {% endcase %}
      </h1>
      <p class="liujo-cc-hero__desc">Dedicated assistance and comprehensive guides for your Liu Jo online shopping experience.</p>
    </div>
  </div>

  <div class="liujo-cc-container">
    <!-- Breadcrumbs -->
    <nav class="liujo-cc-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/pages/customer-care">Customer Care</a>
      <span class="sep">/</span>
      <span class="current" id="liujo-cc-crumb-current">
        {% case section.settings.active_tab %}
          {% when 'orders' %}Orders &amp; Shipping
          {% when 'payments' %}Payments
          {% when 'returns' %}Return Policy
          {% when 'make_return' %}Make a Return
          {% when 'size_guide' %}Size Guide
          {% when 'care' %}Garment Care
          {% when 'faq' %}FAQ
          {% else %}General Information
        {% endcase %}
      </span>
    </nav>

    <!-- Main Grid: Left Sidebar & Right Content -->
    <div class="liujo-cc-grid">
      <!-- Left Sticky Sidebar -->
      <aside class="liujo-cc-sidebar">
        <div class="liujo-cc-sidebar__card">
          <h3 class="liujo-cc-sidebar__heading">CUSTOMER CARE</h3>
          <ul class="liujo-cc-nav-list" id="liujo-cc-tabs-nav">
            <li>
              <a href="/pages/orders-and-shipments" class="liujo-cc-nav-link{% if section.settings.active_tab == 'orders' %} is-active{% endif %}" data-target-tab="orders">
                Orders &amp; Shipping Services
              </a>
            </li>
            <li>
              <a href="/pages/payments" class="liujo-cc-nav-link{% if section.settings.active_tab == 'payments' %} is-active{% endif %}" data-target-tab="payments">
                Payments
              </a>
            </li>
            <li>
              <a href="/pages/refunds-and-returns" class="liujo-cc-nav-link{% if section.settings.active_tab == 'returns' %} is-active{% endif %}" data-target-tab="returns">
                Return and Exchange Policy
              </a>
            </li>
            <li>
              <a href="https://www.liujo.com/returns/search" class="liujo-cc-nav-link liujo-cc-nav-link--ext{% if section.settings.active_tab == 'make_return' %} is-active{% endif %}" data-target-tab="make_return" target="_blank" rel="noopener noreferrer">
                Make a Return <span class="ext-arrow">↗</span>
              </a>
            </li>
            <li>
              <a href="/pages/size-guide" class="liujo-cc-nav-link{% if section.settings.active_tab == 'size_guide' %} is-active{% endif %}" data-target-tab="size_guide">
                Size Guide
              </a>
            </li>
            <li>
              <a href="/pages/how-to-take-care" class="liujo-cc-nav-link{% if section.settings.active_tab == 'care' %} is-active{% endif %}" data-target-tab="care">
                How to take care
              </a>
            </li>
            <li>
              <a href="/pages/faq" class="liujo-cc-nav-link{% if section.settings.active_tab == 'faq' %} is-active{% endif %}" data-target-tab="faq">
                FAQ
              </a>
            </li>
          </ul>
        </div>

        <!-- Boutique Concierge Assistance Card -->
        <div class="liujo-cc-concierge">
          <h4 class="liujo-cc-concierge__title">MAY WE HELP YOU?</h4>
          <p class="liujo-cc-concierge__line">
            Boutique Telephone:<br>
            <strong><a href="tel:+443308087718">+44 330 8087718</a></strong>
          </p>
          <p class="liujo-cc-concierge__hours">
            Monday to Friday, 9.00 to 18.00 CET
          </p>
          <a href="/pages/contact" class="liujo-cc-concierge__btn">EMAIL US</a>
        </div>
      </aside>

      <!-- Right Main Content Panels -->
      <main class="liujo-cc-content">
        <!-- TAB 1: ORDERS & SHIPPING SERVICES -->
        <div class="liujo-cc-panel{% if section.settings.active_tab == 'orders' %} is-active{% endif %}" id="panel-orders">
          <div class="liujo-cc-panel__header">
            <h2>Orders &amp; Shipping Services</h2>
            <p>Everything you need to know regarding placing orders, dispatch timelines, and worldwide shipping.</p>
          </div>

          <div class="liujo-accordion">
            <details class="liujo-accordion__item" open>
              <summary class="liujo-accordion__title">
                <span>Delivery Guide &amp; Package Inspection</span>
                <span class="icon-toggle"></span>
              </summary>
              <div class="liujo-accordion__content">
                <p>Upon delivery, it is necessary to:</p>
                <ol>
                  <li>Check that the number of packages delivered matches the number indicated in the order confirmation.</li>
                  <li>Check that the outer packaging and seals are completely intact, undamaged, not wet, and not altered in any way.</li>
                  <li>Sign the courier’s delivery document with a legible signature.</li>
                  <li>If requested by the delivery courier, present an official identity document.</li>
                </ol>
                <p>Any damage to the packaging and/or products or any discrepancy in the number of parcels must be immediately contested in writing to the courier, specifying that acceptance is made “with reservation”. Furthermore, please promptly notify our Customer Service team providing photographic documentation.</p>
              </div>
            </details>

            <details class="liujo-accordion__item">
              <summary class="liujo-accordion__title">
                <span>Shipping Costs and Times</span>
                <span class="icon-toggle"></span>
              </summary>
              <div class="liujo-accordion__content">
                <p>Orders with <strong>Express Shipping</strong> placed Monday to Friday by 2:00 PM (CET) will be entrusted to the courier on the same business day. Orders with <strong>Standard Shipping</strong> placed before 12:00 PM (CET) are dispatched same day.</p>
                <div class="liujo-table-wrap">
                  <table class="liujo-shipping-table">
                    <thead>
                      <tr>
                        <th>SHIPPING METHOD</th>
                        <th>ESTIMATED DELIVERY</th>
                        <th>COST</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td><strong>STANDARD DELIVERY</strong></td>
                        <td>3 – 5 Business Days</td>
                        <td>€ 14,50 (Complimentary over € 150)</td>
                      </tr>
                      <tr>
                        <td><strong>EXPRESS DELIVERY</strong></td>
                        <td>1 – 3 Business Days</td>
                        <td>€ 30,00</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <p class="table-note">* Delivery timelines may vary during festive holiday seasons or promotional events.</p>
              </div>
            </details>

            <details class="liujo-accordion__item">
              <summary class="liujo-accordion__title">
                <span>Shipment Monitoring &amp; Tracking</span>
                <span class="icon-toggle"></span>
              </summary>
              <div class="liujo-accordion__content">
                <p>You will receive an automated shipping confirmation email containing the courier tracking code as soon as your parcel leaves our logistics hub. The courier tracking status activates within 24 hours of parcel handover.</p>
                <p>If you have a registered Liu Jo account, you can also view real-time tracking anytime inside your <a href="/account">Account Dashboard</a>.</p>
              </div>
            </details>

            <details class="liujo-accordion__item">
              <summary class="liujo-accordion__title">
                <span>Orders &amp; Pre-orders</span>
                <span class="icon-toggle"></span>
              </summary>
              <div class="liujo-accordion__content">
                <p>You can view all order details by checking the order confirmation email we have sent you. For pre-order items, your chosen payment method will be charged at checkout, and the entire order will be dispatched once pre-order items reach our logistics facility.</p>
              </div>
            </details>

            <details class="liujo-accordion__item">
              <summary class="liujo-accordion__title">
                <span>Sending a Gift &amp; Luxury Packaging</span>
                <span class="icon-toggle"></span>
              </summary>
              <div class="liujo-accordion__content">
                <p>If you wish to send a gift, you can select the luxury gift package option during checkout. Your items will be beautifully enclosed in our signature Liu Jo presentation box, and you can include a personal greeting printed on an exclusive Liu Jo gift card (+ € 8,00).</p>
              </div>
            </details>
          </div>
        </div>

        <!-- TAB 2: PAYMENTS -->
        <div class="liujo-cc-panel{% if section.settings.active_tab == 'payments' %} is-active{% endif %}" id="panel-payments">
          <div class="liujo-cc-panel__header">
            <h2>Payments &amp; Security</h2>
            <p>Every transaction on Liu Jo is processed through military-grade SSL encryption and certified payment gateways.</p>
          </div>

          <div class="liujo-accordion">
            <details class="liujo-accordion__item" open>
              <summary class="liujo-accordion__title">
                <span>Accepted Payment Methods</span>
                <span class="icon-toggle"></span>
              </summary>
              <div class="liujo-accordion__content">
                <p>We accept the following secure payment methods:</p>
                <ul class="liujo-methods-list">
                  <li><strong>Credit / Debit Cards:</strong> Visa, MasterCard, American Express, Maestro</li>
                  <li><strong>Digital Wallets:</strong> Apple Pay, Google Pay, PayPal</li>
                  <li><strong>Buy Now, Pay Later:</strong> Klarna (Pay in 3 installments), Scalapay</li>
                  <li><strong>Regional Payments:</strong> iDEAL, Bancontact, Sofort</li>
                </ul>
                <p>Your card is only charged once your order has been verified and prepared for dispatch.</p>
              </div>
            </details>

            <details class="liujo-accordion__item">
              <summary class="liujo-accordion__title">
                <span>Payment Safety &amp; 3D Secure</span>
                <span class="icon-toggle"></span>
              </summary>
              <div class="liujo-accordion__content">
                <p>To protect your credit and debit card transactions, you will always be asked to enter your CVV security code. Furthermore, our store implements <strong>3D Secure (Verified by Visa &amp; Mastercard Identity Check)</strong>, requiring two-factor authentication via your bank's mobile app or SMS code.</p>
                <p>Digital Boîte s.r.l. and Liu Jo do not store or have access to your full payment card details at any time.</p>
              </div>
            </details>

            <details class="liujo-accordion__item">
              <summary class="liujo-accordion__title">
                <span>Billing Rules &amp; Invoices</span>
                <span class="icon-toggle"></span>
              </summary>
              <div class="liujo-accordion__content">
                <p>Online product sales on this store are intended for consumer natural persons. A digital order receipt is automatically emailed upon payment confirmation. If an official VAT invoice is required, please ensure you complete the billing address and fiscal tax code at checkout before submitting your order.</p>
              </div>
            </details>
          </div>
        </div>

        <!-- TAB 3: RETURN AND EXCHANGE POLICY -->
        <div class="liujo-cc-panel{% if section.settings.active_tab == 'returns' %} is-active{% endif %}" id="panel-returns">
          <div class="liujo-cc-panel__header">
            <h2>Return and Exchange Policy</h2>
            <p>We want you to love your Liu Jo purchase. If you need to make a return, we make the process effortless.</p>
          </div>

          <div class="liujo-accordion">
            <details class="liujo-accordion__item" open>
              <summary class="liujo-accordion__title">
                <span>30-Day Return Window &amp; Conditions</span>
                <span class="icon-toggle"></span>
              </summary>
              <div class="liujo-accordion__content">
                <p>You can return any unworn, unwashed item purchased on the Liu Jo online boutique within <strong>30 calendar days</strong> from the delivery date.</p>
                <p>Requirements for an approved return:</p>
                <ul>
                  <li>Products must not have been worn, used, altered, or washed.</li>
                  <li>All original garment tags, security seals, and designer packaging must be attached.</li>
                  <li>Footwear must be tried on carpeted surfaces and returned in the pristine original shoe box.</li>
                  <li>Swimwear and intimate apparel must retain intact hygiene protective strips.</li>
                </ul>
              </div>
            </details>

            <details class="liujo-accordion__item">
              <summary class="liujo-accordion__title">
                <span>How to Initiate a Return</span>
                <span class="icon-toggle"></span>
              </summary>
              <div class="liujo-accordion__content">
                <p>Returning an item takes only a few simple steps:</p>
                <ol>
                  <li>Visit our <a href="https://www.liujo.com/returns/search" target="_blank" rel="noopener noreferrer">Online Return Portal ↗</a>.</li>
                  <li>Enter your Order Number and Email Address to select the items you wish to return.</li>
                  <li>Print the prepaid courier return shipping label generated by the system.</li>
                  <li>Place the items securely inside the original delivery box and affix the return label.</li>
                  <li>Hand the package to the designated courier or drop it at an official courier service point.</li>
                </ol>
              </div>
            </details>

            <details class="liujo-accordion__item">
              <summary class="liujo-accordion__title">
                <span>Refund Processing Times</span>
                <span class="icon-toggle"></span>
              </summary>
              <div class="liujo-accordion__content">
                <p>Once your parcel arrives back at our logistics warehouse in Italy, our quality control team inspects the returned items (allow up to 7 to 10 business days).</p>
                <p>Upon approval, the refund will be credited directly to your original payment method (Credit Card, PayPal, or Klarna). The funds typically reflect in your account within 3 to 5 banking business days depending on your financial institution.</p>
              </div>
            </details>
          </div>
        </div>

        <!-- TAB 4: MAKE A RETURN PORTAL -->
        <div class="liujo-cc-panel{% if section.settings.active_tab == 'make_return' %} is-active{% endif %}" id="panel-make_return">
          <div class="liujo-cc-panel__header">
            <h2>Make a Return</h2>
            <p>Access our self-service returns portal to generate your prepaid courier shipping return label.</p>
          </div>

          <div class="liujo-return-portal-box">
            <h3 class="portal-heading">LOOK UP YOUR ORDER</h3>
            <p class="portal-sub">Enter the order number from your confirmation email and the email address used when placing the order.</p>

            <form class="liujo-portal-form" onsubmit="event.preventDefault(); window.open('https://www.liujo.com/returns/search?order=' + encodeURIComponent(document.getElementById('portal-order-num').value) + '&email=' + encodeURIComponent(document.getElementById('portal-email').value), '_blank');">
              <div class="form-group">
                <label for="portal-order-num">ORDER NUMBER *</label>
                <input type="text" id="portal-order-num" placeholder="e.g. LJ-10894520" required class="portal-input">
              </div>
              <div class="form-group">
                <label for="portal-email">EMAIL ADDRESS *</label>
                <input type="email" id="portal-email" placeholder="e.g. yourname@domain.com" required class="portal-input">
              </div>
              <button type="submit" class="portal-submit-btn">FIND MY ORDER &amp; START RETURN ↗</button>
            </form>

            <div class="portal-external-banner">
              <p>Prefer official Liu Jo Global return tools? You can also <a href="https://www.liujo.com/returns/search" target="_blank" rel="noopener noreferrer">click here to access the direct returns center</a>.</p>
            </div>
          </div>
        </div>

        <!-- TAB 5: SIZE GUIDE -->
        <div class="liujo-cc-panel{% if section.settings.active_tab == 'size_guide' %} is-active{% endif %}" id="panel-size_guide">
          <div class="liujo-cc-panel__header">
            <h2>Size &amp; Fit Guide</h2>
            <p>Liu Jo garments are crafted to Italian tailoring standards. Use this conversion chart to find your perfect fit.</p>
          </div>

          <!-- Category Selector -->
          <div class="liujo-size-tabs">
            <button type="button" class="size-tab-btn is-active" data-size-target="women-apparel">Women Apparel</button>
            <button type="button" class="size-tab-btn" data-size-target="women-denim">Bottom Up Denim</button>
            <button type="button" class="size-tab-btn" data-size-target="footwear">Footwear &amp; Shoes</button>
            <button type="button" class="size-tab-btn" data-size-target="belts">Belts &amp; Accessories</button>
          </div>

          <!-- Women Apparel Table -->
