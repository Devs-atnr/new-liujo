<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Size guide sub-tabs
    var sizeBtns = document.querySelectorAll('.size-tab-btn');
    sizeBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var target = btn.getAttribute('data-size-target');
        sizeBtns.forEach(function(b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');

        document.querySelectorAll('.size-table-container').forEach(function(table) {
          table.style.display = 'none';
        });
        var activeTable = document.getElementById('size-table-' + target);
        if (activeTable) {
          activeTable.style.display = 'block';
        }
      });
    });

    // In-page anchor tab switching if requested via URL hash (#payments, #returns, etc.)
    if (window.location.hash) {
      var hash = window.location.hash.replace('#', '');
      var targetPanel = document.getElementById('panel-' + hash);
      if (targetPanel) {
        document.querySelectorAll('.liujo-cc-panel').forEach(function(p) { p.classList.remove('is-active'); });
        targetPanel.classList.add('is-active');

        document.querySelectorAll('.liujo-cc-nav-link').forEach(function(l) {
          l.classList.remove('is-active');
          if (l.getAttribute('data-target-tab') === hash) {
            l.classList.add('is-active');
          }
        });
      }
    }
  });
</script>

{% schema %}
{
  "name": "Liu Jo Customer Care",
