            <div class="liujo-table-wrap">
              <table class="liujo-size-table">
                <thead>
                  <tr>
                    <th>EU / IT</th>
                    <th>UK</th>
                    <th>US</th>
                    <th>FOOT LENGTH (CM)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td>35</td><td>2.5</td><td>5</td><td>22.5</td></tr>
