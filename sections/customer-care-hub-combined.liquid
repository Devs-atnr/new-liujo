<section id="CareHub-{{ section.id }}" class="care-hub" data-care-hub>
<div class="care-hub__layout"><aside><div>{% content_for 'blocks' %}</div>
{% if section.settings.contact_heading != blank %}<div class="care-hub__contact"><strong>{{ section.settings.contact_heading | escape }}</strong>{% if section.settings.phone != blank %}<p><a href="tel:{{ section.settings.phone | escape }}">{{ section.settings.phone | escape }}</a></p>{% endif %}{% if section.settings.email != blank %}<p><a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a></p>{% endif %}</div>{% endif %}</aside>
<main data-care-panels></main></div></section>
{% style %}
#CareHub-{{ section.id }}{color:{{ section.settings.text_color }}}
#CareHub-{{ section.id }} .care-hub__layout{display:grid;grid-template-columns:minmax(220px,.82fr) minmax(0,1.6fr);gap:clamp(24px,3.6vw,48px);max-width:{{ section.settings.max_width }}px;margin:auto;padding:{{ section.settings.section_padding }}px 24px}
#CareHub-{{ section.id }} .care-hub__group{margin-bottom:24px}.care-hub__group-title{margin:0;background:#4b4b4b;color:#fff;padding:14px 20px;font-size:15px}
#CareHub-{{ section.id }} .care-hub__tab-link{display:flex;justify-content:space-between;padding:18px 20px;border:1px solid #e2e2e2;border-top:0;color:inherit;text-decoration:none;font-size:14px;font-weight:600}
#CareHub-{{ section.id }} .care-hub__tab-link.is-active,#CareHub-{{ section.id }} .care-hub__tab-link:hover{background:#050505;color:white}
#CareHub-{{ section.id }} .care-hub__panel[hidden]{display:none!important}.care-hub__banner{display:grid;place-items:center;min-height:140px;margin-bottom:28px;padding:24px;background:#f6f7f8;text-align:center}.care-hub__banner h1{font-size:clamp(22px,2vw,30px);font-weight:500}
#CareHub-{{ section.id }} .care-hub__form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 12px}.care-hub__field label{display:block;margin-bottom:8px;font-size:12px}.care-hub__field input{width:100%;min-height:50px;border:1px solid #d5d5d5;padding:12px}.care-hub__submit{grid-column:1/-1;width:min(100%,440px);min-height:56px;background:#050505;color:#fff;border:0}
#CareHub-{{ section.id }} .care-hub__accordion{border-top:1px solid #ddd}.care-hub__accordion summary{padding:18px 0;cursor:pointer;font-weight:600;list-style:none}.care-hub__accordion summary:after{content:'+';float:right}.care-hub__accordion[open] summary:after{content:'−'}
#CareHub-{{ section.id }} .care-hub__size-select{width:100%;padding:14px;border:1px solid #ddd}.care-hub__size-panel{display:none;margin-top:20px}.care-hub__size-panel.is-selected{display:block}.care-hub__table{width:100%;border-collapse:collapse}.care-hub__table th,.care-hub__table td{border:1px solid #ddd;padding:10px;text-align:center}
#CareHub-{{ section.id }} .care-hub__product-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px}.care-hub__product img{width:100%;height:auto}.care-hub__contact{margin-top:28px;padding-top:16px;border-top:1px solid #ddd}
@media(max-width:749px){#CareHub-{{ section.id }} .care-hub__layout{grid-template-columns:1fr;padding:16px}.care-hub__form{grid-template-columns:1fr}}
{% endstyle %}
<script>
(()=>{const id='CareHub-{{ section.id }}';function init(root){const h=root.matches && root.matches('#'+id)?root:root.querySelector('#'+id);if(!h||h.dataset.ready)return;h.dataset.ready='1';const host=h.querySelector('[data-care-panels]'),links=[...h.querySelectorAll('[data-care-link]')],panels=[...h.querySelectorAll('[data-care-panel]')];panels.forEach(p=>host.appendChild(p));panels.forEach(p=>p.querySelectorAll('[data-care-content]').forEach(c=>c.hidden=c.dataset.careContent!==p.dataset.contentType&&c.dataset.careContent!=='shared'));function activate(a,push){links.forEach(x=>{x.classList.toggle('is-active',x===a);x.toggleAttribute('aria-current',x===a)});panels.forEach(p=>p.hidden=p.id!==a.dataset.panelId);if(push)history.pushState({},'',a.href)}const path=location.pathname.replace(/\/$/,'')||'/';const active=links.find(a=>{try{return new URL(a.href,location.origin).pathname.replace(/\/$/,'')===path}catch(e){return false}})||links.find(a=>a.dataset.defaultActive==='true')||links[0];if(active)activate(active,false);links.forEach(a=>a.addEventListener('click',e=>{if(e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;e.preventDefault();activate(a,true)}));h.querySelectorAll('[data-size-select]').forEach(s=>{const boxes=[...s.closest('[data-care-content]').querySelectorAll('[data-size-panel]')],sync=()=>boxes.forEach(b=>b.classList.toggle('is-selected',b.dataset.sizeId===s.value));s.addEventListener('change',sync);sync()})}document.addEventListener('DOMContentLoaded',()=>init(document));document.addEventListener('shopify:section:load',e=>init(e.target));if(document.readyState!=='loading')init(document)})();
</script>
{% schema %}
{"name":"Customer care hub","tag":"section","class":"section-customer-care-hub","settings":[{"type":"range","id":"max_width","label":"Content max width","min":900,"max":1800,"step":50,"default":1500,"unit":"px"},{"type":"range","id":"section_padding","label":"Section vertical padding","min":0,"max":80,"step":4,"default":24,"unit":"px"},{"type":"color","id":"text_color","label":"Text color","default":"#090909"},{"type":"text","id":"contact_heading","label":"Contact heading","default":"Can we help you?"},{"type":"text","id":"phone","label":"Phone","default":"+44 330 8087718"},{"type":"text","id":"email","label":"Contact email","default":"hello@example.com"}],"blocks":[{"type":"care-group"}],"presets":[{"name":"Customer care hub","blocks":[{"type":"care-group"},{"type":"care-group"}]}]}
{% endschema %}

