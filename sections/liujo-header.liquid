{% comment %}
  LIU JO LUXURY HEADER SECTION
  Fully dynamic with announcement bar, root tabs, mega-menus, store locator, search, wishlist & mobile drawer.
{% endcomment %}

<div class="liujo-header-container" data-section-id="{{ section.id }}" data-section-type="liujo-header">
  {%- if section.settings.show_announcement -%}
    <div class="liujo-announcement-bar" style="background-color: {{ section.settings.announcement_bg }}; color: {{ section.settings.announcement_text }};">
      <div class="liujo-announcement-content">
        {%- for block in section.blocks -%}
          {%- if block.type == 'announcement' -%}
            <div class="liujo-announcement-slide" {% unless forloop.first %}style="display:none;"{% endunless %} {{ block.shopify_attributes }}>
              <span>{{ block.settings.text }}</span>
              {%- if block.settings.link_label != blank and block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" style="color: {{ section.settings.announcement_text }};"><u>{{ block.settings.link_label }}</u></a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <header class="liujo-header-wrapper">
    <div class="liujo-header">
      <!-- Desktop Left: Root Navigation -->
      <nav class="liujo-header__rootmenu d-none d-lg-flex" aria-label="Main Navigation">
        {%- if section.settings.main_menu != blank -%}
          {%- for link in linklists[section.settings.main_menu].links -%}
            <div class="liujo-header__nav-item">
              <a href="{{ link.url }}" class="liujo-header__nav-link{% if link.active %} is-active{% endif %}">
                {{ link.title }}
              </a>

              {%- if link.links.size > 0 -%}
                <div class="liujo-megamenu">
                  <div class="liujo-megamenu__container">
                    {%- for childlink in link.links -%}
                      <div class="liujo-megamenu__col">
                        <div class="liujo-megamenu__col-title">{{ childlink.title }}</div>
                        {%- if childlink.links.size > 0 -%}
                          <ul class="liujo-megamenu__list">
                            {%- for grandchild in childlink.links -%}
                              <li class="liujo-megamenu__list-item">
                                <a href="{{ grandchild.url }}" class="liujo-megamenu__link">
                                  {{ grandchild.title }}
                                  {%- if grandchild.title contains 'New' or grandchild.title contains 'Gigi' -%}
                                    <sup class="liujo-megamenu__badge">NEW</sup>
                                  {%- endif -%}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}

                    <!-- Mega Menu Editorial Promo Banner -->
                    <div class="liujo-megamenu__promo">
                      <a href="{{ section.settings.promo_link | default: link.url }}" class="liujo-megamenu__promo-card">
                        {%- if section.settings.promo_image != blank -%}
                          <img src="{{ section.settings.promo_image | image_url: width: 600 }}" alt="{{ section.settings.promo_title | escape }}" class="liujo-megamenu__promo-img" loading="lazy">
                        {%- else -%}
                          <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw4278e299/the-gigi-hadid-edit/drop1/HP/Shirts.jpg" alt="Liu Jo Collection" class="liujo-megamenu__promo-img" loading="lazy">
                        {%- endif -%}
                        <div class="liujo-megamenu__promo-overlay">
                          <div class="liujo-megamenu__promo-title">{{ section.settings.promo_title | default: 'The Gigi Hadid Edit' }}</div>
                          <span class="btn-link-editorial" style="color: #fff; font-size: 10px;">Discover</span>
                        </div>
                      </a>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Fallback Liu Jo Luxury Root Navigation -->
          <div class="liujo-header__nav-item">
            <a href="/collections/women" class="liujo-header__nav-link is-active">Women</a>
            <div class="liujo-megamenu">
              <div class="liujo-megamenu__container">
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">New Arrivals</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">The Gigi Hadid Edit <sup class="liujo-megamenu__badge">NEW</sup></a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Spring Summer 2026</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Iconic Denim</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">New In Shoes</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">Clothing</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Jackets & Blazers</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Dresses</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Shirts & Blouses</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Jumpers & Knitwear</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Trousers</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">Jeans & Denim</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Bottom Up Denim</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Flare & Bootcut</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Straight & Wide Leg</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Skinny Jeans</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">Bags & Shoes</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Crossbody Bags</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Tote & Shoulder Bags</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Ankle Boots</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Sneakers</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__promo">
                  <a href="/collections/all" class="liujo-megamenu__promo-card">
                    <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw4278e299/the-gigi-hadid-edit/drop1/HP/Shirts.jpg" alt="Editorial Looks" class="liujo-megamenu__promo-img" loading="lazy">
                    <div class="liujo-megamenu__promo-overlay">
                      <div class="liujo-megamenu__promo-title">The Gigi Hadid Edit</div>
                      <span class="btn-link-editorial" style="color: #fff; font-size: 10px;">Explore Collection</span>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          </div>
          <div class="liujo-header__nav-item"><a href="/collections/all" class="liujo-header__nav-link">Men</a></div>
          <div class="liujo-header__nav-item"><a href="/collections/all" class="liujo-header__nav-link">Kids</a></div>
          <div class="liujo-header__nav-item"><a href="/pages/stories" class="liujo-header__nav-link" style="color: var(--liujo-accent-pink);">Stories</a></div>
        {%- endif -%}
      </nav>

      <!-- Mobile Hamburger Trigger (Left) -->
      <div class="liujo-header__mob-toggler d-flex d-lg-none">
        <button type="button" class="liujo-action-btn" data-liujo-drawer-open aria-label="Open Navigation Menu">
          <svg viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Center: Iconic Brand Logo -->
      <div class="liujo-header__brand">
        <a href="{{ routes.root_url }}" class="liujo-logo-link">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
                 alt="{{ shop.name | escape }}"
                 class="liujo-logo-image"
                 style="width: {{ section.settings.logo_width }}px;">
          {%- else -%}
            <span class="liujo-logo-text">LIU<span>•</span>JO</span>
          {%- endif -%}
        </a>
      </div>

      <!-- Right: Action Icons -->
      <div class="liujo-header__actions">
        {%- if section.settings.show_store_locator -%}
          <a href="{{ section.settings.store_locator_link | default: '/pages/stores' }}" class="liujo-header__store-link d-none d-md-block">
            Locate Stores
          </a>
        {%- endif -%}

        <!-- Search Icon -->
        <a href="{{ routes.search_url }}" class="liujo-action-btn" aria-label="Search">
          <svg viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>

        <!-- Wishlist Icon -->
        <a href="/pages/wishlist" class="liujo-action-btn d-none d-sm-flex" aria-label="Wishlist">
          <svg viewBox="0 0 24 24">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="liujo-badge-count" data-wishlist-count style="display:none;">0</span>
        </a>

        <!-- Account Icon -->
        {%- if shop.customer_accounts_enabled -%}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="liujo-action-btn d-none d-sm-flex" aria-label="Customer Account">
            <svg viewBox="0 0 24 24">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </a>
        {%- endif -%}

        <!-- Shopping Cart Icon -->
        <a href="{{ routes.cart_url }}" class="liujo-action-btn" id="cart-icon-bubble" aria-label="Cart">
          <svg viewBox="0 0 24 24">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          {%- if cart != empty -%}
            <span class="liujo-badge-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      </div>
    </div>
  </header>
</div>

<!-- ==========================================================================
     LIU JO MOBILE OFF-CANVAS NAVIGATION DRAWER
     ========================================================================== -->
<div class="liujo-mob-drawer-overlay" data-liujo-drawer-overlay></div>
<div class="liujo-mob-drawer" data-liujo-drawer>
  <div class="liujo-mob-drawer__header">
    <div class="liujo-logo-text" style="font-size: 20px;">LIU<span>•</span>JO</div>
    <button type="button" class="liujo-action-btn" data-liujo-drawer-close aria-label="Close Navigation">
      <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Mobile Segmented Tabs -->
  <div class="liujo-mob-drawer__tabs">
    <button type="button" class="liujo-mob-tab-btn is-active" data-liujo-tab-btn data-target-tab="women">Women</button>
    <button type="button" class="liujo-mob-tab-btn" data-liujo-tab-btn data-target-tab="men">Men</button>
    <button type="button" class="liujo-mob-tab-btn" data-liujo-tab-btn data-target-tab="kids">Kids</button>
  </div>

  <div class="liujo-mob-drawer__body">
    <!-- Women Panel -->
    <div class="liujo-mob-tab-panel" data-liujo-tab-panel data-tab-id="women">
      <ul class="liujo-mob-nav-list">
        <li class="liujo-mob-nav-item">
          <a href="/collections/all" class="liujo-mob-nav-link" style="color: var(--liujo-accent-pink);">
            <span>The Gigi Hadid Edit</span>
            <sup class="liujo-megamenu__badge">NEW</sup>
          </a>
        </li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>New Arrivals</span> <span>&rsaquo;</span></a></li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Clothing</span> <span>&rsaquo;</span></a></li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Jeans & Denim</span> <span>&rsaquo;</span></a></li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Bags</span> <span>&rsaquo;</span></a></li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Shoes</span> <span>&rsaquo;</span></a></li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Accessories</span> <span>&rsaquo;</span></a></li>
      </ul>
    </div>

    <!-- Men Panel -->
    <div class="liujo-mob-tab-panel" data-liujo-tab-panel data-tab-id="men" style="display:none;">
      <ul class="liujo-mob-nav-list">
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>New In Men</span> <span>&rsaquo;</span></a></li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Jackets & Coats</span> <span>&rsaquo;</span></a></li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Shirts & T-Shirts</span> <span>&rsaquo;</span></a></li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Trousers & Jeans</span> <span>&rsaquo;</span></a></li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Shoes & Sneakers</span> <span>&rsaquo;</span></a></li>
      </ul>
    </div>

    <!-- Kids Panel -->
    <div class="liujo-mob-tab-panel" data-liujo-tab-panel data-tab-id="kids" style="display:none;">
      <ul class="liujo-mob-nav-list">
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Girl (6-16 Years)</span> <span>&rsaquo;</span></a></li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Baby & Toddler</span> <span>&rsaquo;</span></a></li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Dresses & Ceremonies</span> <span>&rsaquo;</span></a></li>
        <li class="liujo-mob-nav-item"><a href="/collections/all" class="liujo-mob-nav-link"><span>Shoes & Bags</span> <span>&rsaquo;</span></a></li>
      </ul>
    </div>
  </div>

  <div class="liujo-mob-drawer__footer">
    <a href="/pages/stores" class="liujo-mob-drawer__footer-link">Locate Stores</a>
    <a href="/pages/contact" class="liujo-mob-drawer__footer-link">Customer Care & Support</a>
    <a href="/pages/wishlist" class="liujo-mob-drawer__footer-link">My Wishlist</a>
    {%- if shop.customer_accounts_enabled -%}
      <a href="{{ routes.account_url }}" class="liujo-mob-drawer__footer-link">My Account</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Liu Jo Header",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Announcement Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "announcement_text",
      "label": "Announcement Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Brand Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "default": 130,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_store_locator",
      "label": "Show 'Locate Stores' link",
      "default": true
    },
    {
      "type": "url",
      "id": "store_locator_link",
      "label": "Store Locator Link"
    },
    {
      "type": "header",
      "content": "Mega Menu Editorial Promo"
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Promotional Banner Image"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Promotional Title",
      "default": "The Gigi Hadid Edit"
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Promotional Link"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "This is just a presentation website"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "default": "Discover"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Liu Jo Header",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "This is just a presentation website",
            "link_label": "Discover"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "New Arrivals | Spring Summer 2026 Collection",
            "link_label": "Explore"
          }
        }
      ]
    }
  ]
}
{% endschema %}
