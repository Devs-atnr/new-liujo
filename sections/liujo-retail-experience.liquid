{% comment %}
  LIU JO RETAIL EXPERIENCE SECTION
  Editorial page showcasing Liu Jo boutique services, worldwide flagships, and personal stylist booking.
{% endcomment %}

<div class="liujo-retail-exp" data-section-id="{{ section.id }}">
  <!-- Editorial Hero -->
  <div class="liujo-rex-hero">
    <div class="liujo-rex-hero__overlay">
      <span class="liujo-rex-hero__tag">LIU JO WORLD</span>
      <h1 class="liujo-rex-hero__title">Retail Experience</h1>
      <p class="liujo-rex-hero__sub">An intimate journey into Italian elegance and tailor-made boutique hospitality.</p>
    </div>
  </div>

  <div class="liujo-rex-container">
    <!-- Network Overview Banner -->
    <div class="liujo-rex-intro">
      <h2 class="liujo-rex-intro__heading">OUR GLOBAL BOUTIQUE NETWORK</h2>
      <p class="liujo-rex-intro__text">
        Liu Jo has <strong>283 own-brand boutiques</strong> and an international network spanning 45 countries. 
        Our network includes 91 flagship boutiques under direct management in world fashion capitals—including 
        Milan, Rome, Paris, Madrid, Berlin, London and Dubai—as well as prestigious shop-in-shops in luxury department 
        stores such as El Corte Inglés, KaDeWe, and De Bijenkorf.
      </p>

      <div class="liujo-rex-stats">
        <div class="liujo-rex-stat-item">
          <span class="stat-number">283</span>
          <span class="stat-label">Boutiques Worldwide</span>
        </div>
        <div class="liujo-rex-stat-item">
          <span class="stat-number">91</span>
          <span class="stat-label">Flagship Stores</span>
        </div>
        <div class="liujo-rex-stat-item">
          <span class="stat-number">45</span>
          <span class="stat-label">Countries</span>
        </div>
        <div class="liujo-rex-stat-item">
          <span class="stat-number">5,000+</span>
          <span class="stat-label">Stockists &amp; Retailers</span>
        </div>
      </div>
    </div>

    <!-- Exclusive In-Store Services Grid -->
    <div class="liujo-rex-services">
      <h3 class="liujo-rex-section-title">EXCLUSIVE BOUTIQUE SERVICES</h3>
      <div class="liujo-rex-services-grid">
        <div class="liujo-service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          </div>
          <h4 class="service-title">BUY FROM STORE</h4>
          <p class="service-desc">Enjoy the full digital catalog directly in our boutique. Our stylists can order any size or piece online for direct home delivery or boutique pickup.</p>
        </div>

        <div class="liujo-service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          </div>
          <h4 class="service-title">RESERVE IN STORE</h4>
          <p class="service-desc">Reserve your favourite looks online without upfront commitment. Visit your chosen boutique to try on pieces prepared in advance by our team.</p>
        </div>

        <div class="liujo-service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <h4 class="service-title">CLICK &amp; COLLECT</h4>
          <p class="service-desc">Shop online anytime and collect your order free of charge at any participating Liu Jo boutique, with full personal styling assistance upon pickup.</p>
        </div>

        <div class="liujo-service-card">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
          </div>
          <h4 class="service-title">BACK IN STORE ALERT</h4>
          <p class="service-desc">Never miss out on sold-out iconic styles. Receive an immediate priority SMS or email notification when your coveted piece returns to boutique stock.</p>
        </div>
      </div>
    </div>

    <!-- Book an Appointment Booking Module -->
    <div class="liujo-rex-booking">
      <div class="booking-text">
        <span class="booking-tag">BESPOKE STYLING</span>
        <h3 class="booking-title">BOOK A DEDICATED SHOPPING SESSION</h3>
        <p class="booking-desc">Immerse yourself in a personalized VIP shopping appointment with a dedicated Liu Jo fashion advisor in our private dressing salons.</p>
        <ul class="booking-perks">
          <li>✓ 1-on-1 personalized wardrobe consultation</li>
          <li>✓ Exclusive previews of new capsule drops</li>
          <li>✓ Tailoring adjustments and custom fitting</li>
        </ul>
      </div>

      <div class="booking-form-box">
        <h4 class="form-title">REQUEST AN APPOINTMENT</h4>
        {% form 'contact', id: 'liujo-appointment-form' %}
          <input type="hidden" name="contact[subject]" value="Boutique Shopping Appointment Request">
          <div class="input-row">
            <input type="text" name="contact[name]" placeholder="FULL NAME *" required class="rex-input">
            <input type="email" name="contact[email]" placeholder="EMAIL ADDRESS *" required class="rex-input">
          </div>
          <div class="input-row">
            <input type="tel" name="contact[phone]" placeholder="TELEPHONE NUMBER *" required class="rex-input">
            <select name="contact[boutique]" class="rex-input" required>
              <option value="" disabled selected>PREFERRED BOUTIQUE *</option>
              <option value="Milan - Corso Vittorio Emanuele">Milan – Corso Vittorio Emanuele</option>
              <option value="Rome - Via del Corso">Rome – Via del Corso</option>
              <option value="Paris - Rue de Rivoli">Paris – Rue de Rivoli</option>
              <option value="London - Regent Street">London – Regent Street</option>
              <option value="Madrid - Calle Serrano">Madrid – Calle Serrano</option>
              <option value="Berlin - Kurfurstendamm">Berlin – Kurfürstendamm</option>
              <option value="Dubai - The Dubai Mall">Dubai – The Dubai Mall</option>
            </select>
          </div>
          <div class="input-row">
            <input type="date" name="contact[date]" class="rex-input" required>
            <select name="contact[time_slot]" class="rex-input" required>
              <option value="" disabled selected>PREFERRED TIME *</option>
              <option value="Morning (10:30 - 13:00)">Morning (10:30 – 13:00)</option>
              <option value="Afternoon (14:00 - 17:00)">Afternoon (14:00 – 17:00)</option>
              <option value="Evening (17:00 - 19:30)">Evening (17:00 – 19:30)</option>
            </select>
          </div>
          <button type="submit" class="rex-btn">CONFIRM RESERVATION REQUEST</button>
          {% if form.posted_successfully? %}
            <p class="form-success">Thank you! Your boutique appointment request has been submitted. A stylist will confirm shortly.</p>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</div>

<style>
  .liujo-retail-exp {
    background: #fff;
    color: #111;
  }
  .liujo-rex-hero {
    position: relative;
    height: 480px;
    background: url('https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw83a21698/the-gigi-hadid-edit/drop1/HP/Hero-1-desk.jpg') center/cover no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .liujo-rex-hero__overlay {
    background: rgba(0,0,0,0.45);
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    color: #fff;
  }
  .liujo-rex-hero__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #ddd;
    margin-bottom: 12px;
  }
  .liujo-rex-hero__title {
    font-size: 42px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 14px 0;
    color: #fff;
  }
  .liujo-rex-hero__sub {
    font-size: 15px;
    max-width: 650px;
    color: #eee;
    line-height: 1.6;
    margin: 0;
  }
  .liujo-rex-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 70px 20px;
  }
  .liujo-rex-intro {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 70px;
  }
  .liujo-rex-intro__heading {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 18px 0;
  }
  .liujo-rex-intro__text {
    font-size: 15px;
    line-height: 1.8;
    color: #555;
    margin-bottom: 40px;
  }
  .liujo-rex-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    border-top: 1px solid #e0e0e0;
    border-bottom: 1px solid #e0e0e0;
    padding: 30px 0;
  }
  .stat-number {
    display: block;
    font-size: 36px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #000;
    margin-bottom: 6px;
  }
  .stat-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #777;
  }
  .liujo-rex-section-title {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 40px 0;
  }
  .liujo-rex-services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 80px;
  }
  .liujo-service-card {
    background: #fafafa;
    border: 1px solid #eaeaea;
    padding: 32px 24px;
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .liujo-service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  }
  .service-icon {
    margin-bottom: 20px;
    color: #000;
  }
  .service-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 12px 0;
  }
  .service-desc {
    font-size: 13px;
    line-height: 1.6;
    color: #666;
    margin: 0;
  }
  .liujo-rex-booking {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    background: #000;
    color: #fff;
    padding: 60px;
  }
  .booking-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: #aaa;
    display: block;
    margin-bottom: 12px;
  }
  .booking-title {
    font-size: 26px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 18px 0;
  }
  .booking-desc {
    font-size: 14px;
    color: #bbb;
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .booking-perks {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 13px;
    color: #ddd;
    line-height: 2;
  }
  .booking-form-box {
    background: #fff;
    color: #000;
    padding: 36px;
  }
  .form-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 20px 0;
    text-align: center;
  }
  .input-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 14px;
  }
  .rex-input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #ccc;
    font-size: 13px;
    box-sizing: border-box;
    font-family: inherit;
    background: #fff;
  }
  .rex-btn {
    width: 100%;
    padding: 14px;
    background: #000;
    color: #fff;
    border: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 10px;
    transition: background 0.2s;
  }
  .rex-btn:hover {
    background: #333;
  }
  .form-success {
    font-size: 13px;
    color: #2e7d32;
    margin-top: 14px;
    text-align: center;
  }
  @media screen and (max-width: 900px) {
    .liujo-rex-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .liujo-rex-services-grid {
      grid-template-columns: 1fr 1fr;
    }
    .liujo-rex-booking {
      grid-template-columns: 1fr;
      padding: 30px 20px;
    }
    .input-row {
      grid-template-columns: 1fr;
    }
  }
  @media screen and (max-width: 600px) {
    .liujo-rex-services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Liu Jo Retail Experience",
  "settings": [],
  "presets": [
    {
      "name": "Liu Jo Retail Experience"
    }
  ]
}
{% endschema %}
