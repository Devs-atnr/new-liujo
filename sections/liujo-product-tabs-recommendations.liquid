{% comment %}
  LIU JO PRODUCT TABS RECOMMENDATIONS SECTION
  - Dual tabs: "YOU MIGHT LIKE" and "RECENTLY VIEWED".
  - Tab navigation with baseline and solid black active indicator.
  - Horizontal product carousel matching Home Page slider behavior:
    * Circular white navigation arrows (< and >) centered on product images.
    * Desktop slides by 2 cards per click, mobile slides by 1 card.
    * Smooth mouse drag scrolling (identical to home carousel).
    * Horizontal mouse wheel scroll without visible scrollbar.
    * Smooth native touch swipe on mobile.
    * Always renders at least 8 cards in both tabs so track always has overflow to slide.
    * Dynamic Recently Viewed tracking from localStorage.
{% endcomment %}

<style>
  .liujo-tabs-section-{{ section.id }} {
    width: 100%;
    max-width: 100%;
    position: relative;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: #ffffff;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .liujo-tabs-container {
    max-width: var(--liujo-container-max, 1360px);
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
    width: 100%;
  }

  /* Tabs Navigation Header */
  .liujo-tabs-nav-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    border-bottom: 1px solid #ebebeb;
    margin-bottom: 36px;
    position: relative;
    width: 100%;
    padding: 0 32px;
    box-sizing: border-box;
  }

  .liujo-tabs-nav {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 36px;
    position: relative;
  }

  .liujo-tab-button {
    background: transparent;
    border: none;
    padding: 12px 10px 14px 10px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #767676;
    cursor: pointer;
    position: relative;
    transition: color 0.2s ease;
    outline: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .liujo-tab-button:hover,
  .liujo-tab-button.is-active {
    color: #000000;
    font-weight: 600;
  }

  .liujo-tab-button.is-active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #000000;
  }

  .liujo-tab-panel {
    display: none;
    width: 100%;
    position: relative;
  }

  .liujo-tab-panel.is-active {
    display: block !important;
  }

  /* Slider Track inside Container with Left/Right Space */
  .liujo-tabs-slider-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .liujo-tabs-track {
    display: flex !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
    cursor: grab !important;
    user-select: none !important;
    -webkit-user-select: none !important;
    gap: 0 !important;
  }

  .liujo-tabs-track::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  .liujo-tabs-track.is-dragging {
    cursor: grabbing !important;
  }

  .liujo-tabs-track,
  .liujo-tab-card,
  .liujo-tab-card a,
  .liujo-tab-card img {
    -webkit-user-drag: none !important;
    -khtml-user-drag: none !important;
    -moz-user-drag: none !important;
    -o-user-drag: none !important;
    user-drag: none !important;
    user-select: none !important;
    -webkit-user-select: none !important;
  }

  .liujo-tabs-track.is-dragging,
  .liujo-tabs-track.is-dragging * {
    cursor: grabbing !important;
    user-select: none !important;
    -webkit-user-select: none !important;
  }

  /* 4 cards visible edge-to-edge, no gap */
  .liujo-tab-card {
    flex: 0 0 25% !important;
    width: 25% !important;
    min-width: 0 !important;
    box-sizing: border-box;
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #000000;
    border: none !important;
    margin: 0 !important;
    padding: 0 !important;
    background-color: #ffffff;
    cursor: pointer;
  }

  .liujo-tab-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #f7f7f7;
  }

  .liujo-tab-card-media a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .liujo-tab-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.45s ease;
  }

  .liujo-tab-card-media .img-secondary {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .liujo-tab-card:hover .img-primary.has-secondary {
    opacity: 0;
  }

  .liujo-tab-card:hover .img-secondary {
    opacity: 1;
    transform: scale(1.02);
  }

  .liujo-tab-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    font-family: inherit;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #000000;
    background: transparent;
    z-index: 3;
    pointer-events: none;
  }

  .liujo-tab-wishlist {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.85);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    transition: background-color 0.2s ease, transform 0.2s ease;
    color: #000000;
  }

  .liujo-tab-wishlist:hover {
    background-color: #ffffff;
    transform: scale(1.08);
  }

  .liujo-tab-wishlist.is-active svg {
    fill: #000000;
    stroke: #000000;
  }

  .liujo-tab-wishlist svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  .liujo-tab-info {
    display: flex;
    flex-direction: column;
    padding: 10px 10px 16px 10px;
  }

  .liujo-tab-title {
    font-family: inherit;
    font-size: 12px;
    font-weight: 400;
    color: #000000;
    text-decoration: none;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.02em;
    display: inline-block;
    max-width: 100%;
  }

  .liujo-tab-title:hover {
    text-decoration: underline;
    opacity: 0.8;
  }

  .liujo-tab-price {
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    color: #000000;
    margin-top: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .liujo-tab-price-compare {
    color: #888888;
    text-decoration: line-through;
    font-weight: 400;
    font-size: 11px;
  }

  /* Carousel Control Arrows Hidden */
  .liujo-tabs-arrow {
    display: none !important;
  }

  @media (max-width: 1024px) {
    .liujo-tab-card {
      flex: 0 0 33.333% !important;
      width: 33.333% !important;
      min-width: 0 !important;
    }
    .liujo-tabs-nav-wrapper {
      padding: 0 20px;
    }
  }

  @media (max-width: 767px) {
    .liujo-tabs-section {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px !important;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px !important;
    }
    .liujo-tabs-container {
      padding: 0 !important;
    }
    .liujo-tabs-nav-wrapper {
      padding: 0 !important;
      margin-bottom: 24px !important;
      border-bottom: 1px solid #d2d2d2 !important;
      width: 100% !important;
    }
    .liujo-tabs-nav {
      width: 100% !important;
      display: flex !important;
      gap: 0 !important;
      justify-content: stretch !important;
    }
    .liujo-tab-button {
      flex: 1 1 50% !important;
      width: 50% !important;
      padding: 10px 4px 14px 4px !important;
      font-size: 13px !important;
      font-weight: 500 !important;
      letter-spacing: 0.06em !important;
      text-transform: uppercase !important;
      color: #949494 !important;
      text-align: center !important;
      justify-content: center !important;
      box-sizing: border-box !important;
      line-height: 1.35 !important;
    }
    .liujo-tab-button.is-active {
      color: #000000 !important;
      font-weight: 600 !important;
    }
    .liujo-tab-button.is-active::after {
      height: 2px !important;
      background-color: #000000 !important;
      bottom: -1px !important;
      left: 0 !important;
      width: 100% !important;
    }
    .liujo-tab-btn-text {
      display: inline-block !important;
      max-width: 100px !important;
      text-align: center !important;
      line-height: 1.35 !important;
    }
    .liujo-tabs-track {
      gap: 10px !important;
      padding: 0 16px !important;
      scroll-padding: 0 16px !important;
    }
    .liujo-tab-card {
      flex: 0 0 43% !important;
      width: 43% !important;
      min-width: 0 !important;
    }
    .liujo-tab-card-media {
      aspect-ratio: 3 / 4 !important;
    }
    .liujo-tab-wishlist {
      display: none !important;
    }
    .liujo-tab-badge {
      display: none !important;
    }
    .liujo-tab-info {
      padding: 8px 0 12px 0 !important;
    }
    .liujo-tab-title {
      font-size: 12px !important;
      font-weight: 400 !important;
      color: #000000 !important;
      text-decoration: none !important;
      line-height: 1.35 !important;
      white-space: normal !important;
      letter-spacing: 0.02em !important;
      display: -webkit-box !important;
      -webkit-line-clamp: 2 !important;
      -webkit-box-orient: vertical !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
    }
    .liujo-tab-price {
      font-size: 11px !important;
      margin-top: 3px !important;
    }
  }
</style>

<script>
  window.switchLiuJoTab = function(btn, targetId) {
    if (!btn || !targetId) return;
    var sec = btn.closest('.liujo-tabs-section');
    if (!sec) return;
    var btns = sec.querySelectorAll('.liujo-tab-button');
    for (var i = 0; i < btns.length; i++) {
      btns[i].classList.remove('is-active');
      btns[i].setAttribute('aria-selected', 'false');
    }
    btn.classList.add('is-active');
    btn.setAttribute('aria-selected', 'true');
    var panels = sec.querySelectorAll('.liujo-tab-panel');
    for (var j = 0; j < panels.length; j++) {
      panels[j].classList.remove('is-active');
      panels[j].style.setProperty('display', 'none', 'important');
    }
    var ap = document.getElementById(targetId);
    if (ap) {
      ap.classList.add('is-active');
      ap.style.setProperty('display', 'block', 'important');
      if (typeof window.updateRecentlyViewedGrid === 'function') {
        window.updateRecentlyViewedGrid(sec);
      }
      if (typeof window.setupTabCarousel === 'function') {
        window.setupTabCarousel(ap);
      }
    }
  };
</script>

<div class="liujo-tabs-section liujo-tabs-section-{{ section.id }}" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
  <div class="liujo-tabs-container">
    <!-- Tabs Navigation Header -->
    <div class="liujo-tabs-nav-wrapper">
      <div class="liujo-tabs-nav" role="tablist">
        <button
          type="button"
          class="liujo-tab-button is-active"
          role="tab"
          aria-selected="true"
          aria-controls="panel-recommendations-{{ section.id }}"
          id="tab-btn-recommendations-{{ section.id }}"
          data-target="panel-recommendations-{{ section.id }}"
          onclick="window.switchLiuJoTab(this, 'panel-recommendations-{{ section.id }}')"
        >
          <span class="liujo-tab-btn-text">{{ section.settings.tab_1_title | default: 'YOU MIGHT LIKE' }}</span>
        </button>

        <button
          type="button"
          class="liujo-tab-button"
          role="tab"
          aria-selected="false"
          aria-controls="panel-recently-viewed-{{ section.id }}"
          id="tab-btn-recently-viewed-{{ section.id }}"
          data-target="panel-recently-viewed-{{ section.id }}"
          onclick="window.switchLiuJoTab(this, 'panel-recently-viewed-{{ section.id }}')"
        >
          <span class="liujo-tab-btn-text">{{ section.settings.tab_2_title | default: 'RECENTLY VIEWED' }}</span>
        </button>
      </div>
    </div>

    <!-- Tab 1: YOU MIGHT LIKE (Recommendations Slider) -->
    <div
      id="panel-recommendations-{{ section.id }}"
      class="liujo-tab-panel is-active"
      role="tabpanel"
      aria-labelledby="tab-btn-recommendations-{{ section.id }}"
    >
      <div class="liujo-tabs-slider-wrap">
        <!-- Prev Arrow Button -->
        <button type="button" class="liujo-tabs-arrow arrow-prev" data-tabs-prev aria-label="Previous Products">
          <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>

        <ul class="liujo-tabs-track liujo-recommendations-track" data-tabs-track>
          {%- assign rec_products = recommendations.products -%}
          {%- assign curated_collection = collections[section.settings.collection] -%}
          {%- assign all_store_prods = collections.all.products -%}

          {%- assign shown_count = 0 -%}

          {%- if curated_collection != blank and curated_collection.products_count > 0 -%}
            {%- for prod in curated_collection.products -%}
              {%- if prod.id != product.id -%}
                {%- assign shown_count = shown_count | plus: 1 -%}
                <li class="liujo-tab-card" data-product-url="{{ prod.url }}">
                  <div class="liujo-tab-card-media">
                    {%- if prod.tags contains 'THE GIGI HADID EDIT' or prod.tags contains 'gigi-hadid' -%}
                      <span class="liujo-tab-badge">THE GIGI HADID EDIT</span>
                    {%- endif -%}

                    {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                      <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="{{ prod.id }}" aria-label="Add to Wishlist">
                        <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      </button>
                    {%- endif -%}

                    <a href="{{ prod.url }}" class="liujo-tab-card-link">
                      {%- if prod.featured_media != blank -%}
                        <img src="{{ prod.featured_media | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-primary{% if prod.media.size > 1 %} has-secondary{% endif %}" loading="lazy">
                        {%- if prod.media.size > 1 -%}
                          <img src="{{ prod.media[1] | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-secondary" loading="lazy">
                        {%- endif -%}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'img-primary' }}
                      {%- endif -%}
                    </a>
                  </div>

                  <div class="liujo-tab-info">
                    <a href="{{ prod.url }}" class="liujo-tab-title">{{ prod.title }}</a>
                    {%- if section.settings.show_price -%}
                      <div class="liujo-tab-price">
                        <span>{{ prod.price | money }}</span>
                        {%- if prod.compare_at_price > prod.price -%}
                          <span class="liujo-tab-price-compare">{{ prod.compare_at_price | money }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </li>
                {%- if shown_count >= 8 -%}{%- break -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- elsif all_store_prods != blank and all_store_prods.size > 0 -%}
            {%- for prod in all_store_prods -%}
              {%- if prod.id != product.id -%}
                {%- assign shown_count = shown_count | plus: 1 -%}
                <li class="liujo-tab-card" data-product-url="{{ prod.url }}">
                  <div class="liujo-tab-card-media">
                    {%- if prod.tags contains 'THE GIGI HADID EDIT' or prod.tags contains 'gigi-hadid' -%}
                      <span class="liujo-tab-badge">THE GIGI HADID EDIT</span>
                    {%- endif -%}

                    {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                      <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="{{ prod.id }}" aria-label="Add to Wishlist">
                        <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      </button>
                    {%- endif -%}

                    <a href="{{ prod.url }}" class="liujo-tab-card-link">
                      {%- if prod.featured_media != blank -%}
                        <img src="{{ prod.featured_media | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-primary{% if prod.media.size > 1 %} has-secondary{% endif %}" loading="lazy">
                        {%- if prod.media.size > 1 -%}
                          <img src="{{ prod.media[1] | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-secondary" loading="lazy">
                        {%- endif -%}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'img-primary' }}
                      {%- endif -%}
                    </a>
                  </div>

                  <div class="liujo-tab-info">
                    <a href="{{ prod.url }}" class="liujo-tab-title">{{ prod.title }}</a>
                    {%- if section.settings.show_price -%}
                      <div class="liujo-tab-price">
                        <span>{{ prod.price | money }}</span>
                        {%- if prod.compare_at_price > prod.price -%}
                          <span class="liujo-tab-price-compare">{{ prod.compare_at_price | money }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </li>
                {%- if shown_count >= 8 -%}{%- break -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if shown_count < 8 -%}
            {%- assign needed = 8 | minus: shown_count -%}
            {%- assign fallback_url = '/collections/all' -%}

            {%- if needed >= 1 -%}
            <li class="liujo-tab-card" data-product-url="{{ fallback_url }}">
              <div class="liujo-tab-card-media">
                <a href="{{ fallback_url }}" class="liujo-tab-card-link">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dwad3a193a/images/E-4B7001PX002S1815-7-N.jpeg?sw=594&sh=826" alt="Monogram Platform Sandals" class="img-primary has-secondary" loading="lazy">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw398aeb5d/images/E-4B7001PX002S1815-6-N.jpeg?sw=594&sh=826" alt="Monogram Platform Sandals" class="img-secondary" loading="lazy">
                </a>
              </div>
              <div class="liujo-tab-info">
                <a href="{{ fallback_url }}" class="liujo-tab-title">Monogram Platform Sandals</a>
                <div class="liujo-tab-price">
                  <span>€ 233.00</span>
                  <span class="liujo-tab-price-compare">€ 775.00</span>
                </div>
              </div>
            </li>
            {%- endif -%}

            {%- if needed >= 2 -%}
            <li class="liujo-tab-card" data-product-url="{{ fallback_url }}">
              <div class="liujo-tab-card-media">
                <a href="{{ fallback_url }}" class="liujo-tab-card-link">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw0fc7c95b/images/E-ZB7301T055B79215-4-N.jpeg?sw=594&sh=826" alt="Sneakers with All-Over Rhinestones" class="img-primary has-secondary" loading="lazy">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dwb9dbf93d/images/E-ZB7301T055B79215-3-N.jpeg?sw=594&sh=826" alt="Sneakers with All-Over Rhinestones" class="img-secondary" loading="lazy">
                </a>
              </div>
              <div class="liujo-tab-info">
                <a href="{{ fallback_url }}" class="liujo-tab-title">Sneakers with All-Over Rhinestones</a>
                <div class="liujo-tab-price">
                  <span>€ 188.00</span>
                  <span class="liujo-tab-price-compare">€ 625.00</span>
                </div>
              </div>
            </li>
            {%- endif -%}

            {%- if needed >= 3 -%}
            <li class="liujo-tab-card" data-product-url="{{ fallback_url }}">
              <div class="liujo-tab-card-media">
                <a href="{{ fallback_url }}" class="liujo-tab-card-link">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw4f25c2d3/images/E-WF6299T498002069-1-N.jpeg?sw=594&sh=826" alt="Silk-Blend Blouse" class="img-primary has-secondary" loading="lazy">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw0f1110e5/images/E-WF6299T498002069-2-N.jpeg?sw=594&sh=826" alt="Silk-Blend Blouse" class="img-secondary" loading="lazy">
                </a>
              </div>
              <div class="liujo-tab-info">
                <a href="{{ fallback_url }}" class="liujo-tab-title">Silk-Blend Blouse</a>
                <div class="liujo-tab-price">
                  <span>€ 315.00</span>
                  <span class="liujo-tab-price-compare">€ 1,050.00</span>
                </div>
              </div>
            </li>
            {%- endif -%}

            {%- if needed >= 4 -%}
            <li class="liujo-tab-card" data-product-url="{{ fallback_url }}">
