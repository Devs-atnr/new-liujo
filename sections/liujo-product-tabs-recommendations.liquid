<script>
  (function() {
    // 1. Global Tab Switcher Function
    window.switchLiuJoTab = function(btn, targetId) {
      if (!btn || !targetId) return;
      var section = btn.closest('.liujo-tabs-section');
      if (!section) return;

      var buttons = section.querySelectorAll('.liujo-tab-button');
      buttons.forEach(function(b) {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');

      var panels = section.querySelectorAll('.liujo-tab-panel');
      panels.forEach(function(p) {
        p.classList.remove('is-active');
      });

      var activePanel = document.getElementById(targetId);
      if (activePanel) {
        activePanel.classList.add('is-active');
        if (targetId.indexOf('recently-viewed') !== -1 && typeof window.updateRecentlyViewedGrid === 'function') {
          window.updateRecentlyViewedGrid(section);
        }
        if (typeof window.initTabsCarouselTrack === 'function') {
          window.initTabsCarouselTrack(activePanel);
        }
      }
    };

    // 2. Record Current Product into localStorage
    {%- if product != blank -%}
      try {
        var curProd = {
          id: {{ product.id | json }},
          title: {{ product.title | json }},
          url: {{ product.url | json }},
          image: {{ product.featured_media | image_url: width: 600 | json }},
          secondary_image: {% if product.media.size > 1 %}{{ product.media[1] | image_url: width: 600 | json }}{% else %}null{% endif %},
          price: {{ product.price | money | json }}
        };

        var stored = [];
        try {
          stored = JSON.parse(localStorage.getItem('liujo_recently_viewed') || '[]');
        } catch(e) {
          stored = [];
        }

        if (curProd.id && curProd.url) {
          var updated = stored.filter(function(p) { return p && String(p.id) !== String(curProd.id); });
          updated.unshift(curProd);
          if (updated.length > 20) updated = updated.slice(0, 20);
          localStorage.setItem('liujo_recently_viewed', JSON.stringify(updated));
        }
      } catch (err) {
        console.warn('Recently viewed storage error:', err);
      }
    {%- endif -%}

    // 3. Update Recently Viewed Track with Stored Viewed Products
    window.updateRecentlyViewedGrid = function(section) {
      if (!section) return;
      var currentProdId = section.getAttribute('data-product-id') || '';
      var grid = section.querySelector('.liujo-recently-viewed-track');
      if (!grid) return;

      try {
        var raw = localStorage.getItem('liujo_recently_viewed');
        if (!raw) return;
        var viewed = JSON.parse(raw);
        if (!Array.isArray(viewed)) return;

        var validViewed = viewed.filter(function(p) {
          return p && p.url && String(p.id) !== String(currentProdId);
        });
        if (validViewed.length === 0) return;

        var cards = [];
        var seenUrls = {};

        validViewed.forEach(function(prod) {
          seenUrls[prod.url] = true;
          cards.push(
            '<li class="liujo-tab-card" data-product-url="' + prod.url + '">' +
              '<div class="liujo-tab-card-media">' +
                '<button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="' + prod.id + '" aria-label="Add to Wishlist">' +
                  '<svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>' +
                '</button>' +
                '<a href="' + prod.url + '" class="liujo-tab-card-link">' +
                  '<img src="' + prod.image + '" alt="' + (prod.title || 'Product').replace(/"/g, '&quot;') + '" class="img-primary ' + (prod.secondary_image ? 'has-secondary' : '') + '" loading="lazy">' +
                  (prod.secondary_image ? '<img src="' + prod.secondary_image + '" alt="' + (prod.title || 'Product').replace(/"/g, '&quot;') + '" class="img-secondary" loading="lazy">' : '') +
                '</a>' +
              '</div>' +
              '<div class="liujo-tab-info">' +
                '<a href="' + prod.url + '" class="liujo-tab-title">' + (prod.title || '') + '</a>' +
                (prod.price ? '<div class="liujo-tab-price"><span>' + prod.price + '</span></div>' : '') +
              '</div>' +
            '</li>'
          );
        });

        // If fewer than 8 cards, append from recommendations so slider can always scroll smoothly
        if (cards.length < 8) {
          var recCards = section.querySelectorAll('.liujo-recommendations-track .liujo-tab-card');
          recCards.forEach(function(c) {
            var url = c.getAttribute('data-product-url');
            if (url && !seenUrls[url]) {
              seenUrls[url] = true;
              cards.push(c.outerHTML);
            }
          });
        }

        grid.innerHTML = cards.join('');

        if (window.syncLiuJoWishlistButtons) {
          window.syncLiuJoWishlistButtons();
        }
      } catch (e) {
        console.error('Error updating recently viewed:', e);
      }
    };

    // 4. Carousel Interactions: Smooth Drag, Wheel Scroll & Touch Swipe for Both Tracks
    window.initTabsCarouselTrack = function(container) {
      if (!container) return;
      var track = container.querySelector('[data-tabs-track]');
      if (!track || track._hasLiuJoCarousel) return;
      track._hasLiuJoCarousel = true;

      track.ondragstart = function(e) { e.preventDefault(); };

      // Mouse Wheel Horizontal Scroll
      var wheelTimer = null;
      track.addEventListener('wheel', function(e) {
        var delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        if (Math.abs(delta) > 0) {
          var canScrollRight = delta > 0 && (track.scrollLeft + track.clientWidth < track.scrollWidth - 4);
          var canScrollLeft = delta < 0 && track.scrollLeft > 4;
          if (canScrollRight || canScrollLeft) {
            e.preventDefault();
            track.style.scrollSnapType = 'none';
            track.scrollLeft += delta * 1.25;
            clearTimeout(wheelTimer);
            wheelTimer = setTimeout(function() {
              track.style.scrollSnapType = 'x proximity';
            }, 120);
          }
        }
      }, { passive: false });

      // Mouse Drag to Swipe
      var isDown = false;
      var startX = 0;
      var scrollLeft = 0;
      var hasDragged = false;

      track.addEventListener('mousedown', function(e) {
        if (e.button !== 0) return;
        if (e.target.closest('button, [data-liujo-wishlist]')) return;
        isDown = true;
        hasDragged = false;
        startX = e.pageX;
        scrollLeft = track.scrollLeft;
      });

      window.addEventListener('mousemove', function(e) {
        if (!isDown) return;
        var diff = e.pageX - startX;
        if (Math.abs(diff) > 5) {
          hasDragged = true;
          track.classList.add('is-dragging');
          track.style.scrollSnapType = 'none';
          track.style.scrollBehavior = 'auto';
          e.preventDefault();
        }
        if (hasDragged) {
          track.scrollLeft = scrollLeft - (diff * 1.35);
        }
      });

      window.addEventListener('mouseup', function() {
        if (!isDown) return;
        isDown = false;
        track.classList.remove('is-dragging');
        track.style.scrollSnapType = 'x proximity';
        setTimeout(function() {
          hasDragged = false;
        }, 80);
      });

      // Touch Events for Mobile Swiping
      var touchStartX = 0;
      var touchDragged = false;

      track.addEventListener('touchstart', function(e) {
        if (e.touches.length !== 1) return;
        touchStartX = e.touches[0].pageX;
        touchDragged = false;
      }, { passive: true });

      track.addEventListener('touchmove', function(e) {
        if (e.touches.length !== 1) return;
        if (Math.abs(e.touches[0].pageX - touchStartX) > 8) {
          touchDragged = true;
        }
      }, { passive: true });

      track.addEventListener('touchend', function() {
        setTimeout(function() {
          touchDragged = false;
        }, 80);
      });

      // Card Click Navigation
      track.addEventListener('click', function(e) {
        if (hasDragged || touchDragged) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        if (e.target.closest('[data-liujo-wishlist]')) return;

        var card = e.target.closest('.liujo-tab-card');
        if (card) {
          var directLink = e.target.closest('a');
          if (directLink && directLink.href) return;
          var link = card.querySelector('a.liujo-tab-card-link') || card.querySelector('a');
          if (link && link.href) {
            window.location.href = link.href;
          }
        }
      });
    };

    // 5. Initialize All Tab Sections
    function initAllSections() {
      var sections = document.querySelectorAll('.liujo-tabs-section');
      sections.forEach(function(sec) {
        window.updateRecentlyViewedGrid(sec);
        sec.querySelectorAll('.liujo-tab-panel').forEach(function(panel) {
          window.initTabsCarouselTrack(panel);
        });

        var tabButtons = sec.querySelectorAll('.liujo-tab-button');
        tabButtons.forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            var targetId = btn.getAttribute('data-target');
            if (targetId) {
              window.switchLiuJoTab(btn, targetId);
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAllSections);
    } else {
      initAllSections();
    }
  })();
</script>

{% schema %}
{
  "name": "Liu Jo Product Tabs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "default": true,
      "label": "Show Wishlist button"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": false,
      "label": "Show price under product title"
    },
    {
      "type": "text",
      "id": "tab_1_title",
      "label": "First Tab Title",
      "default": "YOU MIGHT LIKE"
    },
    {
      "type": "text",
      "id": "tab_2_title",
      "label": "Second Tab Title",
      "default": "RECENTLY VIEWED"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Number of products to show in slider"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Recently Viewed Empty State Text",
      "default": "No recently viewed items yet"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Liu Jo Product Tabs"
    }
  ]
}
{% endschema %}
