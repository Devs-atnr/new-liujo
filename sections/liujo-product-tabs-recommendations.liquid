              {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="fallback-8" aria-label="Add to Wishlist">
                  <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </button>
              {%- endif -%}
              <a href="#">
                <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dwc6827050/images/E-UA4012D405778502-3-N.jpeg?sw=594&sh=826" alt="Flare jeans with belt jewel" class="img-primary" loading="lazy">
              </a>
            </div>
