              </a>
            </div>
            <div class="liujo-tab-info">
              <a href="#" class="liujo-tab-title">Jacket with hood padded</a>
              <div class="liujo-tab-price"><span>€ 229.00</span></div>
            </div>
          </li>

          <li class="liujo-tab-card">
            <div class="liujo-tab-card-media">
              <span class="liujo-tab-badge">THE GIGI HADID EDIT</span>
              {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="fallback-6" aria-label="Add to Wishlist">
