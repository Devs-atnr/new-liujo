{% comment %}
  LIU JO PRODUCT TABS RECOMMENDATIONS SECTION
  - Container-constrained layout matching Image 3 with left/right space and margin below tabs.
  - Dual tabs: "YOU MIGHT LIKE" and "RECENTLY VIEWED".
  - Tab navigation with continuous baseline and solid black active indicator (Image 3 Parity).
  - Seamless 0px gap between cards (4 full cards visible across desktop screen = 25% each inside container).
  - Every card pulls real store products so clicking navigates to that exact product's page.
  - Recently Viewed is always full (padded with recommendations) so cards never sit isolated with empty space, and swiping always works smoothly.
  - Mouse wheel scrolls horizontally without visible scrollbars; mouse drag and touch swipe work seamlessly.
{% endcomment %}

{%- capture fallback_rec_json -%}
[
  {%- assign rec_count = 0 -%}
  {%- assign src_products = recommendations.products -%}
  {%- if src_products == blank or src_products.size == 0 -%}
    {%- assign src_products = collections[section.settings.collection].products -%}
  {%- endif -%}
  {%- if src_products == blank or src_products.size == 0 -%}
    {%- assign src_products = collections.all.products -%}
  {%- endif -%}
  {%- for prod in src_products -%}
    {%- if prod.id != product.id -%}
      {%- if rec_count > 0 -%},{%- endif -%}
      {
        "id": {{ prod.id | json }},
        "title": {{ prod.title | json }},
        "url": {{ prod.url | json }},
        "image": {{ prod.featured_media | image_url: width: 600 | json }},
        "secondary_image": {% if prod.media.size > 1 %}{{ prod.media[1] | image_url: width: 600 | json }}{% else %}null{% endif %},
        "price": {{ prod.price | money | json }},
        "compare_at_price": {% if prod.compare_at_price > prod.price %}{{ prod.compare_at_price | money | json }}{% else %}null{% endif %},
        "badge": {% if prod.tags contains 'THE GIGI HADID EDIT' or prod.tags contains 'gigi-hadid' %}"THE GIGI HADID EDIT"{% else %}null{% endif %}
      }
      {%- assign rec_count = rec_count | plus: 1 -%}
      {%- if rec_count >= 12 -%}{%- break -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
]
{%- endcapture -%}

<style>
  .liujo-tabs-section-{{ section.id }} {
    width: 100%;
    max-width: 100%;
    position: relative;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: #ffffff;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .liujo-tabs-container {
    max-width: var(--liujo-container-max, 1360px);
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
    width: 100%;
  }

  /* Tabs Navigation Header (Image 3 Parity) */
  .liujo-tabs-nav-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    border-bottom: 1px solid #ebebeb;
    margin-bottom: 36px;
    position: relative;
    width: 100%;
  }

  .liujo-tabs-nav {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 36px;
    position: relative;
  }

  .liujo-tab-button {
    background: transparent;
    border: none;
    padding: 12px 10px 14px 10px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #767676;
    cursor: pointer;
    position: relative;
    transition: color 0.2s ease;
    outline: none;
  }

  .liujo-tab-button:hover,
  .liujo-tab-button.is-active {
    color: #000000;
    font-weight: 600;
  }

  .liujo-tab-button.is-active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #000000;
  }

  .liujo-tab-panel {
    display: none;
    width: 100%;
    position: relative;
  }

  .liujo-tab-panel.is-active {
    display: block;
  }

  /* Slider Track inside Container with Left/Right Space */
  .liujo-tabs-slider-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .liujo-tabs-track {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scroll-behavior: auto;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y pinch-zoom;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
    cursor: grab;
    user-select: none;
    gap: 0 !important;
  }

  .liujo-tabs-track::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  .liujo-tabs-track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  /* 4 cards visible side by side with 0px gap inside container */
  .liujo-tab-card {
    flex: 0 0 25%;
    width: 25%;
    min-width: 25%;
    max-width: 25%;
    scroll-snap-align: start;
    box-sizing: border-box;
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #000000;
    border: none !important;
    margin: 0 !important;
    padding: 0 !important;
    background-color: #ffffff;
    cursor: pointer;
  }

  .liujo-tab-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #f7f7f7;
  }

  .liujo-tab-card-media a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .liujo-tab-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.45s ease;
  }

  .liujo-tab-card-media .img-secondary {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .liujo-tab-card:hover .img-primary.has-secondary {
    opacity: 0;
  }

  .liujo-tab-card:hover .img-secondary {
    opacity: 1;
    transform: scale(1.02);
  }

  .liujo-tab-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    font-family: inherit;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #000000;
    background: transparent;
    z-index: 3;
    pointer-events: none;
  }

  .liujo-tab-wishlist {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.85);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    transition: background-color 0.2s ease, transform 0.2s ease;
    color: #000000;
  }

  .liujo-tab-wishlist:hover {
    background-color: #ffffff;
    transform: scale(1.08);
  }

  .liujo-tab-wishlist.is-active svg {
    fill: #000000;
    stroke: #000000;
  }

  .liujo-tab-wishlist svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  .liujo-tab-info {
    display: flex;
    flex-direction: column;
    padding: 12px 6px 18px 0;
  }

  .liujo-tab-title {
    font-family: inherit;
    font-size: 11px;
    font-weight: 400;
    color: #000000;
    text-decoration: none;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.02em;
    display: block;
  }

  .liujo-tab-title:hover {
    text-decoration: underline;
  }

  .liujo-tab-price {
    font-family: inherit;
    font-size: 11px;
    font-weight: 500;
    color: #000000;
    margin-top: 3px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .liujo-tab-price-compare {
    color: #888888;
    text-decoration: line-through;
    font-weight: 400;
    font-size: 10px;
  }

  .liujo-tabs-arrow {
    display: none !important;
  }

  .liujo-tab-empty-msg {
    text-align: center;
    padding: 60px 15px;
    color: #888888;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .liujo-tab-card {
      flex: 0 0 33.333%;
      width: 33.333%;
      min-width: 33.333%;
      max-width: 33.333%;
    }
    .liujo-tabs-container {
      padding: 0 24px;
    }
  }

  @media (max-width: 767px) {
    .liujo-tab-card {
      flex: 0 0 50%;
      width: 50%;
      min-width: 50%;
      max-width: 50%;
    }
    .liujo-tabs-container {
      padding: 0 16px;
    }
    .liujo-tabs-nav-wrapper {
      margin-bottom: 24px;
    }
    .liujo-tabs-nav {
      gap: 24px;
    }
    .liujo-tab-button {
      font-size: 11px;
      letter-spacing: 0.08em;
      padding: 10px 4px 12px 4px;
    }
  }
</style>

<div class="liujo-tabs-section liujo-tabs-section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="liujo-tabs-container">
    <!-- Tabs Navigation Header (Image 3 Parity) -->
    <div class="liujo-tabs-nav-wrapper">
      <div class="liujo-tabs-nav" role="tablist">
        <button
          type="button"
          class="liujo-tab-button is-active"
          role="tab"
          aria-selected="true"
          aria-controls="panel-recommendations-{{ section.id }}"
          id="tab-btn-recommendations-{{ section.id }}"
          data-target="panel-recommendations-{{ section.id }}"
        >
          {{ section.settings.tab_1_title | default: 'YOU MIGHT LIKE' }}
        </button>

        <button
          type="button"
          class="liujo-tab-button"
          role="tab"
          aria-selected="false"
          aria-controls="panel-recently-viewed-{{ section.id }}"
          id="tab-btn-recently-viewed-{{ section.id }}"
          data-target="panel-recently-viewed-{{ section.id }}"
        >
          {{ section.settings.tab_2_title | default: 'RECENTLY VIEWED' }}
        </button>
      </div>
    </div>

    <!-- Tab 1: YOU MIGHT LIKE (Recommendations Slider) -->
    <div
      id="panel-recommendations-{{ section.id }}"
      class="liujo-tab-panel is-active"
      role="tabpanel"
      aria-labelledby="tab-btn-recommendations-{{ section.id }}"
    >
      <div class="liujo-tabs-slider-wrap">
        <ul class="liujo-tabs-track" data-tabs-track>
          {%- assign rec_products = recommendations.products -%}
          {%- assign curated_collection = collections[section.settings.collection] -%}
          {%- assign all_store_prods = collections.all.products -%}

          {%- assign shown_count = 0 -%}

          {%- if rec_products != blank and rec_products.size > 0 -%}
            {%- for prod in rec_products -%}
              {%- if prod.id != product.id -%}
                {%- assign shown_count = shown_count | plus: 1 -%}
                <li class="liujo-tab-card" data-product-url="{{ prod.url }}">
                  <div class="liujo-tab-card-media">
                    {%- if prod.tags contains 'THE GIGI HADID EDIT' or prod.tags contains 'gigi-hadid' -%}
                      <span class="liujo-tab-badge">THE GIGI HADID EDIT</span>
                    {%- endif -%}

                    {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                      <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="{{ prod.id }}" aria-label="Add to Wishlist">
                        <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      </button>
                    {%- endif -%}

                    <a href="{{ prod.url }}" class="liujo-tab-card-link">
                      {%- if prod.featured_media != blank -%}
                        <img src="{{ prod.featured_media | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-primary{% if prod.media.size > 1 %} has-secondary{% endif %}" loading="lazy">
                        {%- if prod.media.size > 1 -%}
                          <img src="{{ prod.media[1] | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-secondary" loading="lazy">
                        {%- endif -%}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'img-primary' }}
                      {%- endif -%}
                    </a>
                  </div>

                  <div class="liujo-tab-info">
                    <a href="{{ prod.url }}" class="liujo-tab-title">{{ prod.title }}</a>
                    {%- if section.settings.show_price -%}
                      <div class="liujo-tab-price">
                        <span>{{ prod.price | money }}</span>
                        {%- if prod.compare_at_price > prod.price -%}
                          <span class="liujo-tab-price-compare">{{ prod.compare_at_price | money }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </li>
                {%- if shown_count >= section.settings.products_to_show -%}{%- break -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- elsif curated_collection != blank and curated_collection.products_count > 0 -%}
            {%- for prod in curated_collection.products -%}
              {%- if prod.id != product.id -%}
                {%- assign shown_count = shown_count | plus: 1 -%}
                <li class="liujo-tab-card" data-product-url="{{ prod.url }}">
                  <div class="liujo-tab-card-media">
                    {%- if prod.tags contains 'THE GIGI HADID EDIT' or prod.tags contains 'gigi-hadid' -%}
                      <span class="liujo-tab-badge">THE GIGI HADID EDIT</span>
                    {%- endif -%}

                    {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                      <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="{{ prod.id }}" aria-label="Add to Wishlist">
                        <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      </button>
                    {%- endif -%}

                    <a href="{{ prod.url }}" class="liujo-tab-card-link">
                      {%- if prod.featured_media != blank -%}
                        <img src="{{ prod.featured_media | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-primary{% if prod.media.size > 1 %} has-secondary{% endif %}" loading="lazy">
                        {%- if prod.media.size > 1 -%}
                          <img src="{{ prod.media[1] | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-secondary" loading="lazy">
                        {%- endif -%}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'img-primary' }}
                      {%- endif -%}
                    </a>
                  </div>

                  <div class="liujo-tab-info">
                    <a href="{{ prod.url }}" class="liujo-tab-title">{{ prod.title }}</a>
                    {%- if section.settings.show_price -%}
                      <div class="liujo-tab-price">
                        <span>{{ prod.price | money }}</span>
                        {%- if prod.compare_at_price > prod.price -%}
                          <span class="liujo-tab-price-compare">{{ prod.compare_at_price | money }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </li>
                {%- if shown_count >= section.settings.products_to_show -%}{%- break -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- elsif all_store_prods != blank and all_store_prods.size > 0 -%}
            {%- for prod in all_store_prods -%}
              {%- if prod.id != product.id -%}
                {%- assign shown_count = shown_count | plus: 1 -%}
                <li class="liujo-tab-card" data-product-url="{{ prod.url }}">
                  <div class="liujo-tab-card-media">
                    {%- if prod.tags contains 'THE GIGI HADID EDIT' or prod.tags contains 'gigi-hadid' -%}
                      <span class="liujo-tab-badge">THE GIGI HADID EDIT</span>
                    {%- endif -%}

                    {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                      <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="{{ prod.id }}" aria-label="Add to Wishlist">
                        <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      </button>
                    {%- endif -%}

                    <a href="{{ prod.url }}" class="liujo-tab-card-link">
                      {%- if prod.featured_media != blank -%}
                        <img src="{{ prod.featured_media | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-primary{% if prod.media.size > 1 %} has-secondary{% endif %}" loading="lazy">
                        {%- if prod.media.size > 1 -%}
                          <img src="{{ prod.media[1] | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-secondary" loading="lazy">
                        {%- endif -%}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'img-primary' }}
                      {%- endif -%}
                    </a>
                  </div>

                  <div class="liujo-tab-info">
                    <a href="{{ prod.url }}" class="liujo-tab-title">{{ prod.title }}</a>
                    {%- if section.settings.show_price -%}
                      <div class="liujo-tab-price">
                        <span>{{ prod.price | money }}</span>
                        {%- if prod.compare_at_price > prod.price -%}
                          <span class="liujo-tab-price-compare">{{ prod.compare_at_price | money }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </li>
                {%- if shown_count >= section.settings.products_to_show -%}{%- break -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if shown_count == 0 -%}
            <!-- Fallback Liu Jo High-Fashion Cards if store has no products yet -->
            {%- assign fallback_url = '/collections/all' -%}
            <li class="liujo-tab-card" data-product-url="{{ fallback_url }}">
              <div class="liujo-tab-card-media">
                <a href="{{ fallback_url }}" class="liujo-tab-card-link">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw4143de39/images/E-WF6309T743A02069-3-N.jpeg?sw=594&sh=826" alt="Flare trousers in flannel" class="img-primary has-secondary" loading="lazy">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw1fd02bed/images/E-WF6309T743A02069-4-N.jpeg?sw=594&sh=826" alt="Flare trousers in flannel" class="img-secondary" loading="lazy">
                </a>
              </div>
              <div class="liujo-tab-info">
                <a href="{{ fallback_url }}" class="liujo-tab-title">Flare trousers in flannel</a>
              </div>
            </li>

            <li class="liujo-tab-card" data-product-url="{{ fallback_url }}">
              <div class="liujo-tab-card-media">
                <span class="liujo-tab-badge">THE GIGI HADID EDIT</span>
                <a href="{{ fallback_url }}" class="liujo-tab-card-link">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw38804d25/images/E-ZB7305D041679212-3-N.jpeg?sw=594&sh=826" alt="Flare jeans with belt jewel" class="img-primary has-secondary" loading="lazy">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw7e7b58ae/images/E-ZB7305D041679212-4-N.jpeg?sw=594&sh=826" alt="Flare jeans with belt jewel" class="img-secondary" loading="lazy">
                </a>
              </div>
              <div class="liujo-tab-info">
                <a href="{{ fallback_url }}" class="liujo-tab-title">Flare jeans with belt jewel</a>
              </div>
            </li>

            <li class="liujo-tab-card" data-product-url="{{ fallback_url }}">
              <div class="liujo-tab-card-media">
                <a href="{{ fallback_url }}" class="liujo-tab-card-link">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dwb6498c1f/images/E-TF6252JS923L9265-4-N.jpeg?sw=594&sh=826" alt="T-shirt with print" class="img-primary has-secondary" loading="lazy">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dwb6498c1f/images/E-TF6252JS923L9265-3-N.jpeg?sw=594&sh=826" alt="T-shirt with print" class="img-secondary" loading="lazy">
                </a>
              </div>
              <div class="liujo-tab-info">
                <a href="{{ fallback_url }}" class="liujo-tab-title">T-shirt with print</a>
              </div>
            </li>

            <li class="liujo-tab-card" data-product-url="{{ fallback_url }}">
              <div class="liujo-tab-card-media">
                <a href="{{ fallback_url }}" class="liujo-tab-card-link">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw283c7518/images/E-WF6294T716AL9168-1-N.jpeg?sw=855&sh=1189" alt="Mini skirt in tweed" class="img-primary has-secondary" loading="lazy">
                  <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dwbe55b9d2/images/E-WF6294T716AL9168-2-N.jpeg?sw=855&sh=1189" alt="Mini skirt in tweed" class="img-secondary" loading="lazy">
                </a>
              </div>
              <div class="liujo-tab-info">
                <a href="{{ fallback_url }}" class="liujo-tab-title">Mini skirt in tweed</a>
              </div>
            </li>
          {%- endif -%}
        </ul>
      </div>
    </div>

    <!-- Tab 2: RECENTLY VIEWED (Dynamically populated horizontal slider) -->
    <div
      id="panel-recently-viewed-{{ section.id }}"
      class="liujo-tab-panel"
      role="tabpanel"
      aria-labelledby="tab-btn-recently-viewed-{{ section.id }}"
    >
      <div class="liujo-tabs-slider-wrap">
        <ul class="liujo-tabs-track" data-tabs-track id="liujo-recently-viewed-grid-{{ section.id }}">
          <!-- Populated via JavaScript -->
        </ul>
      </div>

      <div id="liujo-recently-viewed-empty-{{ section.id }}" class="liujo-tab-empty-msg" style="display: none;">
        {{ section.settings.empty_text | default: 'No recently viewed items yet' }}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const sectionId = {{ section.id | json }};
    const currentProductId = {{ product.id | default: 0 | json }};
    const section = document.querySelector(`.liujo-tabs-section-${sectionId}`);
    if (!section) return;

    const recTabBtn = document.getElementById(`tab-btn-recommendations-${sectionId}`);
    const rvwTabBtn = document.getElementById(`tab-btn-recently-viewed-${sectionId}`);
    const rvwPanel = document.getElementById(`panel-recently-viewed-${sectionId}`);
    const recPanel = document.getElementById(`panel-recommendations-${sectionId}`);
    const fallbackRecs = {{ fallback_rec_json }};

    // 1. Check existing recently viewed items in localStorage
    let viewed = [];
    try {
      viewed = JSON.parse(localStorage.getItem('liujo_recently_viewed') || '[]');
    } catch (e) {
      viewed = [];
    }

    const otherViewed = viewed.filter(p => String(p.id) !== String(currentProductId) && p.url);

    // Dynamic visibility: Hide "RECENTLY VIEWED" tab if user has NOT viewed other products yet
    if (otherViewed.length === 0) {
      if (rvwTabBtn) rvwTabBtn.style.display = 'none';
      if (rvwPanel) rvwPanel.style.display = 'none';
      if (recTabBtn) {
        recTabBtn.classList.add('is-active');
        recTabBtn.setAttribute('aria-selected', 'true');
      }
      if (recPanel) recPanel.classList.add('is-active');
    } else {
      if (rvwTabBtn) rvwTabBtn.style.display = '';
    }

    // 2. Record Current Product into localStorage for subsequent visits
    {%- if product != blank -%}
      try {
        const currentProdData = {
          id: {{ product.id | json }},
          title: {{ product.title | json }},
          url: {{ product.url | json }},
          image: {{ product.featured_media | image_url: width: 600 | json }},
          secondary_image: {% if product.media.size > 1 %}{{ product.media[1] | image_url: width: 600 | json }}{% else %}null{% endif %},
          price: {{ product.price | money | json }},
          compare_at_price: {% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},
          badge: {% if product.tags contains 'THE GIGI HADID EDIT' or product.tags contains 'gigi-hadid' %}"THE GIGI HADID EDIT"{% else %}null{% endif %}
        };

        if (currentProdData.id && currentProdData.url) {
          let updated = viewed.filter(p => String(p.id) !== String(currentProdData.id));
          updated.unshift(currentProdData);
          if (updated.length > 20) updated = updated.slice(0, 20);
          localStorage.setItem('liujo_recently_viewed', JSON.stringify(updated));
        }
      } catch (err) {
        console.warn('Could not save to recently viewed:', err);
      }
    {%- endif -%}

    // 3. Tab Toggle Logic
    const tabButtons = section.querySelectorAll('.liujo-tab-button');
    const tabPanels = section.querySelectorAll('.liujo-tab-panel');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        tabButtons.forEach(b => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach(p => p.classList.remove('is-active'));

        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        const activePanel = document.getElementById(targetId);
        if (activePanel) {
          activePanel.classList.add('is-active');
          initSliderInteractions(activePanel);
        }

        if (targetId === `panel-recently-viewed-${sectionId}`) {
          renderRecentlyViewed();
        }
      });
    });

    // 4. Render Recently Viewed Slider Track
    function renderRecentlyViewed() {
      const grid = document.getElementById(`liujo-recently-viewed-grid-${sectionId}`);
      const emptyMsg = document.getElementById(`liujo-recently-viewed-empty-${sectionId}`);
      const panel = document.getElementById(`panel-recently-viewed-${sectionId}`);
      if (!grid) return;

      try {
        let stored = JSON.parse(localStorage.getItem('liujo_recently_viewed') || '[]');
        let items = stored.filter(p => String(p.id) !== String(currentProductId) && p.url);

        // Pad with recommendations so the slider always has at least 8 items,
        // eliminating empty whitespace and ensuring swiping always works!
        if (items.length > 0 && Array.isArray(fallbackRecs)) {
          const existingIds = new Set(items.map(p => String(p.id)));
          existingIds.add(String(currentProductId));
          for (const rec of fallbackRecs) {
            if (!existingIds.has(String(rec.id))) {
              items.push(rec);
              existingIds.add(String(rec.id));
            }
            if (items.length >= 8) break;
          }
        }

        if (items.length === 0) {
          if (rvwTabBtn) rvwTabBtn.style.display = 'none';
          if (emptyMsg) emptyMsg.style.display = 'block';
          grid.innerHTML = '';
          return;
        }

        if (emptyMsg) emptyMsg.style.display = 'none';

        const showWishlist = {{ section.settings.show_wishlist | default: true | json }} && {{ settings.show_wishlist | default: true | json }};
        const showPrice = {{ section.settings.show_price | default: false | json }};
        const maxItems = {{ section.settings.products_to_show | default: 12 }};
        const itemsToDisplay = items.slice(0, Math.max(maxItems, 8));

        grid.innerHTML = itemsToDisplay.map(prod => `
          <li class="liujo-tab-card" data-product-url="${prod.url}">
            <div class="liujo-tab-card-media">
              ${prod.badge ? `<span class="liujo-tab-badge">${prod.badge}</span>` : ''}
              ${showWishlist ? `
              <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="${prod.id}" aria-label="Add to Wishlist">
                <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              </button>` : ''}
              <a href="${prod.url}" class="liujo-tab-card-link">
                <img src="${prod.image}" alt="${(prod.title || 'Product').replace(/"/g, '&quot;')}" class="img-primary ${prod.secondary_image ? 'has-secondary' : ''}" loading="lazy">
                ${prod.secondary_image ? `<img src="${prod.secondary_image}" alt="${(prod.title || 'Product').replace(/"/g, '&quot;')}" class="img-secondary" loading="lazy">` : ''}
              </a>
            </div>
            <div class="liujo-tab-info">
              <a href="${prod.url}" class="liujo-tab-title">${prod.title}</a>
              ${showPrice && prod.price ? `
                <div class="liujo-tab-price">
                  <span>${prod.price}</span>
                  ${prod.compare_at_price ? `<span class="liujo-tab-price-compare">${prod.compare_at_price}</span>` : ''}
                </div>` : ''}
            </div>
          </li>
        `).join('');

        if (window.syncLiuJoWishlistButtons) {
          window.syncLiuJoWishlistButtons();
        }

        if (panel) initSliderInteractions(panel);

      } catch (err) {
        console.error('Error rendering recently viewed:', err);
      }
    }

    // 5. Mouse Wheel Horizontal Scrolling, Mouse Drag Swipe & Touch Swipe
    function initSliderInteractions(container) {
      const track = container.querySelector('[data-tabs-track]');
      if (!track) return;

      // Prevent native HTML5 image dragging
      track.ondragstart = (e) => e.preventDefault();

      // Mouse Wheel Horizontal Scrolling
      track.onwheel = (e) => {
        if (Math.abs(e.deltaY) > 0 || Math.abs(e.deltaX) > 0) {
          e.preventDefault();
          const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
          track.scrollLeft += delta * 1.25;
        }
      };

      // Mouse Drag & Swipe
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;
      let hasDragged = false;

      track.onmousedown = (e) => {
        if (e.button !== 0) return;
        isDown = true;
        hasDragged = false;
        startX = e.pageX;
        scrollLeft = track.scrollLeft;
        track.classList.add('is-dragging');
        track.style.scrollSnapType = 'none';
        track.style.scrollBehavior = 'auto';
        e.preventDefault();
      };

      const onMouseMove = (e) => {
        if (!isDown) return;
        const diff = e.pageX - startX;
        if (Math.abs(diff) > 5) {
          hasDragged = true;
        }
        track.scrollLeft = scrollLeft - (diff * 1.5);
      };

      const onMouseUp = () => {
        if (!isDown) return;
        isDown = false;
        track.classList.remove('is-dragging');
        track.style.scrollSnapType = 'x proximity';
        setTimeout(() => {
          hasDragged = false;
        }, 100);
      };

      if (track._mouseMoveHandler) {
        window.removeEventListener('mousemove', track._mouseMoveHandler);
      }
      if (track._mouseUpHandler) {
        window.removeEventListener('mouseup', track._mouseUpHandler);
      }
      track._mouseMoveHandler = onMouseMove;
      track._mouseUpHandler = onMouseUp;
      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseup', onMouseUp);

      // Touch events for mobile swiping
      let touchStartX = 0;
      let touchDragged = false;

      track.ontouchstart = (e) => {
        if (e.touches.length !== 1) return;
        touchStartX = e.touches[0].pageX;
        touchDragged = false;
      };

      track.ontouchmove = (e) => {
        if (e.touches.length !== 1) return;
        const touchX = e.touches[0].pageX;
        if (Math.abs(touchX - touchStartX) > 8) {
          touchDragged = true;
        }
      };

      track.ontouchend = () => {
        setTimeout(() => {
          touchDragged = false;
        }, 100);
      };

      // Card click navigation
      track.onclick = (e) => {
        if (hasDragged || touchDragged) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }

        if (e.target.closest('[data-liujo-wishlist]')) {
          return;
        }

        const card = e.target.closest('.liujo-tab-card');
        if (card) {
          const directLink = e.target.closest('a');
          if (directLink && directLink.href) {
            return;
          }
          const link = card.querySelector('a.liujo-tab-card-link') || card.querySelector('a');
          if (link && link.href) {
            window.location.href = link.href;
          }
        }
      };
    }

    // Initialize all panels
    section.querySelectorAll('.liujo-tab-panel').forEach(panel => {
      initSliderInteractions(panel);
    });

  })();
</script>

{% schema %}
{
  "name": "Liu Jo Product Tabs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "default": true,
      "label": "Show Wishlist button"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": false,
      "label": "Show price under product title"
    },
    {
      "type": "text",
      "id": "tab_1_title",
      "label": "First Tab Title",
      "default": "YOU MIGHT LIKE"
    },
    {
      "type": "text",
      "id": "tab_2_title",
      "label": "Second Tab Title",
      "default": "RECENTLY VIEWED"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Number of products to show in slider"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Recently Viewed Empty State Text",
      "default": "No recently viewed items yet"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Liu Jo Product Tabs"
    }
  ]
}
{% endschema %}
