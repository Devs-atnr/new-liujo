      <button type="button" class="liujo-tabs-arrow liujo-tabs-arrow--next" data-tabs-next aria-label="Next">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>

  <!-- Tab 2: RECENTLY VIEWED (Dynamically populated horizontal slider) -->
  <div
    id="panel-recently-viewed-{{ section.id }}"
    class="liujo-tab-panel"
    role="tabpanel"
    aria-labelledby="tab-btn-recently-viewed-{{ section.id }}"
  >
    <div class="liujo-tabs-slider-wrap">
      <button type="button" class="liujo-tabs-arrow liujo-tabs-arrow--prev" data-tabs-prev aria-label="Previous">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <ul class="liujo-tabs-track" data-tabs-track id="liujo-recently-viewed-grid-{{ section.id }}">
        <!-- Populated via JavaScript -->
      </ul>

      <button type="button" class="liujo-tabs-arrow liujo-tabs-arrow--next" data-tabs-next aria-label="Next">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    <div id="liujo-recently-viewed-empty-{{ section.id }}" class="liujo-tab-empty-msg" style="display: none;">
      {{ section.settings.empty_text | default: 'No recently viewed items yet' }}
    </div>
  </div>
</div>

<script>
  (function() {
    const sectionId = {{ section.id | json }};
    const currentProductId = {{ product.id | default: 0 | json }};
    const section = document.querySelector(`.liujo-tabs-section-${sectionId}`);
    if (!section) return;

    // 1. Record Current Product to localStorage
    {%- if product != blank -%}
      try {
        const currentProdData = {
          id: {{ product.id | json }},
          title: {{ product.title | json }},
          url: {{ product.url | json }},
          image: {{ product.featured_media | image_url: width: 600 | json }},
          secondary_image: {% if product.media.size > 1 %}{{ product.media[1] | image_url: width: 600 | json }}{% else %}null{% endif %},
          price: {{ product.price | money | json }},
          compare_at_price: {% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},
          badge: {% if product.tags contains 'THE GIGI HADID EDIT' or product.tags contains 'gigi-hadid' %}"THE GIGI HADID EDIT"{% elsif product.compare_at_price > product.price %}"SALE"{% else %}null{% endif %}
        };

        if (currentProdData.id) {
          let viewed = JSON.parse(localStorage.getItem('liujo_recently_viewed') || '[]');
          viewed = viewed.filter(p => String(p.id) !== String(currentProdData.id));
          viewed.unshift(currentProdData);
          if (viewed.length > 20) viewed = viewed.slice(0, 20);
          localStorage.setItem('liujo_recently_viewed', JSON.stringify(viewed));
        }
      } catch (err) {
        console.warn('Could not save to recently viewed:', err);
      }
    {%- endif -%}

    // 2. Check and toggle RECENTLY VIEWED tab button visibility
    function checkRecentlyViewedTabVisibility() {
      const recentlyViewedBtn = document.getElementById(`tab-btn-recently-viewed-${sectionId}`);
      if (!recentlyViewedBtn) return;

      try {
        const viewed = JSON.parse(localStorage.getItem('liujo_recently_viewed') || '[]');
        const otherViewed = viewed.filter(p => String(p.id) !== String(currentProductId));

        if (otherViewed.length > 0) {
          // User has browsed other products previously -> Show RECENTLY VIEWED tab button
          recentlyViewedBtn.style.display = 'inline-block';
        } else {
          // First-time visit or only 1 product viewed -> Hide RECENTLY VIEWED tab button
          recentlyViewedBtn.style.display = 'none';

          // Ensure YOU MIGHT LIKE is active
          const recBtn = document.getElementById(`tab-btn-recommendations-${sectionId}`);
          if (recBtn && !recBtn.classList.contains('is-active')) {
            recBtn.click();
          }
        }
      } catch (e) {
        recentlyViewedBtn.style.display = 'none';
      }
    }

    checkRecentlyViewedTabVisibility();

    // 3. Tab Toggle Logic
    const tabButtons = section.querySelectorAll('.liujo-tab-button');
    const tabPanels = section.querySelectorAll('.liujo-tab-panel');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        tabButtons.forEach(b => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach(p => p.classList.remove('is-active'));

        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        const activePanel = document.getElementById(targetId);
        if (activePanel) {
          activePanel.classList.add('is-active');
          const track = activePanel.querySelector('[data-tabs-track]');
          if (track) initSliderDragAndArrows(activePanel);
        }

        if (targetId === `panel-recently-viewed-${sectionId}`) {
          renderRecentlyViewed();
        }
      });
    });

    // 4. Render Recently Viewed Slider Track
    function renderRecentlyViewed() {
      const grid = document.getElementById(`liujo-recently-viewed-grid-${sectionId}`);
      const emptyMsg = document.getElementById(`liujo-recently-viewed-empty-${sectionId}`);
      const panel = document.getElementById(`panel-recently-viewed-${sectionId}`);
      if (!grid) return;

      try {
        let viewed = JSON.parse(localStorage.getItem('liujo_recently_viewed') || '[]');
        let filtered = viewed.filter(p => String(p.id) !== String(currentProductId));

        if (filtered.length === 0) {
          if (viewed.length > 0) filtered = viewed;
        }

        if (filtered.length === 0) {
          grid.innerHTML = '';
          if (emptyMsg) emptyMsg.style.display = 'block';
          return;
        }

        if (emptyMsg) emptyMsg.style.display = 'none';

        const showWishlist = {{ section.settings.show_wishlist | default: true | json }} && {{ settings.show_wishlist | default: true | json }};
        const maxItems = {{ section.settings.products_to_show | default: 12 }};
        const itemsToDisplay = filtered.slice(0, maxItems);

        grid.innerHTML = itemsToDisplay.map(prod => `
          <li class="liujo-tab-card">
            <div class="liujo-tab-card-media">
              ${prod.badge ? `<span class="liujo-tab-badge">${prod.badge}</span>` : ''}
              ${showWishlist ? `
              <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="${prod.id}" data-product-title="${(prod.title || '').replace(/"/g, '&quot;')}" data-product-price="${prod.price || ''}" data-product-image="${prod.image || ''}" data-product-url="${prod.url || ''}" aria-label="Add to Wishlist">
                <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              </button>` : ''}
              <a href="${prod.url}">
                <img src="${prod.image}" alt="${(prod.title || 'Product').replace(/"/g, '&quot;')}" class="img-primary ${prod.secondary_image ? 'has-secondary' : ''}" loading="lazy">
                ${prod.secondary_image ? `<img src="${prod.secondary_image}" alt="${(prod.title || 'Product').replace(/"/g, '&quot;')}" class="img-secondary" loading="lazy">` : ''}
              </a>
            </div>
            <div class="liujo-tab-info">
              <a href="${prod.url}" class="liujo-tab-title">${prod.title}</a>
              <div class="liujo-tab-price">
                <span>${prod.price}</span>
                ${prod.compare_at_price ? `<span class="liujo-tab-price-compare">${prod.compare_at_price}</span>` : ''}
              </div>
            </div>
          </li>
        `).join('');

        if (window.syncLiuJoWishlistButtons) {
          window.syncLiuJoWishlistButtons();
        }

        if (panel) initSliderDragAndArrows(panel);

      } catch (err) {
        console.error('Error rendering recently viewed:', err);
      }
    }

    // 5. Drag-to-Scroll & Arrow Navigation
    function initSliderDragAndArrows(container) {
      const track = container.querySelector('[data-tabs-track]');
      const prevBtn = container.querySelector('[data-tabs-prev]');
      const nextBtn = container.querySelector('[data-tabs-next]');

      if (!track || track.dataset.sliderInitialized === 'true') return;
      track.dataset.sliderInitialized = 'true';

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          const cardWidth = track.firstElementChild ? track.firstElementChild.getBoundingClientRect().width : window.innerWidth * 0.25;
          track.scrollBy({ left: -cardWidth * 2, behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          const cardWidth = track.firstElementChild ? track.firstElementChild.getBoundingClientRect().width : window.innerWidth * 0.25;
          track.scrollBy({ left: cardWidth * 2, behavior: 'smooth' });
        });
      }

      // Drag to scroll
      let isDown = false;
      let startX;
      let scrollLeft;

      track.addEventListener('mousedown', (e) => {
        isDown = true;
        track.classList.add('is-dragging');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      track.addEventListener('mouseleave', () => {
        isDown = false;
        track.classList.remove('is-dragging');
      });

      track.addEventListener('mouseup', () => {
        isDown = false;
        track.classList.remove('is-dragging');
      });

      track.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.5;
        track.scrollLeft = scrollLeft - walk;
      });
    }

    // Initialize slider on active panel
    const initialPanel = section.querySelector('.liujo-tab-panel.is-active');
    if (initialPanel) initSliderDragAndArrows(initialPanel);

  })();
</script>

{% schema %}
{
  "name": "Liu Jo Product Tabs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "default": true,
      "label": "Show Wishlist button"
    },
    {
      "type": "text",
      "id": "tab_1_title",
      "label": "First Tab Title",
      "default": "YOU MIGHT LIKE"
    },
    {
      "type": "text",
      "id": "tab_2_title",
      "label": "Second Tab Title",
      "default": "RECENTLY VIEWED"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Number of products to show in slider"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Recently Viewed Empty State Text",
      "default": "No recently viewed items yet"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Liu Jo Product Tabs"
    }
  ]
}
{% endschema %}
