{% comment %}
  LIU JO PRODUCT TABS RECOMMENDATIONS SECTION
  - Full width edge-to-edge layout (Images 1, 2 & 3 Parity).
  - Centered luxury tabs: "YOU MIGHT LIKE" and "RECENTLY VIEWED".
    * First-time visitor: Only "YOU MIGHT LIKE" is shown.
    * Once products are browsed: "RECENTLY VIEWED" tab appears dynamically.
  - Seamless 0px gap between cards (4 full cards visible across desktop screen = 25vw each).
  - "mouse scrolling or scroll bar na ho":
    * NO scrollbars visible anywhere (scrollbar-width: none, -ms-overflow-style: none, ::-webkit-scrollbar: none).
    * Mouse wheel scrolls horizontally smoothly over the track.
    * Touch swipe & mouse drag-to-scroll supported.
    * Navigation arrows hidden to maintain 100% clean image parity.
  - Editorial card design: title bottom-left, no price line (matching screenshot).
{% endcomment %}

<style>
  .liujo-tabs-section-{{ section.id }} {
    width: 100vw;
    max-width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: #ffffff;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  .liujo-tabs-nav-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    border-bottom: 1px solid #ebebeb;
    margin-bottom: 0px;
    position: relative;
    width: 100%;
  }

  .liujo-tabs-nav {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
  }

  .liujo-tab-button {
    background: transparent;
    border: none;
    padding: 14px 10px 16px 10px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #888888;
    cursor: pointer;
    position: relative;
    transition: color 0.25s ease;
    outline: none;
  }

  .liujo-tab-button:hover {
    color: #000000;
  }

  .liujo-tab-button.is-active {
    color: #000000;
  }

  .liujo-tab-button.is-active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #000000;
  }

  .liujo-tab-panel {
    display: none;
    width: 100%;
    position: relative;
  }

  .liujo-tab-panel.is-active {
    display: block;
  }

  /* Full Width Horizontal Scroll Slider Track */
  .liujo-tabs-slider-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .liujo-tabs-track {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scroll-behavior: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
    cursor: grab;
    user-select: none;
    gap: 0 !important;
  }

  .liujo-tabs-track::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  .liujo-tabs-track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  /* Full Width Editorial Cards: 4 items visible across desktop screen = 25vw each */
  .liujo-tab-card {
    flex: 0 0 25vw;
    width: 25vw;
    min-width: 25vw;
    max-width: 25vw;
    scroll-snap-align: start;
    box-sizing: border-box;
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #000000;
    border: none !important;
    margin: 0 !important;
    padding: 0 !important;
    background-color: #ffffff;
  }

  .liujo-tab-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #f7f7f7;
  }

  .liujo-tab-card-media a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .liujo-tab-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.45s ease;
  }

  .liujo-tab-card-media .img-secondary {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }

  .liujo-tab-card:hover .img-primary.has-secondary {
    opacity: 0;
  }

  .liujo-tab-card:hover .img-secondary {
    opacity: 1;
    transform: scale(1.02);
  }

  .liujo-tab-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #000000;
    background: transparent;
    z-index: 3;
    pointer-events: none;
  }

  .liujo-tab-wishlist {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.85);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    transition: background-color 0.2s ease, transform 0.2s ease;
    color: #000000;
  }

  .liujo-tab-wishlist:hover {
    background-color: #ffffff;
    transform: scale(1.08);
  }

  .liujo-tab-wishlist.is-active svg {
    fill: #000000;
    stroke: #000000;
  }

  .liujo-tab-wishlist svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  .liujo-tab-info {
    display: flex;
    flex-direction: column;
    padding: 12px 14px 18px 14px;
  }

  .liujo-tab-title {
    font-size: 12px;
    font-weight: 400;
    color: #000000;
    text-decoration: none;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.02em;
  }

  .liujo-tab-title:hover {
    text-decoration: underline;
  }

  .liujo-tab-price {
    font-size: 12px;
    font-weight: 500;
    color: #000000;
    margin-top: 3px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .liujo-tab-price-compare {
    color: #888888;
    text-decoration: line-through;
    font-weight: 400;
    font-size: 11px;
  }

  /* Arrows hidden for clean parity with design */
  .liujo-tabs-arrow {
    display: none !important;
  }

  .liujo-tab-empty-msg {
    text-align: center;
    padding: 60px 15px;
    color: #888888;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 1024px) {
    .liujo-tab-card {
      flex: 0 0 33.333vw;
      width: 33.333vw;
      min-width: 33.333vw;
      max-width: 33.333vw;
    }
  }

  @media (max-width: 767px) {
    .liujo-tab-card {
      flex: 0 0 50vw;
      width: 50vw;
      min-width: 50vw;
      max-width: 50vw;
    }
    .liujo-tabs-nav {
      gap: 20px;
    }
    .liujo-tab-button {
      font-size: 11px;
      letter-spacing: 0.1em;
      padding: 10px 4px 12px 4px;
    }
  }
</style>

<div class="liujo-tabs-section liujo-tabs-section-{{ section.id }}" data-section-id="{{ section.id }}">
  <!-- Tabs Navigation Header -->
  <div class="liujo-tabs-nav-wrapper">
    <div class="liujo-tabs-nav" role="tablist">
      <button
        type="button"
        class="liujo-tab-button is-active"
        role="tab"
        aria-selected="true"
        aria-controls="panel-recommendations-{{ section.id }}"
        id="tab-btn-recommendations-{{ section.id }}"
        data-target="panel-recommendations-{{ section.id }}"
      >
        {{ section.settings.tab_1_title | default: 'YOU MIGHT LIKE' }}
      </button>

      <!-- RECENTLY VIEWED Tab: Hidden for first-time visitors, shown dynamically after browsing -->
      <button
        type="button"
        class="liujo-tab-button"
        role="tab"
        aria-selected="false"
        aria-controls="panel-recently-viewed-{{ section.id }}"
        id="tab-btn-recently-viewed-{{ section.id }}"
        data-target="panel-recently-viewed-{{ section.id }}"
        style="display: none;"
      >
        {{ section.settings.tab_2_title | default: 'RECENTLY VIEWED' }}
      </button>
    </div>
  </div>

  <!-- Tab 1: YOU MIGHT LIKE (Recommendations Slider) -->
  <div
    id="panel-recommendations-{{ section.id }}"
    class="liujo-tab-panel is-active"
    role="tabpanel"
    aria-labelledby="tab-btn-recommendations-{{ section.id }}"
  >
    <div class="liujo-tabs-slider-wrap">
      <ul class="liujo-tabs-track" data-tabs-track>
        {%- assign rec_products = recommendations.products -%}
        {%- assign curated_collection = collections[section.settings.collection] -%}

        {%- if rec_products != blank and rec_products.size > 0 -%}
          {%- for prod in rec_products limit: section.settings.products_to_show -%}
            <li class="liujo-tab-card">
              <div class="liujo-tab-card-media">
                {%- if prod.tags contains 'THE GIGI HADID EDIT' or prod.tags contains 'gigi-hadid' -%}
                  <span class="liujo-tab-badge">THE GIGI HADID EDIT</span>
                {%- endif -%}

                {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                  <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="{{ prod.id }}" aria-label="Add to Wishlist">
                    <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                  </button>
                {%- endif -%}

                <a href="{{ prod.url }}">
                  {%- if prod.featured_media != blank -%}
                    <img src="{{ prod.featured_media | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-primary{% if prod.media.size > 1 %} has-secondary{% endif %}" loading="lazy">
                    {%- if prod.media.size > 1 -%}
                      <img src="{{ prod.media[1] | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-secondary" loading="lazy">
                    {%- endif -%}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'img-primary' }}
                  {%- endif -%}
                </a>
              </div>

              <div class="liujo-tab-info">
                <a href="{{ prod.url }}" class="liujo-tab-title">{{ prod.title }}</a>
                {%- if section.settings.show_price -%}
                  <div class="liujo-tab-price">
                    <span>{{ prod.price | money }}</span>
                    {%- if prod.compare_at_price > prod.price -%}
                      <span class="liujo-tab-price-compare">{{ prod.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        {%- elsif curated_collection != blank and curated_collection.products_count > 0 -%}
          {%- for prod in curated_collection.products limit: section.settings.products_to_show -%}
            <li class="liujo-tab-card">
              <div class="liujo-tab-card-media">
                {%- if prod.tags contains 'THE GIGI HADID EDIT' or prod.tags contains 'gigi-hadid' -%}
                  <span class="liujo-tab-badge">THE GIGI HADID EDIT</span>
                {%- endif -%}

                {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                  <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="{{ prod.id }}" aria-label="Add to Wishlist">
                    <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                  </button>
                {%- endif -%}

                <a href="{{ prod.url }}">
                  {%- if prod.featured_media != blank -%}
                    <img src="{{ prod.featured_media | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-primary{% if prod.media.size > 1 %} has-secondary{% endif %}" loading="lazy">
                    {%- if prod.media.size > 1 -%}
                      <img src="{{ prod.media[1] | image_url: width: 600 }}" alt="{{ prod.title | escape }}" class="img-secondary" loading="lazy">
                    {%- endif -%}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'img-primary' }}
                  {%- endif -%}
                </a>
              </div>

              <div class="liujo-tab-info">
                <a href="{{ prod.url }}" class="liujo-tab-title">{{ prod.title }}</a>
                {%- if section.settings.show_price -%}
                  <div class="liujo-tab-price">
                    <span>{{ prod.price | money }}</span>
                    {%- if prod.compare_at_price > prod.price -%}
                      <span class="liujo-tab-price-compare">{{ prod.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        {%- else -%}
          <!-- Exact Liu Jo High-Fashion Fallback Cards (Image 3 Parity) -->

          <!-- 1. Flare trousers in flannel -->
          <li class="liujo-tab-card">
            <div class="liujo-tab-card-media">
              {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="fallback-flannel" aria-label="Add to Wishlist">
                  <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </button>
              {%- endif -%}
              <a href="#">
                <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw4143de39/images/E-WF6309T743A02069-3-N.jpeg?sw=594&sh=826" alt="Flare trousers in flannel" class="img-primary has-secondary" loading="lazy">
                <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw1fd02bed/images/E-WF6309T743A02069-4-N.jpeg?sw=594&sh=826" alt="Flare trousers in flannel" class="img-secondary" loading="lazy">
              </a>
            </div>
            <div class="liujo-tab-info">
              <a href="#" class="liujo-tab-title">Flare trousers in flannel</a>
              {%- if section.settings.show_price -%}
                <div class="liujo-tab-price"><span>€ 159.00</span></div>
              {%- endif -%}
            </div>
          </li>

          <!-- 2. Flare jeans with belt jewel (THE GIGI HADID EDIT) -->
          <li class="liujo-tab-card">
            <div class="liujo-tab-card-media">
              <span class="liujo-tab-badge">THE GIGI HADID EDIT</span>
              {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="fallback-gigi-flare" aria-label="Add to Wishlist">
                  <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </button>
              {%- endif -%}
              <a href="#">
                <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dwc6827050/images/E-UA4012D405778502-3-N.jpeg?sw=594&sh=826" alt="Flare jeans with belt jewel" class="img-primary has-secondary" loading="lazy">
                <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw8374d618/images/E-WA4585D461578502-3-N.jpeg?sw=594&sh=826" alt="Flare jeans with belt jewel" class="img-secondary" loading="lazy">
              </a>
            </div>
            <div class="liujo-tab-info">
              <a href="#" class="liujo-tab-title">Flare jeans with belt jewel</a>
              {%- if section.settings.show_price -%}
                <div class="liujo-tab-price"><span>€ 239.00</span></div>
              {%- endif -%}
            </div>
          </li>

          <!-- 3. T-shirt with print -->
          <li class="liujo-tab-card">
            <div class="liujo-tab-card-media">
              {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="fallback-tshirt" aria-label="Add to Wishlist">
                  <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </button>
              {%- endif -%}
              <a href="#">
                <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw15db2296/images/E-MF4051J653101111-3-N.jpeg?sw=594&sh=826" alt="T-shirt with print" class="img-primary has-secondary" loading="lazy">
                <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw90289ab7/images/E-TA4260T314471111-3-N.jpeg?sw=594&sh=826" alt="T-shirt with print" class="img-secondary" loading="lazy">
              </a>
            </div>
            <div class="liujo-tab-info">
              <a href="#" class="liujo-tab-title">T-shirt with print</a>
              {%- if section.settings.show_price -%}
                <div class="liujo-tab-price"><span>€ 99.00</span></div>
              {%- endif -%}
            </div>
          </li>

          <!-- 4. Mini skirt in tweed -->
          <li class="liujo-tab-card">
            <div class="liujo-tab-card-media">
              {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="fallback-tweed-skirt" aria-label="Add to Wishlist">
                  <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </button>
              {%- endif -%}
              <a href="#">
                <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw283c7518/images/E-WF6294T716AL9168-1-N.jpeg?sw=855&sh=1189" alt="Mini skirt in tweed" class="img-primary has-secondary" loading="lazy">
                <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dwbe55b9d2/images/E-WF6294T716AL9168-2-N.jpeg?sw=855&sh=1189" alt="Mini skirt in tweed" class="img-secondary" loading="lazy">
              </a>
            </div>
            <div class="liujo-tab-info">
              <a href="#" class="liujo-tab-title">Mini skirt in tweed</a>
              {%- if section.settings.show_price -%}
                <div class="liujo-tab-price"><span>€ 139.00</span></div>
              {%- endif -%}
            </div>
          </li>

          <!-- 5. Bouclé cropped jacket -->
          <li class="liujo-tab-card">
            <div class="liujo-tab-card-media">
              {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="fallback-boucle" aria-label="Add to Wishlist">
                  <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </button>
              {%- endif -%}
              <a href="#">
                <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw9e6fac8b/images/E-ZB7307D041679212-4-N.jpeg?sw=594&sh=826" alt="Bouclé cropped jacket" class="img-primary has-secondary" loading="lazy">
                <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Sites-liujo-master-catalog/default/dw2127c151/images/E-ZB7307D041679212-3-N.jpeg?sw=594&sh=826" alt="Bouclé cropped jacket" class="img-secondary" loading="lazy">
              </a>
            </div>
            <div class="liujo-tab-info">
              <a href="#" class="liujo-tab-title">Bouclé cropped jacket</a>
              {%- if section.settings.show_price -%}
                <div class="liujo-tab-price"><span>€ 289.00</span></div>
              {%- endif -%}
            </div>
          </li>

          <!-- 6. Double-breasted coat in wool -->
          <li class="liujo-tab-card">
            <div class="liujo-tab-card-media">
              {%- if section.settings.show_wishlist != false and settings.show_wishlist != false -%}
                <button type="button" class="liujo-tab-wishlist" data-liujo-wishlist data-product-id="fallback-coat" aria-label="Add to Wishlist">
                  <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </button>
