<script>
  (function() {
    // 1. Global Tab Switcher Function
    window.switchLiuJoTab = function(btn, targetId) {
      if (!btn || !targetId) return;
      var section = btn.closest('.liujo-tabs-section');
      if (!section) return;

      var buttons = section.querySelectorAll('.liujo-tab-button');
      for (var i = 0; i < buttons.length; i++) {
        buttons[i].classList.remove('is-active');
        buttons[i].setAttribute('aria-selected', 'false');
      }
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');

      var panels = section.querySelectorAll('.liujo-tab-panel');
      for (var j = 0; j < panels.length; j++) {
        panels[j].classList.remove('is-active');
        panels[j].style.setProperty('display', 'none', 'important');
      }

      var activePanel = document.getElementById(targetId);
      if (activePanel) {
        activePanel.classList.add('is-active');
        activePanel.style.setProperty('display', 'block', 'important');

        if (targetId.indexOf('recently-viewed') !== -1 && typeof window.updateRecentlyViewedGrid === 'function') {
          window.updateRecentlyViewedGrid(section);
        }
        if (typeof window.setupTabCarousel === 'function') {
          window.setupTabCarousel(activePanel);
        }
      }
    };

    // 2. Record Current Product into localStorage
    {%- if product != blank -%}
      try {
        var curProd = {
          id: {{ product.id | json }},
          title: {{ product.title | json }},
          url: {{ product.url | json }},
          image: {{ product.featured_media | image_url: width: 600 | json }},
          secondary_image: {% if product.media.size > 1 %}{{ product.media[1] | image_url: width: 600 | json }}{% else %}null{% endif %},
          price: {{ product.price | money | json }},
          compare_at_price: {% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %}
        };

        var stored = [];
        try {
          stored = JSON.parse(localStorage.getItem('liujo_recently_viewed') || '[]');
        } catch(e) {
          stored = [];
        }

        if (curProd.id && curProd.url) {
          var updated = stored.filter(function(p) { return p && String(p.id) !== String(curProd.id); });
          updated.unshift(curProd);
          if (updated.length > 20) updated = updated.slice(0, 20);
          localStorage.setItem('liujo_recently_viewed', JSON.stringify(updated));
        }
      } catch (err) {
        console.warn('Recently viewed storage error:', err);
      }
    {%- endif -%}

    // 3. Tab Visibility & Recently Viewed Grid Population
    var showPrice = {{ section.settings.show_price | json }};

    window.updateRecentlyViewedGrid = function(section) {
      if (!section) return;
      var currentProdId = section.getAttribute('data-product-id') || '';
      var rvPanel = section.querySelector('[id^="panel-recently-viewed-"]');
      var grid = section.querySelector('.liujo-recently-viewed-track');
      if (!grid) return;

      var viewed = [];
      try {
        viewed = JSON.parse(localStorage.getItem('liujo_recently_viewed') || '[]');
      } catch(e) {
        viewed = [];
      }
      if (!Array.isArray(viewed)) viewed = [];

      var validViewed = viewed.filter(function(p) {
        return p && p.url && p.image;
      });

      if (validViewed.length > 0) {
        var otherViewed = validViewed.filter(function(p) {
          return String(p.id) !== String(currentProdId);
        });
        var currentInViewed = validViewed.filter(function(p) {
          return String(p.id) === String(currentProdId);
        });
        var displayList = otherViewed.concat(currentInViewed);

        var cards = [];
        var viewedUrls = {};

        displayList.forEach(function(prod) {
          viewedUrls[prod.url] = true;
          var priceHtml = '';
          if (showPrice && prod.price) {
            priceHtml = '<div class="liujo-tab-price"><span>' + prod.price + '</span>' +
              (prod.compare_at_price ? '<span class="liujo-tab-price-compare">' + prod.compare_at_price + '</span>' : '') +
              '</div>';
          }
          cards.push(
            '<li class="liujo-tab-card" data-product-url="' + prod.url + '">' +
              '<div class="liujo-tab-card-media">' +
                '<a href="' + prod.url + '" class="liujo-tab-card-link" draggable="false">' +
                  '<img src="' + prod.image + '" alt="' + (prod.title || 'Product').replace(/"/g, '&quot;') + '" class="img-primary ' + (prod.secondary_image ? 'has-secondary' : '') + '" loading="lazy" draggable="false">' +
                  (prod.secondary_image ? '<img src="' + prod.secondary_image + '" alt="' + (prod.title || 'Product').replace(/"/g, '&quot;') + '" class="img-secondary" loading="lazy" draggable="false">' : '') +
                '</a>' +
              '</div>' +
              '<div class="liujo-tab-info">' +
                '<a href="' + prod.url + '" class="liujo-tab-title" draggable="false">' + (prod.title || '') + '</a>' +
                priceHtml +
              '</div>' +
            '</li>'
          );
        });

        // Pad with Tab 1 items up to at least 8 cards so Recently Viewed always has overflow to slide
        if (cards.length < 8) {
          var recCards = section.querySelectorAll('.liujo-recommendations-track .liujo-tab-card');
          if (recCards && recCards.length > 0) {
            for (var i = 0; i < recCards.length && cards.length < 8; i++) {
              var recUrl = recCards[i].getAttribute('data-product-url');
              if (!recUrl || !viewedUrls[recUrl]) {
                cards.push(recCards[i].outerHTML);
              }
            }
            var padIdx = 0;
            while (cards.length < 8 && recCards.length > 0) {
              cards.push(recCards[padIdx % recCards.length].outerHTML);
              padIdx++;
            }
          }
        }

        grid.innerHTML = cards.join('');
      }

      if (rvPanel) {
        window.setupTabCarousel(rvPanel);
      }

      if (window.syncLiuJoWishlistButtons) {
        window.syncLiuJoWishlistButtons();
      }
    };

    window.updateTabVisibilityAndGrid = window.updateRecentlyViewedGrid;

    // 4. Carousel Interactions: Smooth Drag, Wheel Scroll, Touch Swipe & Arrows for Both Tracks
    window.setupTabCarousel = function(panel) {
      if (!panel) return;
      var track = panel.querySelector('[data-tabs-track]');
      if (!track) return;

      var prevBtn = panel.querySelector('[data-tabs-prev]');
      var nextBtn = panel.querySelector('[data-tabs-next]');

      function getStep() {
        var card = track.querySelector('.liujo-tab-card');
        var cardW = card ? card.getBoundingClientRect().width : 280;
        var count = window.innerWidth <= 767 ? 1 : 2;
        return cardW * count;
      }

      if (prevBtn && !prevBtn._hasBound) {
        prevBtn._hasBound = true;
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          track.scrollBy({ left: -getStep(), behavior: 'smooth' });
        });
      }

      if (nextBtn && !nextBtn._hasBound) {
        nextBtn._hasBound = true;
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          track.scrollBy({ left: getStep(), behavior: 'smooth' });
        });
      }

      // Block native browser ghost dragging on cards
      track.querySelectorAll('a, img').forEach(function(el) {
        el.setAttribute('draggable', 'false');
        el.ondragstart = function() { return false; };
      });

      if (track._hasLiuJoCarousel) return;
      track._hasLiuJoCarousel = true;

      track.addEventListener('dragstart', function(e) {
        e.preventDefault();
        return false;
      });

      // Mouse Wheel Horizontal Scroll
      track.addEventListener('wheel', function(e) {
        var delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        if (Math.abs(delta) > 0) {
          var canScrollRight = delta > 0 && (track.scrollLeft + track.clientWidth < track.scrollWidth - 2);
          var canScrollLeft = delta < 0 && track.scrollLeft > 2;
          if (canScrollRight || canScrollLeft) {
            e.preventDefault();
            track.scrollLeft += delta;
          }
        }
      }, { passive: false });

      // Smooth Mouse Drag to Scroll with Momentum
      var isDown = false;
      var startX = 0;
      var scrollLeftStart = 0;
      var velX = 0;
      var lastX = 0;
      var lastTime = 0;
      var hasMoved = false;
      var momentumId = null;
      var clickedLink = null;

      function stopMomentum() {
        if (momentumId) {
          cancelAnimationFrame(momentumId);
          momentumId = null;
        }
      }

      function applyMomentum() {
        if (Math.abs(velX) < 0.5) {
          momentumId = null;
          return;
        }
        track.scrollLeft += velX;
        velX *= 0.92;
        momentumId = requestAnimationFrame(applyMomentum);
      }

      track.addEventListener('mousedown', function(e) {
        if (e.button !== 0) return;
        if (e.target.closest('button, [data-liujo-wishlist]')) return;

        stopMomentum();
        isDown = true;
        hasMoved = false;
        startX = e.pageX;
        scrollLeftStart = track.scrollLeft;
        lastX = e.pageX;
        lastTime = Date.now();
        velX = 0;

        clickedLink = e.target.closest('a');

        track.classList.add('is-dragging');
        // Prevent default browser HTML5 ghost drag
        e.preventDefault();
      });

      window.addEventListener('mousemove', function(e) {
        if (!isDown) return;
        var diff = (e.pageX - startX) * 1.5;
        if (Math.abs(e.pageX - startX) > 4) {
          hasMoved = true;
        }
        track.scrollLeft = scrollLeftStart - diff;

        var now = Date.now();
        var dt = now - lastTime;
        if (dt > 0) {
          velX = (lastX - e.pageX) * (16 / dt);
        }
        lastX = e.pageX;
        lastTime = now;
      }, { passive: false });

      window.addEventListener('mouseup', function(e) {
        if (!isDown) return;
        isDown = false;
        track.classList.remove('is-dragging');

        if (hasMoved) {
          applyMomentum();
          setTimeout(function() {
            hasMoved = false;
          }, 150);
        } else {
          // If not moved, it was a normal click - navigate if link clicked
          if (clickedLink && clickedLink.href) {
            window.location.href = clickedLink.href;
          }
        }
        clickedLink = null;
      });

      // Capture phase click listener on track
      track.addEventListener('click', function(e) {
        if (hasMoved) {
          e.preventDefault();
          e.stopPropagation();
          return false;
        }
      }, true);
    };

    // 5. Initialize All Tab Sections
    function initAllSections() {
      var sections = document.querySelectorAll('.liujo-tabs-section');
      sections.forEach(function(sec) {
        if (typeof window.updateRecentlyViewedGrid === 'function') {
          window.updateRecentlyViewedGrid(sec);
        }
        sec.querySelectorAll('.liujo-tab-panel').forEach(function(panel) {
          window.setupTabCarousel(panel);
        });

        var tabButtons = sec.querySelectorAll('.liujo-tab-button');
        tabButtons.forEach(function(btn) {
          if (btn._hasClickBound) return;
          btn._hasClickBound = true;
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            var targetId = btn.getAttribute('data-target');
            if (targetId) {
              window.switchLiuJoTab(btn, targetId);
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAllSections);
    } else {
      initAllSections();
    }

    window.addEventListener('pageshow', initAllSections);
    window.addEventListener('storage', function(e) {
      if (e.key === 'liujo_recently_viewed') {
        initAllSections();
      }
    });
  })();
</script>

