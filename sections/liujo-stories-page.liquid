          }
        },
        {
          "type": "story",
          "settings": {
            "category": "Heritage",
            "title": "Italian Craftsmanship In Carpi",
            "summary": "From initial hand sketches to precision tailoring: discovering the timeless artistry behind Liu Jo outerwear.",
