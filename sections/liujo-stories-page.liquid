{% comment %}
  LIU JO STORIES & EDITORIAL LOOKBOOK PAGE SECTION
  Editorial magazine articles & campaign stories matching https://www.liujo.com/stories
{% endcomment %}

<div class="liujo-stories-page" data-section-id="{{ section.id }}" style="max-width: var(--liujo-container-max); margin: 0 auto; padding: 40px 24px 80px;">
  <div style="text-align: center; margin-bottom: 50px;">
    <span class="liujo-subtitle" style="letter-spacing: 0.18em; text-transform: uppercase; color: var(--liujo-accent-pink);">Editorial Hub</span>
    <h1 class="liujo-title-display" style="margin-top: 8px;">{{ section.settings.title | default: 'Liu Jo Stories' }}</h1>
    <p class="liujo-subtitle" style="max-width: 600px; margin: 12px auto 0;">{{ section.settings.subtitle | default: 'Campaigns, inspirations and contemporary perspectives from the Italian maison.' }}</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px;">
    {%- for block in section.blocks -%}
      <div class="liujo-story-card" style="display: flex; flex-direction: column;" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: '/collections/all' }}" style="position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #f0f0f0; margin-bottom: 20px; display: block;">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;" loading="lazy">
          {%- elsif block.settings.demo_image_url != blank -%}
            <img src="{{ block.settings.demo_image_url }}" alt="{{ block.settings.title | escape }}" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </a>

        <div style="padding: 0 4px;">
          <span style="font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--liujo-mid-gray); margin-bottom: 8px; display: block;">{{ block.settings.category | default: 'Campaign' }}</span>
          <h2 style="font-size: 20px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 10px; line-height: 1.3;">
            <a href="{{ block.settings.link | default: '/collections/all' }}" style="color: var(--liujo-black); text-decoration: none;">
              {{ block.settings.title }}
            </a>
          </h2>
          <p style="font-size: 14px; color: #666; line-height: 1.6; margin-bottom: 16px;">{{ block.settings.summary }}</p>
          <a href="{{ block.settings.link | default: '/collections/all' }}" class="btn-link-editorial">Read Story</a>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .liujo-story-card:hover img {
    transform: scale(1.04);
  }
  @media (max-width: 767px) {
    .liujo-stories-page > div[style*="grid-template-columns"] {
      grid-template-columns: 1fr !important;
      gap: 30px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Liu Jo Stories Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Liu Jo Stories"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Campaigns, inspirations and contemporary perspectives from the Italian maison."
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Editorial Story",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category Label",
          "default": "Campaign 2026"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Story Title",
          "default": "The Gigi Hadid Edit"
        },
        {
          "type": "textarea",
          "id": "summary",
          "label": "Story Summary",
          "default": "An exclusive look into our newest campaign celebrating unapologetic confidence and sculpted silhouettes."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover Image"
        },
        {
          "type": "text",
          "id": "demo_image_url",
          "label": "External Image URL"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Liu Jo Stories Page",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "category": "Campaign 2026",
            "title": "The Gigi Hadid Edit",
