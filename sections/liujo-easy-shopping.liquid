{% comment %}
  LIU JO EASY SHOPPING SECTION
  Editorial page explaining the luxury services and effortless shopping perks at Liu Jo.
{% endcomment %}

<div class="liujo-easy-shopping" data-section-id="{{ section.id }}">
  <!-- Hero Section -->
  <div class="liujo-es-hero">
    <div class="liujo-es-hero__inner">
      <span class="liujo-es-hero__tag">LIU JO FOR YOU</span>
      <h1 class="liujo-es-hero__title">Easy Shopping</h1>
      <p class="liujo-es-hero__sub">Experience effortless luxury shopping with dedicated boutique services, priority delivery, and complimentary returns.</p>
    </div>
  </div>

  <div class="liujo-es-container">
    <!-- Grid of Key Shopping Perks -->
    <div class="liujo-es-grid">
      <div class="liujo-es-card">
        <div class="card-icon">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
        </div>
        <h3 class="card-title">FAST &amp; COMPLIMENTARY SHIPPING</h3>
        <p class="card-desc">Enjoy complimentary standard shipping on all orders over €150. Orders placed before 2:00 PM CET are handed over to express couriers the same day.</p>
        <a href="/pages/orders-and-shipments" class="card-link">VIEW DELIVERY GUIDE &rarr;</a>
      </div>

      <div class="liujo-es-card">
        <div class="card-icon">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
        </div>
        <h3 class="card-title">30 DAYS COMPLIMENTARY RETURNS</h3>
        <p class="card-desc">Take your time trying your looks at home. Enjoy 30 calendar days to initiate easy returns or exchanges with our prepaid courier collection labels.</p>
        <a href="/pages/refunds-and-returns" class="card-link">RETURN POLICY &rarr;</a>
      </div>

      <div class="liujo-es-card">
        <div class="card-icon">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
        </div>
        <h3 class="card-title">SIGNATURE LUXURY PACKAGING</h3>
        <p class="card-desc">Every piece is wrapped in delicate tissue paper. Choose our luxury gift option to receive your garments in an exclusive black &amp; white Liu Jo gift box with a personalized note.</p>
        <a href="/pages/orders-and-shipments" class="card-link">GIFT SERVICES &rarr;</a>
      </div>

      <div class="liujo-es-card">
        <div class="card-icon">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
        </div>
        <h3 class="card-title">FLEXIBLE &amp; SECURE PAYMENTS</h3>
        <p class="card-desc">Shop with complete peace of mind. Pay securely via Visa, Mastercard, PayPal, Apple Pay, or split your purchase into 3 interest-free installments with Klarna.</p>
        <a href="/pages/payments" class="card-link">PAYMENT METHODS &rarr;</a>
      </div>

      <div class="liujo-es-card">
        <div class="card-icon">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        </div>
        <h3 class="card-title">BOUTIQUE CONCIERGE ASSISTANCE</h3>
        <p class="card-desc">Need sizing advice or look suggestions? Our multilingual customer care concierge is at your service Monday to Friday, 9:00 to 18:00 CET via phone or email.</p>
        <a href="/pages/contact" class="card-link">GET IN TOUCH &rarr;</a>
      </div>

      <div class="liujo-es-card">
        <div class="card-icon">
          <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        </div>
        <h3 class="card-title">THE NEW GLAM LOUNGE LOYALTY</h3>
        <p class="card-desc">Join our exclusive loyalty program to unlock private promotional previews, special birthday gifts, and dedicated invitations to boutique events.</p>
        <a href="/account/register" class="card-link">JOIN THE LOUNGE &rarr;</a>
      </div>
    </div>

    <!-- Editorial Call to Action Banner -->
    <div class="liujo-es-cta">
      <h2 class="cta-title">READY TO DISCOVER THE NEW COLLECTION?</h2>
      <p class="cta-sub">Explore the newest arrivals designed to elevate every moment of your wardrobe.</p>
      <div class="cta-actions">
        <a href="/collections/all" class="cta-btn cta-btn--primary">SHOP NEW ARRIVALS</a>
        <a href="/pages/stores" class="cta-btn cta-btn--outline">FIND A BOUTIQUE</a>
      </div>
    </div>
  </div>
</div>

<style>
  .liujo-easy-shopping {
    background: #fff;
    color: #111;
  }
  .liujo-es-hero {
    background: #000;
    color: #fff;
    padding: 80px 24px;
    text-align: center;
  }
  .liujo-es-hero__inner {
    max-width: 800px;
    margin: 0 auto;
  }
  .liujo-es-hero__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #bbb;
    display: block;
    margin-bottom: 14px;
  }
  .liujo-es-hero__title {
    font-size: 38px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 16px 0;
    color: #fff;
  }
  .liujo-es-hero__sub {
    font-size: 15px;
    color: #999;
    line-height: 1.7;
    margin: 0;
  }
  .liujo-es-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 70px 20px;
  }
  .liujo-es-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 80px;
  }
  .liujo-es-card {
    background: #fafafa;
    border: 1px solid #eaeaea;
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .liujo-es-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 28px rgba(0,0,0,0.06);
  }
  .card-icon {
    color: #000;
    margin-bottom: 24px;
  }
  .card-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 14px 0;
    line-height: 1.4;
  }
  .card-desc {
    font-size: 14px;
    line-height: 1.7;
    color: #666;
    margin-bottom: 24px;
    flex-grow: 1;
  }
  .card-link {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #000;
    text-decoration: none;
    border-bottom: 1px solid #000;
    display: inline-block;
    padding-bottom: 2px;
    align-self: flex-start;
    transition: opacity 0.2s;
  }
  .card-link:hover {
    opacity: 0.7;
  }
  .liujo-es-cta {
    background: #f7f7f7;
    border: 1px solid #e0e0e0;
    text-align: center;
    padding: 60px 20px;
  }
  .cta-title {
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 12px 0;
  }
  .cta-sub {
    font-size: 14px;
    color: #666;
    margin: 0 0 30px 0;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
  }
  .cta-btn {
    padding: 14px 28px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s;
  }
  .cta-btn--primary {
    background: #000;
    color: #fff;
    border: 1px solid #000;
  }
  .cta-btn--primary:hover {
    background: #333;
  }
  .cta-btn--outline {
    background: transparent;
    color: #000;
    border: 1px solid #000;
  }
  .cta-btn--outline:hover {
    background: #000;
    color: #fff;
  }
  @media screen and (max-width: 900px) {
    .liujo-es-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .cta-actions {
      flex-direction: column;
      max-width: 300px;
      margin: 0 auto;
    }
  }
</style>

{% schema %}
{
  "name": "Liu Jo Easy Shopping",
  "settings": [],
  "presets": [
    {
      "name": "Liu Jo Easy Shopping"
    }
  ]
}
{% endschema %}
