{% comment %} Full-width editorial story hero with configurable image and copy. {% endcomment %}
<section id="StoryHero-{{ section.id }}" class="story-hero" style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-height: {{ section.settings.desktop_height }}vh; --hero-fg: {{ section.settings.text_color }};">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'story-hero__image', loading: 'lazy', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: section.settings.image.alt | escape }}
  {% else %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'story-hero__image story-hero__placeholder' }}
  {% endif %}
  <div class="story-hero__shade" aria-hidden="true"></div>
  <div class="story-hero__content">
    {% if section.settings.heading != blank %}<h1 class="story-hero__heading">{{ section.settings.heading | escape }}</h1>{% endif %}
    {% if section.settings.subheading != blank %}<h2 class="story-hero__subheading">{{ section.settings.subheading | escape }}</h2>{% endif %}
    {% if section.settings.description != blank %}<div class="story-hero__description">{{ section.settings.description }}</div>{% endif %}
  </div>
  {% if section.settings.show_scroll_cue %}
    <button class="story-hero__scroll" type="button" aria-label="Scroll to next section" data-story-hero-scroll><span aria-hidden="true">⌄</span></button>
  {% endif %}
</section>
<style>
  #StoryHero-{{ section.id }}{position:relative;display:grid;place-items:center;min-height:var(--hero-height);height:var(--hero-height);max-height:1000px;overflow:hidden;background:#343a38;color:var(--hero-fg)}
  #StoryHero-{{ section.id }} .story-hero__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ section.settings.image_position }};}
  #StoryHero-{{ section.id }} .story-hero__placeholder{fill:#777}
  #StoryHero-{{ section.id }} .story-hero__shade{position:absolute;inset:0;background:rgb(0 0 0 / var(--hero-overlay))}
  #StoryHero-{{ section.id }} .story-hero__content{position:relative;z-index:1;width:min(100% - 48px,1000px);padding:48px 0 64px;text-align:center;text-shadow:0 1px 8px rgb(0 0 0 / .15)}
  #StoryHero-{{ section.id }} .story-hero__heading{margin:0 0 25px;font-size:clamp(48px,6vw,76px);line-height:.95;font-weight:600;letter-spacing:-.045em;text-transform:uppercase}
  #StoryHero-{{ section.id }} .story-hero__subheading{margin:0 0 14px;font-size:14px;line-height:1.3;font-weight:700;text-transform:uppercase}
  #StoryHero-{{ section.id }} .story-hero__description{margin:0 auto;max-width:950px;font-size:15px;line-height:1.45}
  #StoryHero-{{ section.id }} .story-hero__scroll{position:absolute;z-index:2;bottom:20px;left:50%;display:grid;place-items:center;width:40px;height:40px;transform:translateX(-50%);border:0;border-radius:50%;background:#fff;color:#111;font-size:25px;line-height:1;cursor:pointer;transition:transform .2s}
  #StoryHero-{{ section.id }} .story-hero__scroll:hover{transform:translate(-50%,3px)}
  @media(max-width:749px){#StoryHero-{{ section.id }}{min-height:{{ section.settings.mobile_height }}vh;height:{{ section.settings.mobile_height }}vh}#StoryHero-{{ section.id }} .story-hero__content{width:calc(100% - 40px);padding:38px 0 60px}#StoryHero-{{ section.id }} .story-hero__heading{font-size:clamp(42px,13vw,62px);margin-bottom:20px}#StoryHero-{{ section.id }} .story-hero__subheading{font-size:12px;margin-bottom:12px}#StoryHero-{{ section.id }} .story-hero__description{font-size:14px;line-height:1.5}}
  @media(prefers-reduced-motion:reduce){#StoryHero-{{ section.id }} .story-hero__scroll{transition:none}}
</style>
<script>
(()=>{const root=document.getElementById('StoryHero-{{ section.id }}');if(!root)return;const button=root.querySelector('[data-story-hero-scroll]');if(!button)return;button.addEventListener('click',()=>{const next=root.nextElementSibling;if(next)next.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'})})})();
</script>
{% schema %}
{
  "name":"Stories hero",
  "tag":"section",
  "class":"section-stories-hero",
  "settings":[
    {"type":"image_picker","id":"image","label":"Background image"},
    {"type":"select","id":"image_position","label":"Image focus","default":"center center","options":[{"value":"center center","label":"Center"},{"value":"center top","label":"Top"},{"value":"center bottom","label":"Bottom"},{"value":"left center","label":"Left"},{"value":"right center","label":"Right"}]},
    {"type":"text","id":"heading","label":"Main heading","default":"Stories"},
    {"type":"text","id":"subheading","label":"Small heading","default":"Liu Jo Summer Club"},
    {"type":"richtext","id":"description","label":"Description","default":"<p>Liu Jo Summer Club journeyed through Taormina, Cannes and Ibiza, transforming three iconic destinations into an experience to be lived and shared. Blending wellness, creativity, music and flavour, each event offered a new way to experience summer—where time slows down and every detail invites you to rediscover the beauty of life's most authentic moments.</p>"},
    {"type":"range","id":"desktop_height","label":"Desktop height","min":50,"max":100,"step":5,"unit":"vh","default":100},
    {"type":"range","id":"mobile_height","label":"Mobile height","min":55,"max":100,"step":5,"unit":"vh","default":90},
    {"type":"range","id":"overlay_opacity","label":"Dark overlay","min":0,"max":70,"step":5,"unit":"%","default":25},
    {"type":"color","id":"text_color","label":"Text color","default":"#ffffff"},
    {"type":"checkbox","id":"show_scroll_cue","label":"Show down arrow","default":true}
  ],
  "presets":[{"name":"Stories hero"}]
}
{% endschema %}
