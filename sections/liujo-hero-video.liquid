{% comment %}
  LIU JO HERO VIDEO SECTION
  Autoplay muted loop video with sound/pause toggle, editorial title & CTA button.
  Directly replicates Liu Jo's hero campaign banner ("The Gigi Hadid Edit").
  Fully dynamic with desktop/mobile poster pickers, mobile video option, font size sliders, and button colors.
{% endcomment %}

{%- assign s_id = section.id -%}
<div class="liujo-hero-video liujo-hero-video--{{ s_id }}" data-section-id="{{ s_id }}" data-section-type="liujo-hero-video" data-liujo-video-container>
  <style>
    .liujo-hero-video--{{ s_id }} .liujo-hero-video__wrapper {
      height: {{ section.settings.height_desktop | default: '85vh' }};
      min-height: {{ section.settings.min_height_desktop | default: 520 }}px;
      max-height: {{ section.settings.max_height_desktop | default: 960 }}px;
    }
    @media (max-width: 767px) {
      .liujo-hero-video--{{ s_id }} .liujo-hero-video__wrapper {
        height: {{ section.settings.height_mobile | default: '75vh' }};
        min-height: {{ section.settings.min_height_mobile | default: 440 }}px;
      }
    }
    .liujo-hero-video--{{ s_id }} .liujo-hero-video__overlay {
      background-color: {{ section.settings.overlay_color | default: '#000000' }};
      opacity: {{ section.settings.overlay_opacity | default: 25 | divided_by: 100.0 }};
    }
    .liujo-hero-video--{{ s_id }} .liujo-hero-video__content-wrap {
      justify-content: {{ section.settings.content_alignment | default: 'center' }};
      align-items: {{ section.settings.content_position | default: 'flex-end' }};
      text-align: {{ section.settings.content_text_align | default: 'center' }};
    }
    .liujo-hero-video--{{ s_id }} .liujo-hero-video__tagline {
      font-size: {{ section.settings.tagline_size_desktop | default: 13 }}px;
      color: {{ section.settings.tagline_color | default: '#ffffff' }};
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 12px;
      font-weight: {{ section.settings.tagline_weight_desktop | default: 600 }};
    }
    .liujo-hero-video--{{ s_id }} .liujo-hero-video__title {
      font-size: {{ section.settings.heading_size_desktop | default: 52 }}px;
      color: {{ section.settings.heading_color | default: '#ffffff' }};
      line-height: 1.15;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 22px;
      font-weight: {{ section.settings.heading_weight_desktop | default: 600 }};
    }
    @media (max-width: 767px) {
      .liujo-hero-video--{{ s_id }} .liujo-hero-video__content-wrap {
        justify-content: {{ section.settings.content_alignment_mobile | default: section.settings.content_alignment | default: 'center' }};
        align-items: {{ section.settings.content_position_mobile | default: section.settings.content_position | default: 'flex-end' }};
        text-align: {{ section.settings.content_text_align_mobile | default: section.settings.content_text_align | default: 'center' }};
      }
      .liujo-hero-video--{{ s_id }} .liujo-hero-video__tagline {
        font-size: {{ section.settings.tagline_size_mobile | default: 11 }}px;
        font-weight: {{ section.settings.tagline_weight_mobile | default: section.settings.tagline_weight_desktop | default: 600 }};
        color: {{ section.settings.mob_tagline_color | default: '#888888' }} !important;
      }
      .liujo-hero-video--{{ s_id }} .liujo-hero-video__title {
        font-size: {{ section.settings.mob_heading_size | default: 22 }}px;
        font-weight: {{ section.settings.heading_weight_mobile | default: section.settings.heading_weight_desktop | default: 600 }};
        color: {{ section.settings.mob_heading_color | default: '#000000' }} !important;
      }
      .liujo-hero-video--{{ s_id }} .liujo-hero-video__content-wrap {
        background: {{ section.settings.mob_content_bg | default: '#ffffff' }};
        padding: {{ section.settings.mob_content_padding_top | default: 28 }}px 20px {{ section.settings.mob_content_padding_bottom | default: 24 }}px !important;
      }
      .liujo-hero-video--{{ s_id }} .liujo-hero-video__btn {
        color: {{ section.settings.mob_button_color | default: '#000000' }} !important;
        font-size: {{ section.settings.mob_button_font_size | default: 11 }}px !important;
        {% if section.settings.mob_button_style == 'underline' %}
          border: none !important;
          background-color: transparent !important;
          padding: 0 !important;
          text-decoration: underline;
          text-underline-offset: 3px;
        {% elsif section.settings.mob_button_style == 'filled' %}
          background-color: {{ section.settings.mob_button_bg | default: '#000000' }} !important;
          border: 1px solid {{ section.settings.mob_button_bg | default: '#000000' }} !important;
          padding: 12px 32px;
        {% else %}
          background-color: transparent !important;
          border: 1px solid {{ section.settings.mob_button_border_color | default: '#000000' }} !important;
          padding: 12px 32px;
        {% endif %}
      }
    }
    .liujo-hero-video--{{ s_id }} .liujo-hero-video__btn {
      font-size: {{ section.settings.button_font_size | default: 11 }}px;
      color: {{ section.settings.button_text_color | default: '#ffffff' }} !important;
      background-color: {{ section.settings.button_bg_color | default: 'transparent' }} !important;
      border: 1px solid {{ section.settings.button_border_color | default: '#ffffff' }} !important;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 38px;
      font-weight: {{ section.settings.button_weight_desktop | default: 800 }};
      letter-spacing: 0.22em;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    @media (max-width: 767px) {
      .liujo-hero-video--{{ s_id }} .liujo-hero-video__btn {
        font-weight: {{ section.settings.button_weight_mobile | default: section.settings.button_weight_desktop | default: 800 }} !important;
      }
    }
    .liujo-hero-video--{{ s_id }} .liujo-hero-video__btn:hover {
      color: {{ section.settings.button_hover_text_color | default: '#000000' }} !important;
      background-color: {{ section.settings.button_hover_bg_color | default: '#ffffff' }} !important;
      border-color: {{ section.settings.button_hover_bg_color | default: '#ffffff' }} !important;
    }
  </style>

  <div class="liujo-hero-video__wrapper">
    <!-- Video Area (contains video + controls, positioned container on mobile) -->
    <div class="liujo-hero-video__video-area">
    <!-- Desktop Video -->
    {%- assign has_mobile_video = false -%}
    {%- if section.settings.video_url_mobile != blank -%}
      {%- assign has_mobile_video = true -%}
    {%- endif -%}

    {%- if section.settings.video_url != blank -%}
      <video class="liujo-hero-video__media{% if has_mobile_video %} liujo-hero-video__media--desktop{% endif %}"
             autoplay loop muted playsinline
             poster="{% if section.settings.poster_image != blank %}{{ section.settings.poster_image | image_url: width: 2000 }}{% else %}https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw0e286574/the-gigi-hadid-edit/drop1/HP/Hero-2-desk.jpg{% endif %}">
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- else -%}
      <video class="liujo-hero-video__media{% if has_mobile_video %} liujo-hero-video__media--desktop{% endif %}"
             autoplay loop muted playsinline
             poster="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw0e286574/the-gigi-hadid-edit/drop1/HP/Hero-2-desk.jpg">
        <source src="https://media.liujo.com/PUBLIC/VIDEO/Liu_Jo_camp_15s_16х9.mp4" type="video/mp4">
      </video>
    {%- endif -%}

    <!-- Dedicated Mobile Video (9:16 vertical) -->
    {%- if has_mobile_video -%}
      <video class="liujo-hero-video__media liujo-hero-video__media--mobile"
             autoplay loop muted playsinline
             poster="{% if section.settings.poster_image_mobile != blank %}{{ section.settings.poster_image_mobile | image_url: width: 1000 }}{% elsif section.settings.poster_image != blank %}{{ section.settings.poster_image | image_url: width: 1000 }}{% else %}https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dwc9a97ec1/the-gigi-hadid-edit/drop1/HP/Hero-2-mob.jpg{% endif %}">
        <source src="{{ section.settings.video_url_mobile }}" type="video/mp4">
      </video>
    {%- endif -%}

    <!-- Video Play/Pause & Audio Controls -->
    {%- if section.settings.show_controls -%}
      <div class="liujo-hero-video__controls">
        <button type="button" class="liujo-video-btn" data-video-play-btn aria-label="Play or Pause Video">
          <svg class="icon-play" viewBox="0 0 24 24" style="display:none;"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
          <svg class="icon-pause" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
        </button>

        <button type="button" class="liujo-video-btn" data-video-mute-btn aria-label="Toggle Audio">
          <svg class="icon-mute" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
          <svg class="icon-sound" viewBox="0 0 24 24" style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
        </button>
      </div>
    {%- endif -%}
    </div><!-- /.liujo-hero-video__video-area -->

    <!-- Color Overlay Layer -->
    <div class="liujo-hero-video__overlay"></div>

    <!-- Content Layer -->
    <div class="liujo-hero-video__content-wrap" style="position: absolute; inset: 0; display: flex; padding: 0 24px 80px; z-index: 2;">
      <div class="liujo-hero-video__content" style="max-width: 800px; width: 100%;">
        {%- if section.settings.tagline != blank -%}
          <div class="liujo-hero-video__tagline">
            {{ section.settings.tagline }}
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="liujo-hero-video__title">
            {{ section.settings.heading }}
          </h1>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div style="margin-top: 10px;" class="liujo-hero-video__btn-wrap{% if section.settings.hide_button_mobile %} liujo-hide-mobile{% endif %}">
            <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="liujo-hero-video__btn">
              <span>{{ section.settings.button_label }}</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
