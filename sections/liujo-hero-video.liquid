{% comment %}
  LIU JO HERO VIDEO SECTION
  Autoplay muted loop video with sound/pause toggle, editorial title & CTA button.
  Directly replicates Liu Jo's hero campaign banner ("The Gigi Hadid Edit").
{% endcomment %}

<div class="liujo-hero-video" data-section-id="{{ section.id }}" data-section-type="liujo-hero-video" data-liujo-video-container>
  <div class="liujo-hero-video__wrapper">
    {%- if section.settings.video_url != blank -%}
      <video class="liujo-hero-video__media"
             autoplay loop muted playsinline
             poster="{{ section.settings.poster_image | image_url: width: 1800 }}">
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- else -%}
      <!-- Liu Jo Official Campaign High Quality Video Source -->
      <video class="liujo-hero-video__media"
             autoplay loop muted playsinline
             poster="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw0e286574/the-gigi-hadid-edit/drop1/HP/Hero-2-desk.jpg">
        <source src="https://media.liujo.com/PUBLIC/VIDEO/Liu_Jo_camp_15s_16х9.mp4" type="video/mp4">
      </video>
    {%- endif -%}

    <!-- Video Play/Pause & Audio Mute/Unmute Controls -->
    <div class="liujo-hero-video__controls">
      <button type="button" class="liujo-video-btn" data-video-play-btn aria-label="Play or Pause Video">
        <svg class="icon-play" viewBox="0 0 24 24" style="display:none;"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
        <svg class="icon-pause" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
      </button>

      <button type="button" class="liujo-video-btn" data-video-mute-btn aria-label="Toggle Audio">
        <svg class="icon-mute" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
        <svg class="icon-sound" viewBox="0 0 24 24" style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
      </button>
    </div>

    <!-- Editorial Text & CTA Overlay -->
    <div class="liujo-hero-video__overlay" style="background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});">
      <div class="liujo-hero-video__content">
        {%- if section.settings.tagline != blank -%}
          <div class="liujo-subtitle" style="color: #fff; margin-bottom: 12px; letter-spacing: 0.15em; text-transform: uppercase;">
            {{ section.settings.tagline }}
          </div>
        {%- endif -%}

        <h1 class="liujo-hero-video__title">
          {{ section.settings.heading | default: 'The Gigi Hadid Edit' }}
        </h1>

        {%- if section.settings.button_label != blank -%}
          <div style="margin-top: 24px;">
            <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn-editorial-outline btn-editorial-outline--white">
              <span>{{ section.settings.button_label | default: 'Discover' }}</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Liu Jo Hero Video",
  "settings": [
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video MP4 URL",
      "info": "Upload MP4 video in Shopify Files and paste URL here, or leave blank for official Liu Jo campaign video.",
      "default": "https://media.liujo.com/PUBLIC/VIDEO/Liu_Jo_camp_15s_16х9.mp4"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster Image (Fallback)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Dark Overlay Opacity",
      "default": 25
    },
    {
      "type": "header",
      "content": "Content & Typography"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline / Subtitle",
      "default": "Campaign 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gigi Hadid Edit"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Discover"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Liu Jo Hero Video"
    }
  ]
}
{% endschema %}
