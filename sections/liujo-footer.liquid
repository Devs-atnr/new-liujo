      "label": "Column 1 Menu"
    },
    {
      "type": "header",
      "content": "Column 2: Liu Jo World"
    },
    {
      "type": "text",
      "id": "col_2_title",
      "label": "Column 2 Title",
      "default": "Liu Jo World"
    },
    {
      "type": "link_list",
