      <!-- Center: Brand Logo with MILANO subtitle -->
      <div class="liujo-header__brand">
        <a href="{{ routes.root_url }}" class="liujo-logo">
          {%- if settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: section.settings.logo_width }}"
                 alt="{{ shop.name | escape }}"
                 class="liujo-logo-image"
                 style="width: {{ section.settings.logo_width | default: 130 }}px;">
          {%- else -%}
            <span class="liujo-logo__main">LIU<span class="liujo-logo__dot">•</span>JO</span>
            <span class="liujo-logo__sub">MILANO</span>
          {%- endif -%}
        </a>
      </div>

      <!-- Right: Action Items -->
      <div class="liujo-header__actions">
        {%- if section.settings.show_store_locator -%}
          <a href="{{ section.settings.store_locator_link | default: '/pages/stores' }}" class="liujo-header__store-link d-none d-lg-inline-block">
            {{ section.settings.store_locator_label | default: 'Locate Stores' }}
          </a>
          <span class="liujo-header__divider d-none d-lg-inline-block"></span>
        {%- endif -%}

        <!-- Search Icon -->
        <a href="{{ routes.search_url }}" class="liujo-action-btn" aria-label="Search">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>

        <!-- Wishlist Icon (Desktop) -->
        <a href="/pages/wishlist" class="liujo-action-btn d-none d-lg-flex" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="liujo-badge-count" data-wishlist-count style="display:none;">0</span>
        </a>

        <!-- Shopping Cart Icon (Desktop) -->
        <a href="{{ routes.cart_url }}" class="liujo-action-btn d-none d-lg-flex" id="cart-icon-bubble" aria-label="Cart">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          {%- if cart != empty and cart.item_count > 0 -%}
            <span class="liujo-badge-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>

        <!-- Mobile Hamburger Toggler (Right side of header, right beside search!) -->
        <button type="button" class="liujo-action-btn liujo-header__mob-toggler d-flex d-lg-none" data-liujo-drawer-open aria-label="Open Navigation Menu">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
