{% comment %}
  LIU JO LUXURY HEADER (Integrates seamlessly into Shopify OS 2.0 Header Group)
  Pixel-perfect Liu Jo Milano header matching liujo.com desktop and mobile navigation
  - Dynamic Desktop Header Height & Mobile Header Height
  - Dynamic edge-to-edge layout: Menu Left, Logo Center, Store Locator & Search Right
  - Hamburger ONLY on mobile/tablet (hidden on desktop)
  - Dynamic Shopify Menu (3-level navigation) + Liu Jo luxury fallback
  - Dynamic toggle options for Wishlist & Cart on desktop & mobile
  - Full-width Luxury Mega Menu
{% endcomment %}

<style>
  :root {
    --liujo-header-h-desk: {{ section.settings.header_height_desktop | default: 85 }}px;
    --liujo-header-h-mob: {{ section.settings.header_height_mobile | default: 60 }}px;
    --liujo-header-pad-x: {{ section.settings.header_padding_horizontal | default: 40 }}px;
  }
</style>

<div class="liujo-header-container" data-section-id="{{ section.id }}" data-section-type="liujo-header">
  {%- if section.settings.show_announcement -%}
    <div class="liujo-announcement-bar" style="background-color: {{ section.settings.announcement_bg | default: '#000000' }}; color: {{ section.settings.announcement_text | default: '#ffffff' }};">
      <div class="liujo-announcement-content">
        <div class="liujo-announcement-slide">
          <span>{{ section.settings.announcement_text_content | default: 'THIS IS JUST A PRESENTATION WEBSITE' }}</span>
          {%- if section.settings.announcement_link_label != blank and section.settings.announcement_link != blank -%}
            <a href="{{ section.settings.announcement_link }}" style="color: {{ section.settings.announcement_text | default: '#ffffff' }};"><u>{{ section.settings.announcement_link_label }}</u></a>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <header class="liujo-header-wrapper">
    <div class="liujo-header">
      <!-- Desktop Left: Root Navigation (Flush Left) -->
      <nav class="liujo-header__rootmenu" aria-label="Main Navigation">
        {%- assign nav_menu = linklists[section.settings.menu] -%}
        {%- if nav_menu != blank and nav_menu.links.size > 0 -%}
          {%- for link in nav_menu.links -%}
            {%- assign link_handle = link.title | downcase -%}
            <div class="liujo-header__nav-item" data-nav-category="{{ link.title | handleize }}">
              <a href="{{ link.url }}" class="liujo-header__nav-link{% if link.active %} is-active{% endif %}">
                {{ link.title | upcase }}
              </a>

              {%- if link.links.size > 0 -%}
                <div class="liujo-megamenu">
                  <div class="liujo-megamenu__container{% if link.links.size == 4 %} liujo-megamenu__container--4col{% else %} liujo-megamenu__container--5col{% endif %}">
                    {%- for child_link in link.links -%}
                      {%- assign is_outlet = false -%}
                      {%- assign child_title_down = child_link.title | downcase -%}
                      {%- if child_title_down contains 'outlet' -%}
                        {%- assign is_outlet = true -%}
                      {%- endif -%}
                      <div class="liujo-megamenu__col">
                        <a href="{{ child_link.url }}" class="liujo-megamenu__col-title{% if is_outlet %} is-outlet{% endif %}"{% if is_outlet %} style="color: {{ section.settings.outlet_color | default: '#e6006e' }};"{% endif %}>
                          {{ child_link.title | upcase }}
                        </a>
                        {%- if child_link.links.size > 0 -%}
                          <ul class="liujo-megamenu__list">
                            {%- for grandchild_link in child_link.links -%}
                              <li class="liujo-megamenu__list-item">
                                <a href="{{ grandchild_link.url }}" class="liujo-megamenu__link{% if is_outlet %} is-outlet{% endif %}"{% if is_outlet %} style="color: {{ section.settings.outlet_color | default: '#e6006e' }};"{% endif %}>
                                  {{ grandchild_link.title }}
                                  {%- if grandchild_link.title contains 'New' or grandchild_link.title contains 'NEW' or grandchild_link.title contains 'Gigi' -%}
                                    <sup class="liujo-megamenu__badge">NEW</sup>
                                  {%- endif -%}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              {%- elsif section.settings.use_liujo_default_fallback -%}
                {%- comment %} Fallback for top links that don't have child links in Shopify yet {% endcomment -%}
                {%- if link_handle contains 'kid' -%}
                  {%- render 'liujo-megamenu-kids', outlet_color: section.settings.outlet_color -%}
                {%- elsif link_handle contains 'men' and link_handle != 'women' -%}
                  {%- render 'liujo-megamenu-men', outlet_color: section.settings.outlet_color -%}
                {%- else -%}
                  {%- render 'liujo-megamenu-women', outlet_color: section.settings.outlet_color -%}
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Liu Jo Luxury 3-Tab Desktop Navigation (WOMEN / MEN / KIDS) -->
          <!-- 1. WOMEN -->
          <div class="liujo-header__nav-item" data-nav-category="women">
            <a href="/collections/all" class="liujo-header__nav-link">WOMEN</a>
            <div class="liujo-megamenu">
              <div class="liujo-megamenu__container liujo-megamenu__container--5col">
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">NEW ARRIVALS</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">The Gigi Hadid Edit <sup class="liujo-megamenu__badge">NEW</sup></a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Spring Summer 2026</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Iconic Denim</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">New In Shoes</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">CLOTHING</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Jackets & Blazers</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Dresses & Jumpsuits</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Shirts & Blouses</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Jumpers & Knitwear</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Trousers & Skirts</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">JEANS</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Bottom Up Denim</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Flare & Bootcut</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Straight & Wide Leg</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Skinny Jeans</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">BAGS & SHOES</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Crossbody Bags</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Tote & Shoulder Bags</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Ankle Boots</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Sneakers</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title is-outlet" style="color: {{ section.settings.outlet_color | default: '#e6006e' }};">OUTLET</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link is-outlet" style="color: {{ section.settings.outlet_color | default: '#e6006e' }};">Clothing</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link is-outlet" style="color: {{ section.settings.outlet_color | default: '#e6006e' }};">Bags</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link is-outlet" style="color: {{ section.settings.outlet_color | default: '#e6006e' }};">Shoes</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <!-- 2. MEN -->
          <div class="liujo-header__nav-item" data-nav-category="men">
            <a href="/collections/all" class="liujo-header__nav-link">MEN</a>
            <div class="liujo-megamenu">
              <div class="liujo-megamenu__container liujo-megamenu__container--5col">
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">NEW ARRIVALS</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Spring Summer 2026</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Liu Jo Uomo Icons</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">CLOTHING</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Jackets & Coats</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Shirts & Polos</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Trousers & Chinos</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Knitwear</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">JEANS</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Regular Fit</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Slim Fit</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Relaxed Fit</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">SHOES & ACCESSORIES</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Sneakers</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Belts & Wallets</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title is-outlet" style="color: {{ section.settings.outlet_color | default: '#e6006e' }};">OUTLET</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link is-outlet" style="color: {{ section.settings.outlet_color | default: '#e6006e' }};">Men's Sale</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <!-- 3. KIDS (Exact match to SS1) -->
          <div class="liujo-header__nav-item" data-nav-category="kids">
            <a href="/collections/all" class="liujo-header__nav-link">KIDS</a>
            <div class="liujo-megamenu">
              <div class="liujo-megamenu__container liujo-megamenu__container--4col">
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">BABY (0-12 MONTHS)</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Dresses & sets</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Bottom</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Outerwear</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Topwear</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Accessories</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">KIDS (18 MONTHS-7 YEARS)</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Outerwear</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Dresses & Jumpsuits</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Topwear</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Trousers & Skirts</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Jumpers & Sweatshirts</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Shoes</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title">GIRLS (8-16 YEARS)</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Outerwear</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Dresses & Jumpsuits</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Topwear</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Trousers & Skirts</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Jumpers & Sweatshirts</a></li>
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link">Shoes</a></li>
                  </ul>
                </div>
                <div class="liujo-megamenu__col">
                  <div class="liujo-megamenu__col-title is-outlet" style="color: {{ section.settings.outlet_color | default: '#e6006e' }};">OUTLET</div>
                  <ul class="liujo-megamenu__list">
                    <li class="liujo-megamenu__list-item"><a href="/collections/all" class="liujo-megamenu__link is-outlet" style="color: {{ section.settings.outlet_color | default: '#e6006e' }};">8-16 years</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      </nav>

      <!-- Center: Brand Logo with MILANO subtitle (Dead Center) -->
      <div class="liujo-header__brand">
        <a href="{{ routes.root_url }}" class="liujo-logo">
          {%- if settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: section.settings.logo_width }}"
                 alt="{{ shop.name | escape }}"
                 class="liujo-logo-image"
                 style="width: {{ section.settings.logo_width | default: 130 }}px;">
          {%- else -%}
            <span class="liujo-logo__main">LIU<span class="liujo-logo__dot">•</span>JO</span>
            <span class="liujo-logo__sub">MILANO</span>
          {%- endif -%}
        </a>
      </div>

      <!-- Right: Action Items (Flush Right) -->
      <div class="liujo-header__actions">
        {%- if section.settings.show_store_locator -%}
          <a href="{{ section.settings.store_locator_link | default: '/pages/stores' }}" class="liujo-header__store-link">
            {{ section.settings.store_locator_label | default: 'Locate Stores' }}
          </a>
          {%- if section.settings.show_search_desktop -%}
            <span class="liujo-header__divider"></span>
          {%- endif -%}
        {%- endif -%}

        <!-- Desktop Search Icon -->
        {%- if section.settings.show_search_desktop -%}
          <a href="{{ routes.search_url }}" class="liujo-action-btn liujo-action-btn--desk-only" aria-label="Search">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </a>
        {%- endif -%}

        <!-- Desktop Wishlist Icon -->
        {%- if section.settings.show_wishlist_desktop -%}
          <a href="/pages/wishlist" class="liujo-action-btn liujo-action-btn--desk-only" aria-label="Wishlist">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span class="liujo-badge-count" data-wishlist-count style="display:none;">0</span>
          </a>
        {%- endif -%}

        <!-- Desktop Customer Account Icon -->
        {%- if section.settings.show_account_desktop and shop.customer_accounts_enabled -%}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="liujo-action-btn liujo-action-btn--desk-only" aria-label="Account">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </a>
        {%- endif -%}

        <!-- Desktop Shopping Cart Icon -->
        {%- if section.settings.show_cart_desktop -%}
          <a href="{{ routes.cart_url }}" class="liujo-action-btn liujo-action-btn--desk-only" id="cart-icon-bubble-desktop" aria-label="Cart">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            {%- if cart != empty and cart.item_count > 0 -%}
              <span class="liujo-badge-count">{{ cart.item_count }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}

        <!-- Mobile Search Icon -->
        {%- if section.settings.show_search_mobile -%}
          <a href="{{ routes.search_url }}" class="liujo-action-btn liujo-action-btn--mob-only" aria-label="Search">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </a>
        {%- endif -%}

        <!-- Mobile Wishlist Icon -->
        {%- if section.settings.show_wishlist_mobile -%}
          <a href="/pages/wishlist" class="liujo-action-btn liujo-action-btn--mob-only" aria-label="Wishlist">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span class="liujo-badge-count" data-wishlist-count style="display:none;">0</span>
          </a>
        {%- endif -%}

        <!-- Mobile Customer Account Icon -->
        {%- if section.settings.show_account_mobile and shop.customer_accounts_enabled -%}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="liujo-action-btn liujo-action-btn--mob-only" aria-label="Account">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </a>
        {%- endif -%}

        <!-- Mobile Shopping Cart Icon -->
        {%- if section.settings.show_cart_mobile -%}
          <a href="{{ routes.cart_url }}" class="liujo-action-btn liujo-action-btn--mob-only" id="cart-icon-bubble-mobile" aria-label="Cart">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            {%- if cart != empty and cart.item_count > 0 -%}
              <span class="liujo-badge-count">{{ cart.item_count }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}

