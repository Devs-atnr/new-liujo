{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Announcement Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "announcement_text",
      "label": "Announcement Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "announcement_text_content",
      "label": "Announcement Text",
      "default": "THIS IS JUST A PRESENTATION WEBSITE"
    },
    {
      "type": "text",
      "id": "announcement_link_label",
      "label": "Announcement Link Label",
      "default": "Discover"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link URL"
    },
    {
      "type": "header",
      "content": "Brand Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "default": 130,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "header",
      "content": "Store Locator & Accent"
    },
    {
      "type": "checkbox",
      "id": "show_store_locator",
      "label": "Show Locate Stores",
      "default": true
    },
    {
      "type": "text",
      "id": "store_locator_label",
      "label": "Store Locator Label",
      "default": "Locate Stores"
    },
    {
      "type": "url",
      "id": "store_locator_link",
      "label": "Store Locator Link"
    },
    {
      "type": "color",
      "id": "outlet_color",
      "label": "Outlet Pink Accent",
      "default": "#e6006e"
    }
  ]
}
{% endschema %}
