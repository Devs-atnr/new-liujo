{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Announcement Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "announcement_text",
      "label": "Announcement Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "announcement_text_content",
      "label": "Announcement Text",
      "default": "THIS IS JUST A PRESENTATION WEBSITE"
    },
    {
      "type": "text",
      "id": "announcement_link_label",
      "label": "Announcement Link Label",
      "default": "Discover"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link URL"
    },
    {
      "type": "header",
      "content": "Header Dimensions & Layout"
    },
    {
      "type": "range",
      "id": "header_height_desktop",
      "min": 60,
      "max": 140,
      "step": 2,
      "default": 86,
      "unit": "px",
      "label": "Desktop Header Height"
    },
    {
      "type": "range",
      "id": "header_height_mobile",
      "min": 50,
      "max": 100,
      "step": 2,
      "default": 60,
      "unit": "px",
      "label": "Mobile Header Height"
    },
    {
      "type": "range",
      "id": "header_padding_horizontal",
      "min": 16,
      "max": 80,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "Desktop Edge Padding (Left/Right)"
    },
    {
      "type": "header",
      "content": "Navigation Menu (Dynamic)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu",
      "info": "3-Level Navigation: Level 1 = Tabs, Level 2 = Mega Menu Columns, Level 3 = Links."
    },
    {
      "type": "checkbox",
      "id": "use_liujo_default_fallback",
      "label": "Use Liu Jo Built-in Mega Menus as Fallback",
      "default": true,
      "info": "When enabled, automatically provides the official Liu Jo Milan Women, Men, and Kids menus if a tab has no sublinks in Shopify."
    },
    {
      "type": "color",
      "id": "outlet_color",
      "label": "Outlet Pink Accent",
      "default": "#e6006e"
    },
    {
      "type": "header",
      "content": "Brand Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 240,
      "step": 10,
      "default": 130,
      "unit": "px",
      "label": "Logo Width"
    },
    {
      "type": "header",
      "content": "Desktop Action Icons"
