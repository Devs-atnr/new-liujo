<!-- ==========================================================================
     MOBILE OFF-CANVAS DRAWER (Strictly Mobile & Tablet)
     ========================================================================== -->
<div class="liujo-mob-drawer-overlay" data-liujo-drawer-overlay></div>
<div class="liujo-mob-drawer" data-liujo-drawer>
  <!-- Drawer Header: Brand Logo + Close Button -->
  <div class="liujo-mob-drawer__header">
    <div class="liujo-logo">
      <span class="liujo-logo__main">LIU<span class="liujo-logo__dot">•</span>JO</span>
      <span class="liujo-logo__sub">MILANO</span>
    </div>
    <button type="button" class="liujo-mob-drawer__close" data-liujo-drawer-close aria-label="Close Navigation">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Dynamic / Fallback Mobile Navigation Tabs -->
  {%- if nav_menu != blank and nav_menu.links.size > 0 -%}
    <div class="liujo-mob-drawer__tabs">
      {%- for link in nav_menu.links -%}
        <button type="button" class="liujo-mob-tab-btn{% if forloop.first %} is-active{% endif %}" data-liujo-tab-btn data-target-tab="{{ link.title | handleize }}">{{ link.title | upcase }}</button>
      {%- endfor -%}
    </div>

    <div class="liujo-mob-drawer__body">
      {%- for link in nav_menu.links -%}
        <div class="liujo-mob-tab-panel{% if forloop.first %} is-active{% endif %}" data-liujo-tab-panel data-tab-id="{{ link.title | handleize }}"{% unless forloop.first %} style="display:none;"{% endunless %}>
          {%- if link.links.size > 0 -%}
            <ul class="liujo-mob-nav-list">
              {%- for child_link in link.links -%}
                {%- assign is_outlet = false -%}
                {%- assign child_title_down = child_link.title | downcase -%}
                {%- if child_title_down contains 'outlet' -%}
                  {%- assign is_outlet = true -%}
                {%- endif -%}
                <li class="liujo-mob-nav-item{% if is_outlet %} is-outlet{% endif %}{% if child_link.links.size > 0 %} has-sub{% endif %}">
                  {%- if child_link.links.size > 0 -%}
                    <button type="button" class="liujo-mob-nav-trigger{% if is_outlet %} is-outlet{% endif %}" data-accordion-trigger{% if is_outlet %} style="color: {{ section.settings.outlet_color | default: '#e6006e' }};"{% endif %}>
                      <span{% if is_outlet %} style="color: {{ section.settings.outlet_color | default: '#e6006e' }};"{% endif %}>{{ child_link.title | upcase }}</span>
                      <svg class="liujo-chevron{% if is_outlet %} is-outlet{% endif %}" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="{% if is_outlet %}{{ section.settings.outlet_color | default: '#e6006e' }}{% else %}currentColor{% endif %}" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>
                    <ul class="liujo-mob-sublist">
                      {%- for grandchild_link in child_link.links -%}
                        <li>
                          <a href="{{ grandchild_link.url }}"{% if is_outlet %} class="is-outlet" style="color: {{ section.settings.outlet_color | default: '#e6006e' }};"{% endif %}>
                            {{ grandchild_link.title }}
                            {%- if grandchild_link.title contains 'New' or grandchild_link.title contains 'NEW' or grandchild_link.title contains 'Gigi' -%}
                              <sup class="liujo-megamenu__badge">NEW</sup>
                            {%- endif -%}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- else -%}
                    <a href="{{ child_link.url }}" class="liujo-mob-nav-link{% if is_outlet %} is-outlet{% endif %}"{% if is_outlet %} style="color: {{ section.settings.outlet_color | default: '#e6006e' }};"{% endif %}>
                      <span{% if is_outlet %} style="color: {{ section.settings.outlet_color | default: '#e6006e' }};"{% endif %}>{{ child_link.title | upcase }}</span>
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            {%- comment %} Fallback for tabs without links in Shopify yet {% endcomment -%}
            {%- assign link_handle = link.title | downcase -%}
            {%- if link_handle contains 'kid' -%}
              {%- render 'liujo-mob-kids-panel', outlet_color: section.settings.outlet_color -%}
            {%- elsif link_handle contains 'men' and link_handle != 'women' -%}
