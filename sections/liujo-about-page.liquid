{% comment %}
  LIU JO ABOUT US / BRAND HERITAGE SECTION
  Editorial storytelling page highlighting Italian fashion, history and craftsmanship.
{% endcomment %}

<div class="liujo-about-page" data-section-id="{{ section.id }}">
  <!-- Editorial Hero -->
  <div class="liujo-about-hero" style="position: relative; height: 60vh; min-height: 420px; overflow: hidden; background-color: #000;">
    {%- if section.settings.hero_image != blank -%}
      <img src="{{ section.settings.hero_image | image_url: width: 2000 }}" alt="{{ section.settings.hero_title | escape }}" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.85;" loading="lazy">
    {%- else -%}
      <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw0e286574/the-gigi-hadid-edit/drop1/HP/Hero-2-desk.jpg" alt="Liu Jo World" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.85;" loading="lazy">
    {%- endif -%}

    <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-align: center; padding: 20px; background: rgba(0,0,0,0.3);">
      <div style="max-width: 800px; color: #fff;">
        <span class="liujo-subtitle" style="color: #fff; letter-spacing: 0.2em; text-transform: uppercase;">{{ section.settings.hero_tagline | default: 'Liu Jo World' }}</span>
        <h1 class="liujo-title-display" style="color: #fff; margin-top: 12px;">{{ section.settings.hero_title | default: 'About Liu Jo' }}</h1>
      </div>
    </div>
  </div>

  <!-- Narrative Blocks -->
  <div style="max-width: 1000px; margin: 80px auto; padding: 0 24px; text-align: center;">
    <h2 class="liujo-title-medium" style="margin-bottom: 24px;">{{ section.settings.intro_heading | default: 'Celebrating Modern Femininity & Italian Style' }}</h2>
    <div style="font-size: 16px; line-height: 1.9; color: #555; margin-bottom: 60px;">
      <p>{{ section.settings.intro_text | default: 'Established in 1995 in Carpi, Italy, Liu Jo was born from the creative vision of Marco and Vannis Marchi. Guided by an innate passion for tailoring and feminine elegance, the brand quickly established itself as a premier name in contemporary Italian fashion.' }}</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; margin-top: 60px; text-align: left;">
      <div style="border-top: 1px solid var(--liujo-border-gray); padding-top: 24px;">
        <span style="font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--liujo-mid-gray);">Origin</span>
        <h3 style="font-size: 18px; font-weight: 600; text-transform: uppercase; margin: 10px 0;">Carpi, Italy</h3>
        <p style="font-size: 13px; color: #666; line-height: 1.6;">Founded in the prestigious Italian knitwear and textile hub in Emilia-Romagna.</p>
      </div>

      <div style="border-top: 1px solid var(--liujo-border-gray); padding-top: 24px;">
        <span style="font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--liujo-mid-gray);">Innovation</span>
        <h3 style="font-size: 18px; font-weight: 600; text-transform: uppercase; margin: 10px 0;">Bottom Up Denim</h3>
        <p style="font-size: 13px; color: #666; line-height: 1.6;">Pioneered the iconic Bottom Up jean in 2008, reshaping women's denim with an engineered sculpting silhouette.</p>
      </div>

      <div style="border-top: 1px solid var(--liujo-border-gray); padding-top: 24px;">
        <span style="font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--liujo-mid-gray);">Commitment</span>
        <h3 style="font-size: 18px; font-weight: 600; text-transform: uppercase; margin: 10px 0;">Better Together</h3>
        <p style="font-size: 13px; color: #666; line-height: 1.6;">A proactive path toward conscious fashion, utilizing organic fibers and low-impact dyeing techniques.</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Liu Jo About Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "hero_tagline",
      "label": "Hero Tagline",
      "default": "Liu Jo World"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "About Liu Jo"
    },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "Intro Heading",
      "default": "Celebrating Modern Femininity & Italian Style"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro Text",
      "default": "Established in 1995 in Carpi, Italy, Liu Jo was born from the creative vision of Marco and Vannis Marchi. Guided by an innate passion for tailoring and feminine elegance, the brand quickly established itself as a premier name in contemporary Italian fashion."
    }
  ],
  "presets": [
    {
      "name": "Liu Jo About Page"
    }
  ]
}
{% endschema %}
