{% comment %}
  LIU JO INFO TABS
  liujo.com customer-care style sidebar with hover animation.
  Blocks:
    - Group heading   ("CAN WE HELP YOU?", "PRIVACY INFORMATION" …)
    - Tab             each tab has its own content box on the right, OR redirects to a link
                      (internal page or external URL) when "Link instead of content" is set
    - Contact row     phone / e-mail / any link with an icon
  Deep link: /pages/xyz#tab-<block-id> or ?tab=<tab handle> opens that tab.
{% endcomment %}

{%- liquid
  assign s_id = section.id

  # ---- Where to show: empty list = every page using this template
  assign show_here = true
  assign only_on = section.settings.only_on_pages | downcase | remove: ' ' | split: ','
  if only_on.size > 0
    assign show_here = false
    for h in only_on
      if h == page.handle or h == collection.handle or h == product.handle
        assign show_here = true
      endif
    endfor
  endif
  if request.design_mode
    assign show_here = true
  endif

  # ---- Which tab opens first: the tab whose handle matches this page, else the first content tab
  assign first_tab_id = ''
  assign page_tab_id = ''
  for block in section.blocks
    if block.type == 'tab' and block.settings.link == blank and block.settings.special_link == blank
      if first_tab_id == ''
        assign first_tab_id = block.id
      endif
      assign t_handle = block.settings.handle | default: block.settings.title | handleize
      if page and t_handle == page.handle and page_tab_id == ''
        assign page_tab_id = block.id
      endif
    endif
  endfor
  # A tab that LINKS to the page being viewed shows its own content box here (liujo.com: one page per tab)
  for block in section.blocks
    if block.type == 'tab' and block.settings.link != blank and block.settings.link == request.path and page_tab_id == ''
      assign page_tab_id = block.id
    endif
  endfor
  if page_tab_id != ''
    assign first_tab_id = page_tab_id
  endif
-%}

{%- if show_here -%}
{%- if section.settings.hide_page_section and page -%}
  <style>
    /* Hide the template's default page title/content section when this section is used */
    #MainContent > .shopify-section:has(> .page-width .main-page-title) { display: none !important; }
  </style>
{%- endif -%}

<div class="liujo-it liujo-it--{{ s_id }}{% if first_tab_id == '' %} liujo-it--no-panels{% endif %}" data-liujo-info-tabs>
  <style>
    .liujo-it--{{ s_id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      --it-accent: {{ section.settings.accent_color }};
      --it-accent-text: {{ section.settings.accent_text_color }};
    }
    @media (max-width: 989px) {
      .liujo-it--{{ s_id }} {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }
    }
  </style>

  <div class="liujo-it__container">
    <nav class="liujo-it__nav" aria-label="{{ section.settings.nav_label | escape }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <p class="liujo-it__heading{% if block.settings.style == 'dark' %} liujo-it__heading--dark{% endif %}" {{ block.shopify_attributes }}>
              {{ block.settings.title | escape }}
            </p>

          {%- when 'tab' -%}
            {%- liquid
              assign tab_handle = block.settings.handle | default: block.settings.title | handleize
              assign tab_href = block.settings.link
              case block.settings.special_link
                when 'login'
                  assign tab_href = routes.account_login_url
                when 'register'
                  assign tab_href = routes.account_register_url
                when 'account'
                  assign tab_href = routes.account_url
                when 'logout'
                  assign tab_href = routes.account_logout_url
              endcase
            -%}
            {%- if tab_href != blank -%}
              <a class="liujo-it__tab{% if block.settings.row_style == 'plain' %} liujo-it__tab--plain{% endif %}{% if block.settings.link != blank and block.settings.link == request.path %} is-active{% endif %}"
                 href="{{ tab_href }}"
                 {% if block.settings.new_window %}target="_blank" rel="noopener"{% endif %}
                 {{ block.shopify_attributes }}>
                <span class="liujo-it__tab-label">{{ block.settings.title | escape }}</span>
                {% render 'liujo-it-arrow', external: block.settings.new_window %}
              </a>
            {%- else -%}
              <button type="button"
                      class="liujo-it__tab{% if block.settings.row_style == 'plain' %} liujo-it__tab--plain{% endif %}{% if block.id == first_tab_id %} is-active{% endif %}"
                      id="tab-btn-{{ block.id }}"
                      role="tab"
                      aria-selected="{% if block.id == first_tab_id %}true{% else %}false{% endif %}"
                      aria-controls="tab-{{ block.id }}"
                      data-it-tab="{{ block.id }}"
                      data-it-handle="{{ tab_handle }}"
                      {{ block.shopify_attributes }}>
                <span class="liujo-it__tab-label">{{ block.settings.title | escape }}</span>
                {% render 'liujo-it-arrow' %}
              </button>
            {%- endif -%}

          {%- when 'contact' -%}
            {%- liquid
              assign c_href = block.settings.link
              if block.settings.icon == 'phone' and block.settings.value != blank
                assign c_href = 'tel:' | append: block.settings.value | remove: ' '
              elsif block.settings.icon == 'email' and block.settings.value != blank
                assign c_href = 'mailto:' | append: block.settings.value
              endif
            -%}
            <a class="liujo-it__contact" href="{{ c_href | default: '#' }}" {{ block.shopify_attributes }}>
              <span class="liujo-it__contact-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'phone' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
                  {%- when 'email' -%}
                    <svg width="20" height="16" viewBox="0 0 24 18" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="1" width="22" height="16"/><path d="M1 1l11 9 11-9"/></svg>
                  {%- when 'chat' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-6.4A8 8 0 1 1 21 12z"/></svg>
                  {%- else -%}
                    <svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M0 6h16M11 1l5 5-5 5"/></svg>
                {%- endcase -%}
              </span>
              <span class="liujo-it__contact-text{% if block.settings.icon == 'phone' %} liujo-it__contact-text--phone{% endif %}">
                {{ block.settings.label | default: block.settings.value | escape }}
                {%- if block.settings.note != blank -%}<small>{{ block.settings.note | escape }}</small>{%- endif -%}
              </span>
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </nav>

    <div class="liujo-it__panels">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' and block.settings.link == blank and block.settings.special_link == blank or block.type == 'tab' and block.settings.link != blank and block.settings.link == request.path -%}
          <div class="liujo-it__panel{% if block.id == first_tab_id %} is-active{% endif %}"
               id="tab-{{ block.id }}"
               role="tabpanel"
               aria-labelledby="tab-btn-{{ block.id }}"
               {% unless block.id == first_tab_id %}hidden{% endunless %}>
            {%- if block.settings.show_title -%}
              <header class="liujo-it__panel-banner"><h2 class="liujo-it__panel-title">{{ block.settings.title | escape }}</h2></header>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <div class="liujo-it__panel-image">{{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600' }}</div>
            {%- endif -%}
            {%- if block.settings.content != blank or block.settings.page != blank -%}
              <div class="liujo-it__panel-body rte">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
              </div>
            {%- endif -%}
            {%- if section.settings.show_page_content and page and block.settings.link != blank and block.settings.link == request.path and page.content != blank -%}
              <div class="liujo-it__panel-body liujo-it__page-content rte" data-it-auto-acc>{{ page.content }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="liujo-it__panel-btn" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label | escape }}</a>
            {%- endif -%}

            {%- comment -%} Accordion items / forms placed directly under this tab in the block list {%- endcomment -%}
            {%- assign owner_id = '' -%}
            {%- assign has_acc = false -%}
            {%- for child in section.blocks -%}
              {%- if child.type == 'tab' or child.type == 'heading' or child.type == 'contact' -%}
                {%- assign owner_id = child.id -%}
              {%- elsif owner_id == block.id -%}
                {%- case child.type -%}
                  {%- when 'accordion' -%}
                    {%- unless has_acc -%}<div class="liujo-it__acc">{%- assign has_acc = true -%}{%- endunless -%}
                    <details class="liujo-it__acc-item" {% if child.settings.open %}open{% endif %} {{ child.shopify_attributes }}>
                      <summary class="liujo-it__acc-summary">
                        <h3 class="liujo-it__acc-title">{{ child.settings.title | escape }}</h3>
                        <span class="liujo-it__acc-icon" aria-hidden="true"></span>
                      </summary>
                      <div class="liujo-it__acc-body rte"{% if child.settings.sub_questions %} data-it-sub-acc{% endif %}>{{ child.settings.content }}{{ child.settings.html }}</div>
                    </details>
                  {%- when 'size_guide' -%}
                    {%- if has_acc -%}</div>{%- assign has_acc = false -%}{%- endif -%}
                    <div class="liujo-it__acc liujo-it__sizeguide" {{ child.shopify_attributes }}>{% render 'liujo-size-guide-content' %}</div>
                  {%- when 'form' -%}
                    {%- if has_acc -%}</div>{%- assign has_acc = false -%}{%- endif -%}
                    <form class="liujo-it__form" action="{{ child.settings.action | default: routes.account_url }}" method="{{ child.settings.method }}" {% if child.settings.new_window %}target="_blank"{% endif %} {{ child.shopify_attributes }}>
                      {%- if child.settings.heading != blank -%}<h3 class="liujo-it__form-heading">{{ child.settings.heading | escape }}</h3>{%- endif -%}
                      {%- if child.settings.text != blank -%}<div class="liujo-it__form-text rte">{{ child.settings.text }}</div>{%- endif -%}
                      <div class="liujo-it__form-fields">
                        <label class="liujo-it__field">
                          <span>{{ child.settings.field_1_label | escape }}</span>
                          <input type="text" name="{{ child.settings.field_1_name | default: 'order_number' }}" required autocomplete="off">
                        </label>
                        <label class="liujo-it__field">
                          <span>{{ child.settings.field_2_label | escape }}</span>
                          <input type="email" name="{{ child.settings.field_2_name | default: 'email' }}" required autocomplete="email">
                        </label>
                      </div>
                      <button type="submit" class="liujo-it__form-submit">{{ child.settings.submit_label | escape }}</button>
                    </form>
                {%- endcase -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if has_acc -%}</div>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% stylesheet %}
  .liujo-it__container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 89px;
    display: grid;
    grid-template-columns: 547px minmax(0, 1fr);
    column-gap: 46px;
    align-items: start;
    box-sizing: border-box;
  }
  .liujo-it--no-panels .liujo-it__container { grid-template-columns: 547px; }

  /* Headings */
  .liujo-it__heading {
    margin: 0;
    padding: 58px 40px 37px;
    font-size: 14px;
    font-weight: 700;
    line-height: 19px;
    text-transform: uppercase;
    color: #000;
    border-bottom: 2px solid rgba(0, 0, 0, 0.125);
  }
  .liujo-it__nav > .liujo-it__heading:first-child { padding-top: 0; }
  .liujo-it__heading--dark {
    padding: 13px 20px 13px 40px;
    background: #4c4c4c;
    color: #fff;
    font-size: 15px;
    border-bottom: none;
  }
  .liujo-it__nav > .liujo-it__heading--dark:not(:first-child) { margin-top: 31px; }

  /* Tabs — the black fill sweeps in from the left on hover, arrow nudges right */
  .liujo-it__tab {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 52px;
    margin: 0 0 -1px;
    padding: 0 16px 0 40px;
    background: #fff;
    border: 1px solid #ebebeb;
    color: #000;
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    box-sizing: border-box;
    transition: color 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .liujo-it__tab::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--it-accent, #000);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .liujo-it__tab svg { flex: 0 0 auto; transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
  .liujo-it__tab:hover,
  .liujo-it__tab:focus-visible,
  .liujo-it__tab.is-active { color: var(--it-accent-text, #fff); }
  .liujo-it__tab:hover::before,
  .liujo-it__tab:focus-visible::before,
  .liujo-it__tab.is-active::before { transform: scaleX(1); }
  .liujo-it__tab:hover svg,
  .liujo-it__tab:focus-visible svg { transform: translateX(5px); }
  .liujo-it__tab:focus-visible { outline: 2px solid #000; outline-offset: 2px; }

  /* Plain rows (privacy list style): no box, 2px divider, no arrow */
  .liujo-it__tab--plain {
    height: 48px;
    margin: 0;
    border: none;
    border-bottom: 2px solid rgba(0, 0, 0, 0.125);
  }
  .liujo-it__tab--plain svg { opacity: 0; transform: translateX(-6px); transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
  .liujo-it__tab--plain:hover svg,
  .liujo-it__tab--plain:focus-visible svg,
  .liujo-it__tab--plain.is-active svg { opacity: 1; transform: translateX(0); }

  /* Contact rows */
  .liujo-it__contact {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 10px 13px 40px;
    border-bottom: 2px solid rgba(0, 0, 0, 0.125);
    color: #000;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    transition: background-color 0.25s ease, padding-left 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .liujo-it__contact:hover { background: #f7f7f7; padding-left: 46px; }
  .liujo-it__contact-icon { display: inline-flex; }
  .liujo-it__contact-text { display: flex; flex-direction: column; gap: 2px; }
  .liujo-it__contact-text small { font-size: 12px; font-weight: 400; text-transform: none; color: #4c4c4c; }
  .liujo-it__contact-text--phone { font-weight: 400; text-transform: none; }
  .liujo-it__contact:has(.liujo-it__contact-text--phone) { flex-direction: column; align-items: flex-start; gap: 4px; }

  /* Content boxes */
  .liujo-it__panel[hidden] { display: none; }
  .liujo-it__panel.is-active { animation: liujoItFade 0.35s ease; }
  @keyframes liujoItFade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .liujo-it__panel-banner { background: #f8f9fa; padding: 60px 20px; text-align: center; margin-bottom: 30px; }
  .liujo-it__panel-title { margin: 0; font-size: 24px; font-weight: 700; line-height: 1.1; text-transform: uppercase; color: #000; }
  .liujo-it__panel-image { margin-bottom: 24px; }
  .liujo-it__panel-image img { width: 100%; height: auto; display: block; }
  .liujo-it__panel-body { font-size: 14px; line-height: 1.6; color: #000; }
  .liujo-it__panel-body h2, .liujo-it__panel-body h3 { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin: 24px 0 10px; }
  .liujo-it__panel-body p { margin: 0 0 12px; }
  .liujo-it__panel-body a { color: #000; text-decoration: underline; }
  .liujo-it__panel-btn {
    display: inline-flex; align-items: center; justify-content: center;
    height: 44px; padding: 0 30px; margin-top: 12px;
    background: #000; color: #fff; text-decoration: none;
    font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
  }

  /* Accordion items inside a tab */
  .liujo-it__acc { margin-top: 30px; }
  .liujo-it__acc-item { border-top: 1px solid #e9e9e9; padding: 20px 0; }
  .liujo-it__acc-item:last-child { border-bottom: 1px solid #e9e9e9; }
  .liujo-it__acc-summary { list-style: none; display: flex; align-items: center; justify-content: space-between; cursor: pointer; }
  .liujo-it__acc-summary::-webkit-details-marker { display: none; }
  .liujo-it__acc-title { margin: 0; font-size: 14px; font-weight: 700; line-height: 24px; letter-spacing: 0.5px; text-transform: uppercase; color: #000; }
  .liujo-it__acc-icon { position: relative; width: 16px; height: 16px; flex: 0 0 16px; }
  .liujo-it__acc-icon::before, .liujo-it__acc-icon::after {
    content: ''; position: absolute; left: 0; top: 7px; width: 16px; height: 2px; background: #000;
    transition: transform 0.25s ease;
  }
  .liujo-it__acc-icon::after { transform: rotate(90deg); }
  .liujo-it__acc-item[open] .liujo-it__acc-icon::after { transform: rotate(0deg); }
  .liujo-it__acc-body { padding-top: 20px; font-size: 14px; line-height: 1.6; color: #000; }
  .liujo-it__acc-body p { margin: 0 0 12px; }

  /* Nested questions (FAQ) */
  .liujo-it__sub-item { border-bottom: 1px solid #f0f0f0; padding: 14px 0; }
  .liujo-it__sub-item:first-child { border-top: 1px solid #f0f0f0; }
  .liujo-it__sub-summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; font-size: 14px; font-weight: 500; color: #000; }
  .liujo-it__sub-summary::-webkit-details-marker { display: none; }
  .liujo-it__sub-summary .liujo-it__acc-icon { width: 12px; height: 12px; flex-basis: 12px; }
  .liujo-it__sub-summary .liujo-it__acc-icon::before, .liujo-it__sub-summary .liujo-it__acc-icon::after { width: 12px; height: 1.5px; top: 5px; }
  .liujo-it__sub-item[open] .liujo-it__acc-icon::after { transform: rotate(0deg); }
  .liujo-it__sub-body { padding-top: 10px; font-size: 13px; line-height: 1.6; color: #333; }

  /* Size tables */
  .liujo-it__sizeguide .liujo-it__acc-item .liujo-it__acc { margin-top: 10px; }
  .liujo-sg-table-wrap { overflow-x: auto; margin: 12px 0 18px; -webkit-overflow-scrolling: touch; }
  .liujo-sg-table { width: 100%; min-width: 420px; border-collapse: collapse; font-size: 13px; }
  .liujo-sg-table th, .liujo-sg-table td { border: 1px solid #e5e5e5; padding: 9px 10px; text-align: center; white-space: nowrap; }
  .liujo-sg-table th { background: #f8f9fa; font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: 0.3px; }
  .liujo-sg-table tbody tr:nth-child(even) td { background: #fcfcfc; }
  .liujo-sg-note { font-size: 13px; line-height: 1.6; margin: 0 0 6px; }
  .liujo-sg-note strong { text-transform: uppercase; font-size: 12px; }
  .liujo-sg-h { font-size: 13px; font-weight: 700; text-transform: uppercase; margin: 20px 0 6px; }

  /* Order lookup / return form inside a tab */
  .liujo-it__form { margin-top: 36px; }
  .liujo-it__form-heading { margin: 0 0 18px; font-size: 14px; font-weight: 700; text-transform: uppercase; color: #000; }
  .liujo-it__form-text { font-size: 12px; line-height: 1.5; color: #000; margin-bottom: 28px; }
  .liujo-it__form-text p { margin: 0; }
  .liujo-it__form-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; max-width: 1072px; }
  .liujo-it__field { display: flex; flex-direction: column; gap: 8px; }
  .liujo-it__field span { font-size: 11px; font-weight: 500; text-transform: uppercase; color: #000; }
  .liujo-it__field input {
    height: 50px; width: 100%; box-sizing: border-box; padding: 0 14px;
    border: 1px solid #ccc; border-radius: 0; background: #fff; font: inherit; font-size: 14px; color: #000;
    transition: border-color 0.2s ease;
  }
  .liujo-it__field input:focus { outline: none; border-color: #000; }
  .liujo-it__form-submit {
    margin-top: 30px; width: 220px; height: 52px; border: none; border-radius: 0; cursor: pointer;
    background: #000; color: #fff; font: inherit; font-size: 14px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;
    transition: background-color 0.2s ease;
  }
  .liujo-it__form-submit:hover { background: #333; }

  @media (max-width: 1200px) {
    .liujo-it__container { padding: 0 40px; grid-template-columns: 387px minmax(0, 1fr); }
    .liujo-it--no-panels .liujo-it__container { grid-template-columns: 387px; }
  }
  @media (max-width: 989px) {
    .liujo-it__container,
    .liujo-it--no-panels .liujo-it__container { grid-template-columns: minmax(0, 1fr); padding: 0 20px; row-gap: 32px; }
    .liujo-it__heading { padding: 36px 12px 20px; }
    .liujo-it__heading--dark { padding: 13px 12px; }
    .liujo-it__tab { padding-left: 12px; }
    .liujo-it__contact { padding-left: 12px; }
    .liujo-it__contact:hover { padding-left: 16px; }
    .liujo-it__panel-banner { padding: 44px 16px; }
    .liujo-it__panel-title { font-size: 20px; }
    .liujo-it__form-fields { grid-template-columns: minmax(0, 1fr); }
    .liujo-it__form-submit { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .liujo-it__tab, .liujo-it__tab::before, .liujo-it__tab svg, .liujo-it__contact { transition: none; }
    .liujo-it__panel.is-active { animation: none; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const ICON = '<span class="liujo-it__acc-icon" aria-hidden="true"></span>';
    // Page content from Shopify (ul > li.question > label + .answer, or headings) -> liujo accordions
    function autoAccordion(el) {
      if (el.dataset.itAccDone) return;
      el.dataset.itAccDone = '1';
      el.querySelectorAll('style').forEach((x) => x.remove());
      const qs = [...el.querySelectorAll('li.question')];
      const wrap = document.createElement('div');
      wrap.className = 'liujo-it__acc';
      if (qs.length) {
        qs.forEach((li) => {
          const label = li.querySelector('.question-label, label, h2, h3, h4, strong');
          const ans = li.querySelector('.answer') || li;
          const d = document.createElement('details');
          d.className = 'liujo-it__acc-item';
          const title = (label ? label.textContent : '').replace(/\s+/g, ' ').trim();
          d.innerHTML = '<summary class="liujo-it__acc-summary"><h3 class="liujo-it__acc-title"></h3>' + ICON + '</summary><div class="liujo-it__acc-body rte"></div>';
          d.querySelector('h3').textContent = title;
          if (label && ans === li) label.remove();
          d.querySelector('.liujo-it__acc-body').append(...ans.childNodes);
          wrap.appendChild(d);
        });
        const first = qs[0].closest('ul');
        first.parentNode.insertBefore(wrap, first);
        [...new Set(qs.map((q) => q.closest('ul')))].forEach((u) => u.remove());
        return;
      }
      // Fallback: h2/h3/h4 headings become accordion titles
      const heads = [...el.querySelectorAll(':scope > h2, :scope > h3, :scope > h4')];
      if (!heads.length) return;
      heads.forEach((h) => {
        const d = document.createElement('details');
        d.className = 'liujo-it__acc-item';
        d.innerHTML = '<summary class="liujo-it__acc-summary"><h3 class="liujo-it__acc-title"></h3>' + ICON + '</summary><div class="liujo-it__acc-body rte"></div>';
        d.querySelector('h3').textContent = h.textContent.trim();
        const body = d.querySelector('.liujo-it__acc-body');
        let n = h.nextSibling;
        while (n && !(n.nodeType === 1 && /^H[234]$/.test(n.tagName))) { const next = n.nextSibling; body.appendChild(n); n = next; }
        wrap.appendChild(d);
        h.replaceWith(d);
      });
      const firstD = el.querySelector(':scope > details');
      if (firstD) { firstD.before(wrap); el.querySelectorAll(':scope > details').forEach((d) => wrap.appendChild(d)); }
    }
    // Inside an accordion: a paragraph that is only bold text starts a nested question
    function subAccordion(el) {
      if (el.dataset.itSubDone) return;
      el.dataset.itSubDone = '1';
      const isQ = (n) => n.nodeType === 1 && n.tagName === 'P' && n.children.length === 1 && /^(STRONG|B)$/.test(n.firstElementChild.tagName) && n.textContent.trim() === n.firstElementChild.textContent.trim();
      const kids = [...el.childNodes];
      if (!kids.some(isQ)) return;
      const out = document.createDocumentFragment();
      let cur = null;
      kids.forEach((n) => {
        if (isQ(n)) {
          cur = document.createElement('details');
          cur.className = 'liujo-it__sub-item';
          cur.innerHTML = '<summary class="liujo-it__sub-summary"><span></span>' + ICON + '</summary><div class="liujo-it__sub-body"></div>';
          cur.querySelector('span').textContent = n.textContent.trim();
          out.appendChild(cur);
        } else if (cur) cur.querySelector('.liujo-it__sub-body').appendChild(n);
        else out.appendChild(n);
      });
      el.replaceChildren(out);
    }
    function enhance(root) {
      root.querySelectorAll('[data-it-auto-acc]').forEach(autoAccordion);
      root.querySelectorAll('[data-it-sub-acc]').forEach(subAccordion);
    }
    function init(root) {
      enhance(root);
      if (root.dataset.itReady) return;
      root.dataset.itReady = '1';
      const tabs = [...root.querySelectorAll('[data-it-tab]')];
      if (!tabs.length) return;

      function activate(id, scroll) {
        tabs.forEach((t) => {
          const on = t.dataset.itTab === id;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        root.querySelectorAll('.liujo-it__panel').forEach((p) => {
          const on = p.id === 'tab-' + id;
          p.hidden = !on;
          p.classList.toggle('is-active', on);
        });
        if (scroll && window.matchMedia('(max-width: 989px)').matches) {
          const panel = root.querySelector('#tab-' + id);
          if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      tabs.forEach((t) => t.addEventListener('click', () => {
        activate(t.dataset.itTab, true);
        try { history.replaceState(null, '', '?tab=' + encodeURIComponent(t.dataset.itHandle)); } catch (e) {}
      }));

      // Deep link: ?tab=<handle> or #tab-<block id>
      const q = new URLSearchParams(location.search).get('tab');
      const byHandle = q && tabs.find((t) => t.dataset.itHandle === q);
      const byHash = location.hash.startsWith('#tab-') && tabs.find((t) => 'tab-' + t.dataset.itTab === location.hash.slice(1));
      const start = byHandle || byHash;
      if (start) activate(start.dataset.itTab, false);
    }
    const run = () => document.querySelectorAll('[data-liujo-info-tabs]').forEach(init);
    document.addEventListener('DOMContentLoaded', run);
    document.addEventListener('shopify:section:load', run);
    document.addEventListener('shopify:block:select', (e) => {
      const btn = document.querySelector('[data-it-tab="' + e.detail.blockId + '"]');
      if (btn) btn.click();
    });
    run();
  })();
{% endjavascript %}

