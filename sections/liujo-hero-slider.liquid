{% comment %}
  LIU JO EDITORIAL HERO SLIDER SECTION
  Full-bleed luxury image slider matching Liu Jo's "Explore the Looks" banner.
{% endcomment %}

<div class="liujo-hero-slider-section" data-section-id="{{ section.id }}" data-section-type="liujo-hero-slider">
  <div class="liujo-hero-slider">
    {%- for block in section.blocks -%}
      <div class="liujo-hero-slide" {{ block.shopify_attributes }}>
        <picture>
          {%- if block.settings.image_mobile != blank -%}
            <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url: width: 800 }}">
          {%- endif -%}
          {%- if block.settings.image_desktop != blank -%}
            <img src="{{ block.settings.image_desktop | image_url: width: 2000 }}" alt="{{ block.settings.heading | escape }}" class="liujo-hero-slide__image" loading="lazy">
          {%- else -%}
            <!-- Official Liu Jo High Resolution Editorial Image -->
            <source media="(max-width: 767px)" srcset="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dwc9a97ec1/the-gigi-hadid-edit/drop1/HP/Hero-2-mob.jpg">
            <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw0e286574/the-gigi-hadid-edit/drop1/HP/Hero-2-desk.jpg" alt="Liu Jo Looks" class="liujo-hero-slide__image" loading="lazy">
          {%- endif -%}
        </picture>

        <div class="liujo-hero-slide__overlay" style="background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});">
          <div class="liujo-hero-slide__content">
            {%- if block.settings.heading != blank -%}
              <h2 class="liujo-title-display" style="color: #fff; margin-bottom: 20px;">
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <div>
                <a href="{{ block.settings.button_link | default: '/collections/all' }}" class="btn-editorial-outline btn-editorial-outline--white">
                  <span>{{ block.settings.button_label }}</span>
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Liu Jo Hero Slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Editorial Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile Image"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 70,
          "step": 5,
          "unit": "%",
          "label": "Overlay Opacity",
          "default": 15
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore the Looks"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Discover Collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Liu Jo Hero Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "Explore the Looks",
            "button_label": "Discover Collection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
