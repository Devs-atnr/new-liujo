{% comment %}
  LIU JO EDITORIAL HERO SLIDER SECTION
  Full-bleed luxury image slider matching Liu Jo's "Explore the Looks" banner.
  Fully dynamic with separate desktop/mobile images, font size sliders, button colors, and alignments.
{% endcomment %}

<div class="liujo-hero-slider-section" data-section-id="{{ section.id }}" data-section-type="liujo-hero-slider">
  <div class="liujo-hero-slider">
    {%- for block in section.blocks -%}
      {%- assign block_id = block.id -%}
      <div class="liujo-hero-slide liujo-hero-slide--{{ block_id }}" {{ block.shopify_attributes }}>
        <style>
          .liujo-hero-slide--{{ block_id }} {
            height: {{ block.settings.slide_height_desktop | default: section.settings.slide_height_desktop | default: '85vh' }};
            min-height: {{ block.settings.min_height_desktop | default: 520 }}px;
          }
          @media (max-width: 767px) {
            .liujo-hero-slide--{{ block_id }} {
              height: {{ block.settings.slide_height_mobile | default: section.settings.slide_height_mobile | default: '70vh' }};
              min-height: {{ block.settings.min_height_mobile | default: 420 }}px;
            }
          }
          .liujo-hero-slide--{{ block_id }} .liujo-hero-slide__overlay {
            background-color: {{ block.settings.overlay_color | default: '#000000' }};
            opacity: {{ block.settings.overlay_opacity | default: 15 | divided_by: 100.0 }};
          }
          .liujo-hero-slide--{{ block_id }} .liujo-hero-slide__overlay-wrap {
            justify-content: {{ block.settings.content_alignment | default: 'center' }};
            align-items: {{ block.settings.content_position | default: 'flex-end' }};
            text-align: {{ block.settings.content_text_align | default: 'center' }};
          }
          .liujo-hero-slide--{{ block_id }} .liujo-hero-slide__subheading {
            font-size: {{ block.settings.subheading_size_desktop | default: 13 }}px;
            color: {{ block.settings.subheading_color | default: '#ffffff' }};
            letter-spacing: 0.15em;
            text-transform: uppercase;
            margin-bottom: 12px;
            font-weight: {{ block.settings.subheading_weight_desktop | default: 600 }};
          }
          .liujo-hero-slide--{{ block_id }} .liujo-hero-slide__heading {
            font-size: {{ block.settings.heading_size_desktop | default: 48 }}px;
            color: {{ block.settings.heading_color | default: '#ffffff' }};
            line-height: 1.15;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 22px;
            font-weight: {{ block.settings.heading_weight_desktop | default: 600 }};
          }
          @media (max-width: 767px) {
            .liujo-hero-slide--{{ block_id }} .liujo-hero-slide__overlay-wrap {
              justify-content: {{ block.settings.content_alignment_mobile | default: block.settings.content_alignment | default: 'center' }};
              align-items: {{ block.settings.content_position_mobile | default: block.settings.content_position | default: 'flex-end' }};
              text-align: {{ block.settings.content_text_align_mobile | default: block.settings.content_text_align | default: 'center' }};
            }
            .liujo-hero-slide--{{ block_id }} .liujo-hero-slide__subheading {
              font-size: {{ block.settings.subheading_size_mobile | default: 11 }}px;
              font-weight: {{ block.settings.subheading_weight_mobile | default: block.settings.subheading_weight_desktop | default: 600 }};
            }
            .liujo-hero-slide--{{ block_id }} .liujo-hero-slide__heading {
              font-size: {{ block.settings.heading_size_mobile | default: 28 }}px;
              font-weight: {{ block.settings.heading_weight_mobile | default: block.settings.heading_weight_desktop | default: 600 }};
            }
            .liujo-hero-slide--{{ block_id }} .liujo-hero-slide__btn {
              font-weight: {{ block.settings.button_weight_mobile | default: block.settings.button_weight_desktop | default: 600 }} !important;
            }
          }
          .liujo-hero-slide--{{ block_id }} .liujo-hero-slide__btn {
            font-size: {{ block.settings.button_font_size | default: 11 }}px;
            color: {{ block.settings.button_text_color | default: '#ffffff' }} !important;
            background-color: {{ block.settings.button_bg_color | default: 'transparent' }} !important;
            border: 1px solid {{ block.settings.button_border_color | default: '#ffffff' }} !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 38px;
            font-weight: {{ block.settings.button_weight_desktop | default: 600 }};
            letter-spacing: 0.2em;
            text-transform: uppercase;
            text-decoration: none;
            transition: all 0.3s ease;
          }
          .liujo-hero-slide--{{ block_id }} .liujo-hero-slide__btn:hover {
            color: {{ block.settings.button_hover_text_color | default: '#000000' }} !important;
            background-color: {{ block.settings.button_hover_bg_color | default: '#ffffff' }} !important;
            border-color: {{ block.settings.button_hover_bg_color | default: '#ffffff' }} !important;
          }
        </style>

        <picture>
          {%- if block.settings.image_mobile != blank -%}
            <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url: width: 1000 }}">
          {%- elsif block.settings.demo_image_mobile != blank -%}
            <source media="(max-width: 767px)" srcset="{{ block.settings.demo_image_mobile }}">
          {%- elsif block.settings.image_desktop == blank -%}
            <source media="(max-width: 767px)" srcset="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dwc9a97ec1/the-gigi-hadid-edit/drop1/HP/Hero-2-mob.jpg">
          {%- endif -%}

          {%- if block.settings.image_desktop != blank -%}
            <img src="{{ block.settings.image_desktop | image_url: width: 2400 }}" alt="{{ block.settings.heading | default: 'Liu Jo Looks' | escape }}" class="liujo-hero-slide__image" loading="lazy">
          {%- elsif block.settings.demo_image_desktop != blank -%}
            <img src="{{ block.settings.demo_image_desktop }}" alt="{{ block.settings.heading | default: 'Liu Jo Looks' | escape }}" class="liujo-hero-slide__image" loading="lazy">
          {%- else -%}
            <!-- Official Liu Jo High Resolution Editorial Image -->
            <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw0e286574/the-gigi-hadid-edit/drop1/HP/Hero-2-desk.jpg" alt="Liu Jo Looks" class="liujo-hero-slide__image" loading="lazy">
          {%- endif -%}
        </picture>

        <!-- Dynamic Overlay Layer -->
        <div class="liujo-hero-slide__overlay"></div>

        <!-- Content Overlay Container -->
        <div class="liujo-hero-slide__overlay-wrap" style="position: absolute; inset: 0; display: flex; padding: 0 24px 70px; z-index: 2;">
          <div class="liujo-hero-slide__content" style="max-width: 760px; width: 100%;">
            {%- if block.settings.subheading != blank -%}
              <div class="liujo-hero-slide__subheading">
                {{ block.settings.subheading }}
              </div>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h2 class="liujo-hero-slide__heading">
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}

            {%- if block.settings.button_label != blank -%}
              <div>
                <a href="{{ block.settings.button_link | default: '/collections/all' }}" class="liujo-hero-slide__btn">
                  <span>{{ block.settings.button_label }}</span>
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Liu Jo Hero Slider",
  "settings": [
    {
      "type": "header",
      "content": "Global Slide Dimensions"
    },
    {
      "type": "select",
