{% comment %}
  LIU JO COLLECTIONS OVERVIEW SECTION
  Editorial gallery showcasing the iconic lines and seasonal collections of Liu Jo.
{% endcomment %}

<div class="liujo-collections-page" data-section-id="{{ section.id }}">
  <!-- Editorial Hero -->
  <div class="liujo-col-hero">
    <div class="liujo-col-hero__inner">
      <span class="liujo-col-hero__tag">LIU JO WORLD</span>
      <h1 class="liujo-col-hero__title">Our Collections</h1>
      <p class="liujo-col-hero__sub">Explore the iconic lines of Liu Jo, from couture eveningwear to revolutionary Bottom Up denim and luxury leather goods.</p>
    </div>
  </div>

  <div class="liujo-col-container">
    <div class="liujo-col-grid">
      <!-- Collection 1: Black Label -->
      <div class="liujo-col-card">
        <div class="card-media">
          <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw10dcfd5c/the-gigi-hadid-edit/drop1/HP/Bags-desk.jpg" alt="Liu Jo Black Label" loading="lazy">
        </div>
        <div class="card-content">
          <span class="card-tag">EVENING &amp; TAILORING</span>
          <h2 class="card-heading">LIU JO BLACK LABEL</h2>
          <p class="card-text">Sophisticated tailoring, couture evening gowns, and contemporary red-carpet glamour designed for memorable occasions.</p>
          <a href="/collections/all" class="card-action">EXPLORE BLACK LABEL &rarr;</a>
        </div>
      </div>

      <!-- Collection 2: White Label -->
      <div class="liujo-col-card">
        <div class="card-media">
          <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw3451da70/the-gigi-hadid-edit/drop1/HP/Shoes-desk.jpg" alt="Liu Jo White Label" loading="lazy">
        </div>
        <div class="card-content">
          <span class="card-tag">CONTEMPORARY DAYWEAR</span>
          <h2 class="card-heading">LIU JO WHITE LABEL</h2>
          <p class="card-text">Effortless day-to-night silhouettes, fine knitwear, fluid silks, and feminine pieces crafted for dynamic modern living.</p>
          <a href="/collections/all" class="card-action">EXPLORE WHITE LABEL &rarr;</a>
        </div>
      </div>

      <!-- Collection 3: Bottom Up Denim -->
      <div class="liujo-col-card">
        <div class="card-media">
          <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw0e286574/the-gigi-hadid-edit/drop1/HP/Hero-2-desk.jpg" alt="Liu Jo Bottom Up Denim" loading="lazy">
        </div>
        <div class="card-content">
          <span class="card-tag">ICONIC INNOVATION</span>
          <h2 class="card-heading">BOTTOM UP DENIM</h2>
          <p class="card-text">Since 2008, the pioneering Italian jean engineered with sculpting back yokes to enhance and celebrate natural feminine curves.</p>
          <a href="/collections/all" class="card-action">DISCOVER DENIM &rarr;</a>
        </div>
      </div>

      <!-- Collection 4: Bags & Accessories -->
      <div class="liujo-col-card">
        <div class="card-media">
          <img src="https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw83a21698/the-gigi-hadid-edit/drop1/HP/Hero-1-desk.jpg" alt="Liu Jo Bags & Shoes" loading="lazy">
        </div>
        <div class="card-content">
          <span class="card-tag">LEATHER GOODS &amp; SHOES</span>
          <h2 class="card-heading">BAGS, SHOES &amp; ACCESSORIES</h2>
          <p class="card-text">Signature hobo bags, crossbody clutches, platform sneakers, and reversible monogram belts that complete every Liu Jo look.</p>
          <a href="/collections/all" class="card-action">SHOP ACCESSORIES &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .liujo-collections-page {
    background: #fff;
    color: #111;
  }
  .liujo-col-hero {
    background: #000;
    color: #fff;
    padding: 80px 24px;
    text-align: center;
  }
  .liujo-col-hero__inner {
    max-width: 800px;
    margin: 0 auto;
  }
  .liujo-col-hero__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #bbb;
    display: block;
    margin-bottom: 14px;
  }
  .liujo-col-hero__title {
    font-size: 38px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 16px 0;
    color: #fff;
  }
  .liujo-col-hero__sub {
    font-size: 15px;
    color: #999;
    line-height: 1.7;
    margin: 0;
  }
  .liujo-col-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 70px 20px;
  }
  .liujo-col-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px 40px;
  }
  .liujo-col-card {
    background: #fafafa;
    border: 1px solid #eaeaea;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s;
  }
  .liujo-col-card:hover {
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  }
  .card-media {
    height: 380px;
    overflow: hidden;
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .liujo-col-card:hover .card-media img {
    transform: scale(1.04);
  }
  .card-content {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .card-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 10px;
  }
  .card-heading {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 12px 0;
  }
  .card-text {
    font-size: 14px;
    line-height: 1.7;
    color: #666;
    margin-bottom: 24px;
    flex-grow: 1;
  }
  .card-action {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #000;
    text-decoration: none;
    border-bottom: 1px solid #000;
    padding-bottom: 2px;
    align-self: flex-start;
    transition: opacity 0.2s;
  }
  .card-action:hover {
    opacity: 0.65;
  }
  @media screen and (max-width: 768px) {
    .liujo-col-grid {
      grid-template-columns: 1fr;
    }
    .card-media {
      height: 280px;
    }
  }
</style>

