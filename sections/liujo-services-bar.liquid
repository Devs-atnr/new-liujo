{% comment %}
  LIU JO BOUTIQUE SERVICES BAR SECTION
  Reassurance strip highlighting luxury delivery, boutique support, returns & secure payments.
{% endcomment %}

<div class="liujo-services-bar" data-section-id="{{ section.id }}" data-section-type="liujo-services-bar">
  <div class="liujo-services-grid">
    {%- for block in section.blocks -%}
      <div class="liujo-service-item" {{ block.shopify_attributes }}>
        <div class="liujo-service-icon">
          {%- case block.settings.icon -%}
            {%- when 'shipping' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            {%- when 'support' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            {%- when 'returns' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
            {%- when 'security' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          {%- endcase -%}
        </div>
        <div class="liujo-service-text">
          <div class="liujo-service-title">{{ block.settings.title }}</div>
          <p class="liujo-service-desc">{{ block.settings.description }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Liu Jo Boutique Services",
  "settings": [],
  "blocks": [
    {
      "type": "service",
      "name": "Service Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Express Shipping" },
            { "value": "support", "label": "Boutique Support" },
            { "value": "returns", "label": "Easy Returns" },
            { "value": "security", "label": "Secure Checkout" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Express Shipping"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Complimentary delivery on all boutique orders"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Liu Jo Boutique Services",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "icon": "shipping",
            "title": "Orders & Shipments",
            "description": "Complimentary delivery on orders over €150"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "support",
            "title": "Boutique Assistance",
            "description": "Monday to Friday, 9:00 to 18:00 CET"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "returns",
            "title": "Easy Returns",
            "description": "30 days for complimentary returns & exchanges"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "security",
            "title": "Certified Payments",
            "description": "Encrypted checkout via Cards, PayPal & Klarna"
          }
        }
      ]
    }
  ]
}
{% endschema %}
