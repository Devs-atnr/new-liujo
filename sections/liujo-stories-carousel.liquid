{% comment %}
  LIU JO STORIES CAROUSEL SECTION
  Replicates the high-fashion editorial horizontal stories carousel from Liu Jo.
  Features:
  - Draggable & swipeable continuous carousel track
  - Vertical rotated "STORIES" editorial badge on each card
  - Segmented progress bar navigation indicator
  - Prev / Next navigation arrows
  - Full Shopify Theme Editor integration (live block selection & updates)
{% endcomment %}

{%- assign s_id = section.id -%}
{%- assign ratio = '4 / 5' -%}
{%- if section.settings.card_aspect_ratio == 'tall' -%}
  {%- assign ratio = '3 / 4' -%}
{%- elsif section.settings.card_aspect_ratio == 'square' -%}
  {%- assign ratio = '1 / 1' -%}
{%- elsif section.settings.card_aspect_ratio == 'landscape' -%}
  {%- assign ratio = '16 / 9' -%}
{%- endif -%}

{%- assign cols_m = 1.25 -%}
{%- if section.settings.cards_mobile == '1' -%}
  {%- assign cols_m = 1 -%}
{%- elsif section.settings.cards_mobile == '2' -%}
  {%- assign cols_m = 2 -%}
{%- endif -%}

<section
  class="liujo-stories-section liujo-stories--{{ s_id }}"
  id="liujo-stories-{{ s_id }}"
  data-section-id="{{ s_id }}"
  data-section-type="liujo-stories-carousel"
>
  <style>
    .liujo-stories--{{ s_id }} {
      background-color: {{ section.settings.bg_color | default: '#ffffff' }};
      padding-top: {{ section.settings.padding_top | default: 50 }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
      overflow: hidden;
      position: relative;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-inner {
      {% if section.settings.full_width %}
        max-width: 100%;
        padding-left: {{ section.settings.horizontal_padding | default: 32 }}px;
        padding-right: {{ section.settings.horizontal_padding | default: 32 }}px;
      {% else %}
        max-width: var(--liujo-container-max, 1680px);
        margin: 0 auto;
        padding-left: 24px;
        padding-right: 24px;
      {% endif %}
    }

    /* Header */
    .liujo-stories--{{ s_id }} .liujo-stories-header {
      margin-bottom: 24px;
      text-align: {{ section.settings.heading_align | default: 'left' }};
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 16px;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-title {
      font-family: var(--font-heading-family, inherit);
      font-size: {{ section.settings.heading_size_desktop | default: 28 }}px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: {{ section.settings.heading_color | default: '#000000' }};
      margin: 0;
      line-height: 1.15;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-subtitle {
      font-size: 14px;
      letter-spacing: 0.04em;
      color: #666666;
      margin: 6px 0 0;
    }

    /* Viewport & Track */
    .liujo-stories--{{ s_id }} .liujo-stories-carousel-wrap {
      position: relative;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-track {
      display: flex;
      gap: {{ section.settings.card_gap_desktop | default: 20 }}px;
      overflow-x: auto;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      cursor: grab;
      user-select: none;
      padding: 4px 0 16px;
      margin: 0;
      list-style: none;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-track::-webkit-scrollbar {
      display: none;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-track.is-dragging {
      cursor: grabbing;
      scroll-behavior: auto !important;
    }

    /* Slide Card Calculation */
    .liujo-stories--{{ s_id }} .liujo-story-slide {
      {%- assign cols_d = section.settings.cards_desktop | default: 4 | plus: 0 -%}
      {%- assign gap_d = section.settings.card_gap_desktop | default: 20 | plus: 0 -%}
      flex: 0 0 calc((100% - ({{ cols_d }} - 1) * {{ gap_d }}px) / {{ cols_d }});
      min-width: 240px;
      scroll-snap-align: start;
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
    }

    .liujo-stories--{{ s_id }} .liujo-story-card {
      width: 100%;
      display: flex;
      flex-direction: column;
    }

    /* Media Aspect Ratio Container */
    .liujo-stories--{{ s_id }} .liujo-story-media-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: {{ ratio }};
      background-color: #f5f5f5;
      overflow: hidden;
      display: block;
      text-decoration: none;
    }

    .liujo-stories--{{ s_id }} .liujo-story-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.65s cubic-bezier(0.2, 0.8, 0.2, 1);
      pointer-events: none;
    }

    .liujo-stories--{{ s_id }} .liujo-story-card:hover .liujo-story-img {
      transform: scale(1.04);
    }

    /* Vertical Rotated "STORIES" Badge */
    .liujo-stories--{{ s_id }} .liujo-story-vertical-badge {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      writing-mode: vertical-rl;
      text-orientation: mixed;
      text-transform: uppercase;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.22em;
      line-height: 1;
      color: {{ section.settings.badge_color | default: '#111111' }};
      text-shadow: 0 0 6px rgba(255, 255, 255, 0.85), 0 0 2px rgba(255, 255, 255, 0.95);
      z-index: 3;
      pointer-events: none;
      user-select: none;
    }

    /* Story Card Caption / Info */
    .liujo-stories--{{ s_id }} .liujo-story-info {
      padding: 14px 2px 4px;
    }

    .liujo-stories--{{ s_id }} .liujo-story-title {
      font-family: var(--font-heading-family, inherit);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      line-height: 1.35;
      margin: 0;
      color: #111111;
    }

    .liujo-stories--{{ s_id }} .liujo-story-title a {
      color: inherit;
      text-decoration: none;
      transition: opacity 0.2s ease;
    }

    .liujo-stories--{{ s_id }} .liujo-story-title a:hover {
      opacity: 0.7;
    }

    .liujo-stories--{{ s_id }} .liujo-story-sub {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: #888888;
      margin-top: 5px;
      display: block;
    }

    /* Bottom Controls: Segmented Progress Bar & Navigation */
    .liujo-stories--{{ s_id }} .liujo-stories-footer-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 24px;
      padding-top: 4px;
    }

    /* Segmented Line Progress Bar */
    .liujo-stories--{{ s_id }} .liujo-stories-progress-bar {
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-progress-segment {
      height: 2px;
      width: 72px;
      background-color: #d2d2d2;
      border: none;
      padding: 0;
      margin: 0;
      cursor: pointer;
      position: relative;
      transition: background-color 0.25s ease, height 0.25s ease;
      outline: none;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-progress-segment::after {
      content: '';
      position: absolute;
      top: -10px;
      bottom: -10px;
      left: 0;
      right: 0;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-progress-segment:hover {
      background-color: #999999;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-progress-segment.is-active {
      background-color: #000000;
      height: 2.5px;
    }

    /* Navigation Arrows */
    .liujo-stories--{{ s_id }} .liujo-stories-arrows {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-arrow-btn {
      width: 38px;
      height: 38px;
      border: 1px solid #e0e0e0;
      border-radius: 50%;
      background: #ffffff;
      color: #111111;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.25s ease;
      padding: 0;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-arrow-btn:hover {
      background: #000000;
      color: #ffffff;
      border-color: #000000;
    }

    .liujo-stories--{{ s_id }} .liujo-stories-arrow-btn:disabled {
      opacity: 0.35;
      cursor: not-allowed;
      pointer-events: none;
    }

    /* Responsive Breakpoints */
    @media (max-width: 1024px) {
      .liujo-stories--{{ s_id }} .liujo-story-slide {
        {%- assign cols_t = 3 -%}
        {%- assign gap_t = 16 -%}
        flex: 0 0 calc((100% - ({{ cols_t }} - 1) * {{ gap_t }}px) / {{ cols_t }});
        min-width: 220px;
      }
      .liujo-stories--{{ s_id }} .liujo-stories-track {
        gap: 16px;
      }
      .liujo-stories--{{ s_id }} .liujo-stories-progress-segment {
        width: 50px;
      }
    }

    @media (max-width: 767px) {
      .liujo-stories--{{ s_id }} {
        padding-top: {{ section.settings.padding_top | default: 50 | divided_by: 1.4 | round }}px;
        padding-bottom: {{ section.settings.padding_bottom | default: 60 | divided_by: 1.4 | round }}px;
      }
      .liujo-stories--{{ s_id }} .liujo-stories-inner {
        padding-left: 16px;
        padding-right: 16px;
      }
      .liujo-stories--{{ s_id }} .liujo-stories-title {
        font-size: {{ section.settings.heading_size_mobile | default: 22 }}px;
      }
      .liujo-stories--{{ s_id }} .liujo-stories-track {
        gap: {{ section.settings.card_gap_mobile | default: 12 }}px;
        padding-bottom: 12px;
      }
      .liujo-stories--{{ s_id }} .liujo-story-slide {
        flex: 0 0 calc((100% - 20px) / {{ cols_m }});
        min-width: 200px;
      }
      .liujo-stories--{{ s_id }} .liujo-story-vertical-badge {
        font-size: 8px;
        letter-spacing: 0.18em;
        right: 6px;
      }
      .liujo-stories--{{ s_id }} .liujo-story-title {
        font-size: 12px;
      }
      .liujo-stories--{{ s_id }} .liujo-stories-progress-segment {
        width: 36px;
      }
      .liujo-stories--{{ s_id }} .liujo-stories-footer-controls {
        margin-top: 18px;
      }
    }
  </style>

  <div class="liujo-stories-inner">
    <!-- Header -->
    <div class="liujo-stories-header">
      <div>
        <h2 class="liujo-stories-title">{{ section.settings.heading | default: 'STORIES' }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="liujo-stories-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.header_link_text != blank -%}
        <div>
          <a
            href="{{ section.settings.header_link_url | default: '/collections/all' }}"
            class="btn-link-editorial"
            style="font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: #111111; text-decoration: underline;"
          >
            {{ section.settings.header_link_text }}
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Carousel Viewport -->
    <div class="liujo-stories-carousel-wrap">
      <div class="liujo-stories-track" data-stories-track>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div
              class="liujo-story-slide"
              data-slide-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <div class="liujo-story-card">
                <a
                  href="{{ block.settings.link | default: '#' }}"
                  class="liujo-story-media-wrap"
                  {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
                  aria-label="{{ block.settings.title | default: 'Liu Jo Story' | escape }}"
                >
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 800 }}"
                      alt="{{ block.settings.title | default: 'Story' | escape }}"
                      class="liujo-story-img"
                      loading="lazy"
                    >
                  {%- elsif block.settings.demo_image_url != blank -%}
                    <img
                      src="{{ block.settings.demo_image_url }}"
                      alt="{{ block.settings.title | default: 'Story' | escape }}"
                      class="liujo-story-img"
                      loading="lazy"
                    >
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'liujo-story-img' }}
                  {%- endif -%}

                  {%- if section.settings.show_vertical_badge -%}
                    <span class="liujo-story-vertical-badge">
                      {{ block.settings.badge_text | default: section.settings.badge_default_text | default: 'STORIES' }}
                    </span>
                  {%- endif -%}
                </a>

                <div class="liujo-story-info">
                  <h3 class="liujo-story-title">
                    <a
                      href="{{ block.settings.link | default: '#' }}"
                      {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
                    >
                      {{ block.settings.title }}
                    </a>
                  </h3>
                  {%- if block.settings.category != blank -%}
                    <span class="liujo-story-sub">{{ block.settings.category }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Fallback Editorial Stories Matching Liu Jo Catalog -->
          {%- assign demo_titles = "ADV CAMPAIGN SS24 - THE NEW GLAM|EDITORIAL DENIM SS24|SPOT SNEAKERS SS24|XMAS PROJECT - LIU JO LAPUFFY|MODERN TAILORING & HERITAGE" | split: "|" -%}
          {%- assign demo_images = "https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw0e286574/the-gigi-hadid-edit/drop1/HP/Hero-2-desk.jpg|https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dwf89ea3b3/the-gigi-hadid-edit/drop1/HP/jeans.jpg|https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dwefa31552/the-gigi-hadid-edit/drop1/HP/shoes.jpg|https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dwb43c3548/the-gigi-hadid-edit/drop1/HP/jackets.jpg|https://www.liujo.com/dw/image/v2/BDNR_PRD/on/demandware.static/-/Library-Sites-LiuJoSharedLibrary/default/dw4278e299/the-gigi-hadid-edit/drop1/HP/Shirts.jpg" | split: "|" -%}

          {%- for title in demo_titles -%}
            {%- assign img_src = demo_images[forloop.index0] -%}
            <div class="liujo-story-slide" data-slide-index="{{ forloop.index0 }}">
              <div class="liujo-story-card">
                <a href="/collections/all" class="liujo-story-media-wrap">
                  <img src="{{ img_src }}" alt="{{ title }}" class="liujo-story-img" loading="lazy">
                  {%- if section.settings.show_vertical_badge -%}
                    <span class="liujo-story-vertical-badge">
                      {{ section.settings.badge_default_text | default: 'STORIES' }}
                    </span>
                  {%- endif -%}
                </a>
                <div class="liujo-story-info">
                  <h3 class="liujo-story-title">
                    <a href="/collections/all">{{ title }}</a>
                  </h3>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <!-- Bottom Navigation Controls -->
    {%- if section.settings.show_progress_bar or section.settings.show_arrows -%}
      <div class="liujo-stories-footer-controls">
        <!-- Segmented Progress Bar -->
        {%- if section.settings.show_progress_bar -%}
          <div class="liujo-stories-progress-bar" data-progress-bar aria-label="Stories Progress">
            <!-- Dynamically populated/updated via JS -->
          </div>
        {%- else -%}
          <div></div>
        {%- endif -%}

        <!-- Navigation Chevrons -->
        {%- if section.settings.show_arrows -%}
          <div class="liujo-stories-arrows">
            <button
              type="button"
              class="liujo-stories-arrow-btn"
              data-arrow-prev
              aria-label="Previous Stories"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button
              type="button"
              class="liujo-stories-arrow-btn"
              data-arrow-next
              aria-label="Next Stories"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <script>
    (function() {
      function initStoriesCarousel(sectionElem) {
        if (!sectionElem) return;
        const track = sectionElem.querySelector('[data-stories-track]');
        const progressBar = sectionElem.querySelector('[data-progress-bar]');
        const prevBtn = sectionElem.querySelector('[data-arrow-prev]');
        const nextBtn = sectionElem.querySelector('[data-arrow-next]');
        const slides = sectionElem.querySelectorAll('.liujo-story-slide');

        if (!track || slides.length === 0) return;

        // Build Segmented Progress Bars
        function updateProgressSegments() {
          if (!progressBar) return;
          progressBar.innerHTML = '';
          
          const trackWidth = track.clientWidth;
          const slideWidth = slides[0].getBoundingClientRect().width + (parseFloat(window.getComputedStyle(track).gap) || 20);
          const visibleCount = Math.max(1, Math.round(trackWidth / slideWidth));
          const totalPages = Math.max(1, slides.length - visibleCount + 1);

          for (let i = 0; i < totalPages; i++) {
            const seg = document.createElement('button');
            seg.type = 'button';
            seg.className = 'liujo-stories-progress-segment' + (i === 0 ? ' is-active' : '');
            seg.setAttribute('aria-label', 'Go to story page ' + (i + 1));
            seg.addEventListener('click', () => {
              const targetSlide = slides[i];
              if (targetSlide) {
                track.scrollTo({
                  left: targetSlide.offsetLeft - track.offsetLeft,
                  behavior: 'smooth'
                });
              }
            });
            progressBar.appendChild(seg);
          }
          syncActiveState();
        }

        function syncActiveState() {
          const maxScroll = track.scrollWidth - track.clientWidth;
          const currentScroll = track.scrollLeft;

          // Update Prev / Next Buttons
          if (prevBtn) prevBtn.disabled = currentScroll <= 4;
          if (nextBtn) nextBtn.disabled = currentScroll >= maxScroll - 4;

          // Update Progress Segments
          if (progressBar) {
            const segments = progressBar.querySelectorAll('.liujo-stories-progress-segment');
            if (segments.length > 0) {
              const progress = maxScroll > 0 ? Math.min(1, Math.max(0, currentScroll / maxScroll)) : 0;
              const activeIndex = Math.min(segments.length - 1, Math.round(progress * (segments.length - 1)));
              segments.forEach((seg, idx) => {
                seg.classList.toggle('is-active', idx === activeIndex);
              });
            }
          }
        }

        // Arrow buttons
        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            const step = slides[0].getBoundingClientRect().width * 1.5;
            track.scrollBy({ left: -step, behavior: 'smooth' });
          });
        }
        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            const step = slides[0].getBoundingClientRect().width * 1.5;
            track.scrollBy({ left: step, behavior: 'smooth' });
          });
        }

        // Scroll listener with throttle
        let ticking = false;
        track.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              syncActiveState();
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        // Mouse Drag to Scroll with Velocity
        let isDown = false;
        let startX = 0;
        let scrollStart = 0;
        let hasMoved = false;

        track.addEventListener('mousedown', (e) => {
          isDown = true;
          hasMoved = false;
          startX = e.pageX - track.offsetLeft;
          scrollStart = track.scrollLeft;
          track.classList.add('is-dragging');
        });

        window.addEventListener('mouseup', () => {
          if (isDown) {
            isDown = false;
            track.classList.remove('is-dragging');
          }
        });

        track.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - track.offsetLeft;
          const dist = (x - startX) * 1.4;
          if (Math.abs(dist) > 5) hasMoved = true;
          track.scrollLeft = scrollStart - dist;
        });

        // Prevent clicking links when dragging
        track.addEventListener('click', (e) => {
          if (hasMoved) {
            e.preventDefault();
            e.stopPropagation();
            hasMoved = false;
          }
        }, true);

        // Window resize
        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(updateProgressSegments, 150);
        });

        // Initial setup
        updateProgressSegments();
      }

      // Initialize on DOM load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initStoriesCarousel(document.getElementById('liujo-stories-{{ s_id }}'));
        });
      } else {
        initStoriesCarousel(document.getElementById('liujo-stories-{{ s_id }}'));
      }

      // Shopify Editor Event Listeners
      document.addEventListener('shopify:section:load', (e) => {
        if (e.target.id === 'liujo-stories-{{ s_id }}' || e.target.querySelector('#liujo-stories-{{ s_id }}')) {
          initStoriesCarousel(document.getElementById('liujo-stories-{{ s_id }}'));
        }
      });
      document.addEventListener('shopify:block:select', (e) => {
        const block = e.target;
        if (block && block.closest('#liujo-stories-{{ s_id }}')) {
          const track = block.closest('.liujo-stories-track');
          if (track) {
            track.scrollTo({ left: block.offsetLeft - track.offsetLeft, behavior: 'smooth' });
          }
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Liu Jo Stories Carousel",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STORIES"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": ""
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
