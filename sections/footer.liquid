{% comment %}
  LIU JO LUXURY FOOTER (Integrates seamlessly into Shopify OS 2.0 Footer Group)
  Pre-footer Help, Newsletter, 4-Column Accordion, Language Selector, Socials & Legal
{% endcomment %}

<footer class="liujo-footer" data-section-id="{{ section.id }}" data-section-type="liujo-footer">
  <!-- Liu Jo Back to Top Bar (Image 1 Parity) -->
  {%- if section.settings.show_back_to_top != false -%}
    <div class="liujo-back-to-top">
      <div class="liujo-back-to-top__container">
        <button type="button" class="liujo-back-to-top__btn" onclick="window.scrollTo({top: 0, behavior: 'smooth'});" aria-label="Go back to top">
          {{ section.settings.back_to_top_text | default: 'GO BACK TO' }}
        </button>
      </div>
    </div>
  {%- endif -%}

  <div class="liujo-prefooter">
    <div class="liujo-prefooter__container">
      <!-- Left: Customer Help Desk -->
      <div class="liujo-help-block">
        <h3>{{ section.settings.help_title | default: 'MAY WE HELP YOU?' | upcase }}</h3>
        <p>
          Phone
          <strong>
            <a href="tel:{{ section.settings.help_phone | remove: ' ' | default: '+443308087718' }}">{{ section.settings.help_phone | default: '+44 330 8087718' }}</a>
          </strong><br>
          {{ section.settings.help_hours | default: 'Monday to Friday, 9.00 to 18.00' }}
        </p>
        <a href="{{ section.settings.help_link | default: '/pages/contact' }}" class="btn-link-editorial">
          EMAIL US
        </a>
      </div>

      <!-- Right: Newsletter Signup -->
      <div class="liujo-newsletter-block">
        <h3>{{ section.settings.newsletter_title | default: 'SIGN UP FOR UPDATES' | upcase }}</h3>
        <p>Subscribe to our newsletter.</p>

        {% form 'customer', class: 'liujo-newsletter-form', id: 'liujo-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="liujo-nl-label" for="nl-email-input">EMAIL</label>
          <div class="liujo-nl-form-row">
            <input type="email"
                   id="nl-email-input"
                   name="contact[email]"
                   class="liujo-nl-input liujo-nl-email-input"
                   value="{{ form.email }}"
                   placeholder="Email address"
                   autocomplete="email"
                   required>
          </div>

          <div class="liujo-nl-privacy">
            By entering your e-mail address you declare that you wish to subscribe to the Liu Jo newsletter. For further information,
            <a href="/pages/privacy-policy">please see our Privacy Policy</a>.
          </div>

          <!-- Expandable Details: First Name, Last Name, Gender & Confirm Registration (Image 3 Parity) -->
          <div class="liujo-nl-details" data-liujo-nl-details>
            <div class="liujo-nl-names-row">
              <div class="liujo-nl-field">
                <label class="liujo-nl-label" for="nl-first-name">FIRST NAME</label>
                <input type="text"
                       id="nl-first-name"
                       name="contact[first_name]"
                       class="liujo-nl-input"
                       autocomplete="given-name">
              </div>
              <div class="liujo-nl-field">
                <label class="liujo-nl-label" for="nl-last-name">LAST NAME</label>
                <input type="text"
                       id="nl-last-name"
                       name="contact[last_name]"
                       class="liujo-nl-input"
                       autocomplete="family-name">
              </div>
            </div>

            <div class="liujo-nl-actions-row">
              <div class="liujo-nl-gender-pills">
                <label class="liujo-gender-label">
                  <input type="checkbox" name="customer[note][woman]" value="true" checked>
                  <span>Woman</span>
                </label>
                <label class="liujo-gender-label">
                  <input type="checkbox" name="customer[note][man]" value="true">
                  <span>Man</span>
                </label>
                <label class="liujo-gender-label">
                  <input type="checkbox" name="customer[note][girl]" value="true">
                  <span>Girl</span>
                </label>
              </div>

              <div class="liujo-nl-submit-wrap">
                <button type="submit" class="liujo-nl-submit-btn">
                  CONFIRM REGISTRATION
                </button>
              </div>
            </div>
          </div>

          {%- if form.posted_successfully? -%}
            <p class="liujo-nl-success" style="color: #2e7d32; font-size: 13px; margin-top: 14px;">
              Thank you for subscribing to Liu Jo updates!
            </p>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </div>

  <!-- Main 4-Column Accordion Footer -->
  <div class="liujo-main-footer">
    <div class="liujo-footer-grid">
      <!-- Col 1: Customer Care -->
      <div class="liujo-footer-col">
        <h4 class="liujo-footer-heading">{{ section.settings.col_1_title | default: 'CUSTOMER CARE' }}</h4>
        <ul class="liujo-footer-links">
          {%- if section.settings.col_1_menu != blank and linklists[section.settings.col_1_menu].links.size > 0 -%}
            {%- for link in linklists[section.settings.col_1_menu].links -%}
              <li class="liujo-footer-link-item"><a href="{{ link.url }}" class="liujo-footer-link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li class="liujo-footer-link-item"><a href="/pages/orders-and-shipments" class="liujo-footer-link">Orders & Shipping Services</a></li>
            <li class="liujo-footer-link-item"><a href="/pages/payments" class="liujo-footer-link">Payments</a></li>
            <li class="liujo-footer-link-item"><a href="/pages/refunds-and-returns" class="liujo-footer-link">Return and Exchange Policy</a></li>
            <li class="liujo-footer-link-item"><a href="https://www.liujo.com/returns/search" target="_blank" rel="noopener noreferrer" class="liujo-footer-link">Make a Return</a></li>
            <li class="liujo-footer-link-item"><a href="/pages/size-guide" class="liujo-footer-link">Size Guide</a></li>
            <li class="liujo-footer-link-item"><a href="/pages/how-to-take-care" class="liujo-footer-link">How to take care</a></li>
            <li class="liujo-footer-link-item"><a href="/pages/faq" class="liujo-footer-link">FAQ</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Col 2: Liu Jo World -->
      <div class="liujo-footer-col">
        <h4 class="liujo-footer-heading">{{ section.settings.col_2_title | default: 'LIU JO WORLD' }}</h4>
        <ul class="liujo-footer-links">
          {%- if section.settings.col_2_menu != blank and linklists[section.settings.col_2_menu].links.size > 0 -%}
            {%- for link in linklists[section.settings.col_2_menu].links -%}
              <li class="liujo-footer-link-item"><a href="{{ link.url }}" class="liujo-footer-link{% if link.title == 'Stories' %} liujo-footer-link--stories{% endif %}">{% if link.title == 'Stories' %}<span style="color:#ff6699;">Stories</span>{% else %}{{ link.title }}{% endif %}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li class="liujo-footer-link-item"><a href="/pages/stories" class="liujo-footer-link liujo-footer-link--stories"><span style="color:#ff6699;">Stories</span></a></li>
            <li class="liujo-footer-link-item"><a href="/pages/about" class="liujo-footer-link">About Liu Jo</a></li>
            <li class="liujo-footer-link-item"><a href="https://bettertogether.liujo.com/en?&utm_medium=banner&utm_source=google&utm_campaign=20210622_EN_en_BetterTogether_footer" target="_blank" rel="noopener noreferrer" class="liujo-footer-link">Better Together</a></li>
            <li class="liujo-footer-link-item"><a href="/pages/collections" class="liujo-footer-link">Collections</a></li>
            <li class="liujo-footer-link-item"><a href="/pages/retail-experience" class="liujo-footer-link">Retail Experience</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Col 3: Liu Jo for you -->
      <div class="liujo-footer-col">
        <h4 class="liujo-footer-heading">{{ section.settings.col_3_title | default: 'LIU JO FOR YOU' }}</h4>
        <ul class="liujo-footer-links">
          {%- if section.settings.col_3_menu != blank and linklists[section.settings.col_3_menu].links.size > 0 -%}
            {%- for link in linklists[section.settings.col_3_menu].links -%}
              <li class="liujo-footer-link-item"><a href="{{ link.url }}" class="liujo-footer-link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li class="liujo-footer-link-item"><a href="/pages/easy-shopping" class="liujo-footer-link">Easy Shopping</a></li>
            <li class="liujo-footer-link-item"><a href="/pages/stores" class="liujo-footer-link">Store locator</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Col 4: Corporate -->
      <div class="liujo-footer-col">
        <h4 class="liujo-footer-heading">{{ section.settings.col_4_title | default: 'CORPORATE' }}</h4>
        <ul class="liujo-footer-links">
          {%- if section.settings.col_4_menu != blank and linklists[section.settings.col_4_menu].links.size > 0 -%}
            {%- for link in linklists[section.settings.col_4_menu].links -%}
              <li class="liujo-footer-link-item"><a href="{{ link.url }}" class="liujo-footer-link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li class="liujo-footer-link-item"><a href="https://exelitegroup.com/people/work-with-us/" target="_blank" rel="noopener noreferrer" class="liujo-footer-link">Careers</a></li>
            <li class="liujo-footer-link-item"><a href="/pages/privacy-policy" class="liujo-footer-link">Privacy Policy</a></li>
            <li class="liujo-footer-link-item"><a href="/pages/cookie-policy" class="liujo-footer-link">Cookie Policy</a></li>
            <li class="liujo-footer-link-item"><button type="button" class="liujo-footer-link" id="btn-modify-cookies" onclick="alert('Cookie preferences: All necessary and analytics cookies are active. You can manage profiling options here.');">Cookies Preferences</button></li>
            <li class="liujo-footer-link-item"><a href="/pages/terms-and-conditions" class="liujo-footer-link">Terms and condition</a></li>
            <li class="liujo-footer-link-item"><a href="/pages/terms-of-sale" class="liujo-footer-link">Terms of sale</a></li>
            <li class="liujo-footer-link-item"><a href="/pages/accessibility-statement" class="liujo-footer-link">Accessibility Statement</a></li>
            <li class="liujo-footer-link-item"><a href="https://s3liujo-pdf.s3.eu-central-1.amazonaws.com/MOG+WB_ING.pdf" target="_blank" rel="noopener noreferrer" class="liujo-footer-link">Organisation model</a></li>
          {%- endif -%}
        </ul>
      </div>
    </div>
  </div>

  <!-- Post-Footer -->
  <div class="liujo-postfooter">
    <div class="liujo-postfooter__container">
      <div class="liujo-postfooter__row">
        <div class="liujo-postfooter__left">
          <button type="button" class="liujo-accessibility-btn" aria-label="Accessibility options">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <circle cx="12" cy="4.5" r="2.5"></circle>
              <path d="M12 8c-3.5 0-6.5.7-9 1.7l.6 2.3c2-.8 4.4-1.3 6.9-1.5v4.5l-3.2 5.5 2.1 1.2 3.6-6.2 3.6 6.2 2.1-1.2-3.2-5.5V10.5c2.5.2 4.9.7 6.9 1.5l.6-2.3c-2.5-1-5.5-1.7-9-1.7z"></path>
            </svg>
          </button>
          <a href="/pages/change-country" class="liujo-lang-link">
            LANGUAGE: <span>English</span>
          </a>
        </div>

        <!-- Social Icons -->
        <div class="liujo-social-icons">
          <a href="{{ settings.social_instagram_link | default: 'https://www.instagram.com/liujo/' }}" class="liujo-social-icon" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor"></circle></svg>
          </a>
          <a href="{{ settings.social_facebook_link | default: 'https://www.facebook.com/liujoglobal' }}" class="liujo-social-icon" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <a href="{{ settings.social_youtube_link | default: 'https://www.youtube.com/liujofficial' }}" class="liujo-social-icon" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.1c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.43z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="#000"></polygon></svg>
          </a>
          <a href="{{ settings.social_tiktok_link | default: 'https://www.tiktok.com/@liujo' }}" class="liujo-social-icon" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68 6.34 6.34 0 0 0 9.35 22a6.34 6.34 0 0 0 6.34-6.33V9.2a8.16 8.16 0 0 0 4.9 1.62V7.37a4.85 4.85 0 0 1-1-.68z"></path></svg>
          </a>
        </div>
      </div>

      <!-- Copyright Notice -->
      <div class="liujo-copyright">
        {{ section.settings.copyright_text | default: '© 2025 Digital Boite s.r.l. All Rights Reserved. REA and C.F. 03796760365, REA MI-2608722.' }}
      </div>
    </div>
  </div>

  <script>
    (function() {
      function setupNlExpand() {
        var form = document.querySelector('.liujo-newsletter-form');
        if (!form) return;
        var emailInput = form.querySelector('.liujo-nl-email-input') || form.querySelector('input[type="email"]');
        if (!emailInput) return;

        function expand() {
          if (!form.classList.contains('is-expanded')) {
            form.classList.add('is-expanded');
          }
        }

        emailInput.addEventListener('focus', expand);
        emailInput.addEventListener('click', expand);
        emailInput.addEventListener('input', expand);

        if (emailInput.value && emailInput.value.trim().length > 0) {
          expand();
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupNlExpand);
      } else {
        setupNlExpand();
      }
    })();
  </script>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "section-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Back To Top"
    },
    {
      "type": "checkbox",
      "id": "show_back_to_top",
      "default": true,
      "label": "Show 'GO BACK TO' bar"
    },
    {
      "type": "text",
      "id": "back_to_top_text",
      "default": "GO BACK TO",
      "label": "Back to top button text"
    },
    {
      "type": "header",
      "content": "Customer Help"
    },
    {
      "type": "text",
      "id": "help_title",
      "label": "Help Title",
      "default": "May we help you?"
    },
    {
      "type": "text",
      "id": "help_phone",
      "label": "Phone Number",
      "default": "+44 330 8087718"
    },
    {
      "type": "text",
      "id": "help_hours",
      "label": "Support Hours",
      "default": "Monday to Friday, 9.00 to 18.00"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Contact Page Link"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "Sign up for updates"
    },
    {
      "type": "checkbox",
      "id": "show_gender_pills",
      "default": false,
      "label": "Show gender checkboxes"
    },
    {
      "type": "header",
      "content": "Navigation Columns"
    },
    {
      "type": "text",
      "id": "col_1_title",
      "label": "Column 1 Title",
      "default": "Customer Care"
    },
    {
      "type": "link_list",
      "id": "col_1_menu",
      "label": "Column 1 Menu"
    },
    {
      "type": "text",
      "id": "col_2_title",
      "label": "Column 2 Title",
      "default": "Liu Jo World"
    },
    {
      "type": "link_list",
      "id": "col_2_menu",
      "label": "Column 2 Menu"
    },
    {
      "type": "text",
      "id": "col_3_title",
      "label": "Column 3 Title",
      "default": "Liu Jo for you"
    },
    {
      "type": "link_list",
      "id": "col_3_menu",
      "label": "Column 3 Menu"
    },
    {
      "type": "text",
      "id": "col_4_title",
      "label": "Column 4 Title",
      "default": "Corporate"
    },
    {
      "type": "link_list",
      "id": "col_4_menu",
      "label": "Column 4 Menu"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2026 Digital Boite s.r.l. All Rights Reserved. P.IVA and C.F. 03796760365. Liu Jo Official Store."
    }
  ]
}
{% endschema %}
