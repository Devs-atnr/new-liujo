<section id="CustomerCareHub-{{ section.id }}" class="cch">
  <div class="cch__layout">
    <aside class="cch__sidebar" aria-label="Customer care navigation">
      <div class="cch__group"><h2>{{ section.settings.profile_heading | escape }}</h2><nav>
        {% for block in section.blocks %}{% if block.type == 'tab' and block.settings.group == 'profile' %}
          {% assign tab_url = block.settings.page.url | default: block.settings.custom_url %}{% assign active_tab = false %}
          {% if block.settings.page != blank and page.handle == block.settings.page.handle %}{% assign active_tab = true %}{% elsif request.path == tab_url %}{% assign active_tab = true %}{% endif %}
          {% if block.settings.label != blank %}<a class="cch__link{% if active_tab %} is-active{% endif %}" href="{{ tab_url | default: '#' }}" {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span><span aria-hidden="true">→</span></a>{% endif %}
        {% endif %}{% endfor %}
      </nav></div>
      <div class="cch__group"><h2>{{ section.settings.care_heading | escape }}</h2><nav>
        {% for block in section.blocks %}{% if block.type == 'tab' and block.settings.group == 'care' %}
          {% assign tab_url = block.settings.page.url | default: block.settings.custom_url %}{% assign active_tab = false %}
          {% if block.settings.page != blank and page.handle == block.settings.page.handle %}{% assign active_tab = true %}{% elsif request.path == tab_url %}{% assign active_tab = true %}{% endif %}
          {% if block.settings.label != blank %}<a class="cch__link{% if active_tab %} is-active{% endif %}" href="{{ tab_url | default: '#' }}" {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span><span aria-hidden="true">→</span></a>{% endif %}
        {% endif %}{% endfor %}
      </nav></div>
      {% if section.settings.show_contact %}<div class="cch__contact"><h2>{{ section.settings.contact_heading | escape }}</h2>{% if section.settings.phone != blank %}<a href="tel:{{ section.settings.phone | remove: ' ' | escape }}">☎ <span>{{ section.settings.phone | escape }}</span></a>{% endif %}{% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email | escape }}">✉ <span>{{ section.settings.email_link_label | escape }}</span></a>{% endif %}</div>{% endif %}
      {% if section.settings.legal_menu != blank %}<div class="cch__contact"><h2>{{ section.settings.legal_heading | escape }}</h2>{% for link in section.settings.legal_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div>{% endif %}
    </aside>
    <main class="cch__main">
      <header class="cch__banner"><h1>{{ section.settings.banner_heading | escape }}</h1></header>
      {% case section.settings.page_type %}
        {% when 'order' %}
          <h2>{{ section.settings.content_heading | escape }}</h2><div class="cch__body rte">{{ section.settings.description }}</div>
          <form class="cch__form" action="{{ section.settings.tracking_url | default: routes.root_url }}" method="get">
            <label>{{ section.settings.order_label | escape }}<input name="{{ section.settings.order_param | escape }}" placeholder="{{ section.settings.order_placeholder | escape }}" required autocomplete="off"></label>
            <label>{{ section.settings.email_label | escape }}<input type="email" name="{{ section.settings.email_param | escape }}" placeholder="{{ section.settings.email_placeholder | escape }}" required autocomplete="email"></label>
            <button type="submit">{{ section.settings.submit_label | escape }}</button>
          </form>
        {% when 'returns' %}
          <h2>{{ section.settings.content_heading | escape }}</h2><div class="cch__body rte">{{ section.settings.description }}</div>
          <div class="cch__accordions">{% for block in section.blocks %}{% if block.type == 'returns_accordion' %}<details class="cch__accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}<span aria-hidden="true">＋</span></summary><div class="cch__accordion-body">{{ block.settings.content }}</div></details>{% endif %}{% endfor %}</div>
          {% if section.settings.returns_url != blank %}<a class="cch__button-link" href="{{ section.settings.returns_url }}">{{ section.settings.returns_button | escape }}</a>{% endif %}
        {% when 'size-guide' %}
          <div class="cch__size" id="CCHSize-{{ section.id }}">
            <label class="visually-hidden" for="CCHSizeSelect-{{ section.id }}">{{ section.settings.size_dropdown_label | escape }}</label>
            <select id="CCHSizeSelect-{{ section.id }}" class="cch__select" data-size-select>{% for block in section.blocks %}{% if block.type == 'size_category' %}<option value="{{ block.id }}">{{ block.settings.category | escape }}</option>{% endif %}{% endfor %}</select>
            {% for block in section.blocks %}{% if block.type == 'size_category' %}<div class="cch__size-panel" data-size-panel="{{ block.id }}" hidden {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: block.settings.category }}{% endif %}<div class="cch__html">{{ block.settings.content }}</div></div>{% endif %}{% endfor %}
            {% if section.settings.size_reference != blank %}<p><a href="{{ section.settings.size_reference }}" target="_blank" rel="noopener">{{ section.settings.size_reference_label | escape }}</a></p>{% endif %}
            <div class="cch__body rte">{{ section.settings.description }}</div>
          </div>
        {% when 'wishlist' %}
          <div class="cch__products">{% assign wishlist_count = 0 %}{% for block in section.blocks %}{% if block.type == 'wishlist_product' and block.settings.product != blank %}{% assign wishlist_count = wishlist_count | plus: 1 %}<a class="cch__product" href="{{ block.settings.product.url }}" {{ block.shopify_attributes }}>{% if block.settings.product.featured_image %}{{ block.settings.product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.product.title }}{% endif %}<strong>{{ block.settings.product.title | escape }}</strong><span>{{ block.settings.product.price | money }}</span></a>{% endif %}{% endfor %}{% if wishlist_count == 0 %}<p>{{ section.settings.empty_message | escape }}</p>{% endif %}</div>
      {% endcase %}
    </main>
  </div>
</section>
<style>
#CustomerCareHub-{{ section.id }}{color:#090909}.cch__layout{display:grid;grid-template-columns:minmax(240px,.82fr) minmax(0,1.6fr);gap:clamp(24px,3.6vw,48px);max-width:{{ section.settings.max_width }}px;margin:auto;padding:40px 24px}.cch__group{margin-bottom:30px}.cch__group h2,.cch__contact h2{margin:0;padding:12px 20px;background:#4b4b4b;color:#fff;font-size:15px;text-transform:uppercase}.cch__group nav{border:1px solid #dedede;border-top:0}.cch__link{min-height:51px;padding:12px 18px 12px 20px;display:flex;justify-content:space-between;align-items:center;gap:14px;border-bottom:1px solid #dedede;background:#fff;color:#080808;text-decoration:none;font-size:14px;font-weight:600;text-transform:uppercase}.cch__link:last-child{border-bottom:0}.cch__link:hover,.cch__link.is-active{background:#000;color:#fff}.cch__link span+span{font-size:25px;font-weight:300}.cch__contact{margin:30px 0}.cch__contact h2{margin-bottom:0}.cch__contact a{display:block;padding:15px 20px;border-top:1px solid #dedede;color:inherit;text-decoration:none}.cch__banner{display:flex;align-items:center;justify-content:center;min-height:140px;margin-bottom:26px;padding:24px;background:#f6f7f8;text-align:center}.cch__banner h1{margin:0;font-size:clamp(22px,2vw,28px);font-weight:500;text-transform:uppercase}.cch__main>h2{font-size:16px;text-transform:uppercase}.cch__body{font-size:14px;line-height:1.55}.cch__form{margin-top:26px;display:grid;grid-template-columns:1fr 1fr;gap:18px 14px}.cch__form label{display:grid;gap:8px;font-size:12px;text-transform:uppercase}.cch__form input{height:50px;border:1px solid #d5d5d5;padding:10px;font:inherit}.cch__form button,.cch__button-link{grid-column:1;min-height:52px;margin-top:10px;border:0;background:#000;color:#fff;font:inherit;font-weight:600;text-transform:uppercase;cursor:pointer;text-align:center;text-decoration:none;padding:16px}.cch__accordion{border-top:1px solid #dedede}.cch__accordion:last-child{border-bottom:1px solid #dedede}.cch__accordion summary{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:18px 0;cursor:pointer;list-style:none;font-weight:600;text-transform:uppercase}.cch__accordion summary::-webkit-details-marker{display:none}.cch__accordion-body{padding:0 0 20px}.cch__accordion-body img{max-width:100%;height:auto}.cch__select{width:100%;min-height:48px;margin:0 0 24px;padding:10px;border:1px solid #d5d5d5;background:#fff;font:inherit;text-transform:uppercase}.cch__size-panel img{max-width:100%;height:auto;display:block;margin:18px 0}.cch__html{font-size:14px;line-height:1.55}.cch__html table{width:100%;border-collapse:collapse}.cch__html th,.cch__html td{border:1px solid #dedede;padding:10px;text-align:center}.cch__products{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:20px}.cch__product{color:inherit;text-decoration:none}.cch__product img{width:100%;height:auto;display:block;margin-bottom:10px}.cch__product strong,.cch__product span{display:block;margin-top:5px}@media(max-width:749px){.cch__layout{grid-template-columns:1fr;gap:28px;padding:24px 16px}.cch__banner{min-height:100px}.cch__form{grid-template-columns:1fr}.cch__form button{grid-column:1}}
</style>
<script>
(()=>{const root=document.getElementById('CCHSize-{{ section.id }}');if(!root)return;const select=root.querySelector('[data-size-select]');const panels=[...root.querySelectorAll('[data-size-panel]')];if(!select||!panels.length)return;const update=()=>panels.forEach(panel=>{panel.hidden=panel.dataset.sizePanel!==select.value});select.addEventListener('change',update);update()})();
</script>
{% schema %}
{"name":"Customer care combined","settings":[{"type":"select","id":"page_type","label":"Right side page content","options":[{"value":"order","label":"Order tracking"},{"value":"returns","label":"Returns and exchanges"},{"value":"wishlist","label":"Wishlist"},{"value":"size-guide","label":"Size guide"}],"default":"order"},{"type":"text","id":"profile_heading","label":"Profile heading","default":"Your profile"},{"type":"text","id":"care_heading","label":"Customer care heading","default":"Customer care"},{"type":"checkbox","id":"show_contact","label":"Show contact details","default":true},{"type":"text","id":"contact_heading","label":"Contact heading","default":"Can we help you?"},{"type":"text","id":"phone","label":"Phone","default":"+44 330 8087718"},{"type":"text","id":"email","label":"Email","default":"hello@example.com"},{"type":"text","id":"email_link_label","label":"Email link text","default":"Send us an e-mail"},{"type":"link_list","id":"legal_menu","label":"Privacy and legal menu"},{"type":"text","id":"legal_heading","label":"Legal heading","default":"Privacy information"},{"type":"text","id":"banner_heading","label":"Banner heading","default":"Monitor your order"},{"type":"text","id":"content_heading","label":"Content heading","default":"Monitor your order"},{"type":"richtext","id":"description","label":"Description","default":"<p>Monitor your order, even if you are not a registered user. Enter the order number and email address used to place it.</p>"},{"type":"url","id":"tracking_url","label":"Tracking service URL"},{"type":"text","id":"order_label","label":"Order number field label","default":"Order number"},{"type":"text","id":"order_placeholder","label":"Order number placeholder","default":"Enter your order number"},{"type":"text","id":"order_param","label":"Order query parameter","default":"order"},{"type":"text","id":"email_label","label":"Email field label","default":"Order email"},{"type":"text","id":"email_placeholder","label":"Email placeholder","default":"Enter your order email"},{"type":"text","id":"email_param","label":"Email query parameter","default":"email"},{"type":"text","id":"submit_label","label":"Submit button text","default":"Submit"},{"type":"url","id":"returns_url","label":"Returns portal URL"},{"type":"text","id":"returns_button","label":"Returns portal button","default":"Start a return"},{"type":"text","id":"size_dropdown_label","label":"Size dropdown label","default":"Select a size category"},{"type":"url","id":"size_reference","label":"Official size guide link"},{"type":"text","id":"size_reference_label","label":"Official size guide link text","default":"Open official size guide"},{"type":"text","id":"empty_message","label":"Empty wishlist message","default":"Your wishlist is empty"},{"type":"range","id":"max_width","label":"Maximum width","min":900,"max":1800,"step":50,"unit":"px","default":1500}],"blocks":[{"type":"tab","name":"Tab","settings":[{"type":"select","id":"group","label":"Menu heading","options":[{"value":"profile","label":"Your profile"},{"value":"care","label":"Customer care"}],"default":"care"},{"type":"text","id":"label","label":"Tab name","default":"New tab"},{"type":"page","id":"page","label":"Page to open"},{"type":"url","id":"custom_url","label":"Custom URL (optional)"}]},{"type":"returns_accordion","name":"Returns accordion","settings":[{"type":"text","id":"title","label":"Accordion title","default":"Return and size exchange procedure"},{"type":"html","id":"content","label":"Accordion HTML content"}]},{"type":"size_category","name":"Size category","settings":[{"type":"text","id":"category","label":"Category name","default":"Woman"},{"type":"html","id":"content","label":"Custom HTML size content"},{"type":"image_picker","id":"image","label":"Size chart image (optional)"}]},{"type":"wishlist_product","name":"Wishlist product","settings":[{"type":"product","id":"product","label":"Choose product"}]}],"max_blocks":50,"presets":[{"name":"Customer care combined","blocks":[{"type":"tab","settings":{"group":"profile","label":"Log in","custom_url":"/account/login"}},{"type":"tab","settings":{"group":"profile","label":"Create account","custom_url":"/account/register"}},{"type":"tab","settings":{"group":"profile","label":"Monitor your order","custom_url":"/pages/monitor-your-order"}},{"type":"tab","settings":{"group":"profile","label":"Online exchanges and returns","custom_url":"/pages/online-exchanges-and-returns"}},{"type":"tab","settings":{"group":"profile","label":"Wishlist","custom_url":"/pages/wishlist"}},{"type":"tab","settings":{"group":"care","label":"Orders and shipments","custom_url":"/pages/orders-and-shipments"}},{"type":"tab","settings":{"group":"care","label":"Payments","custom_url":"/pages/payments"}},{"type":"tab","settings":{"group":"care","label":"Refunds and returns","custom_url":"/pages/refunds-and-returns"}},{"type":"tab","settings":{"group":"care","label":"Size guide","custom_url":"/pages/size-guide"}},{"type":"tab","settings":{"group":"care","label":"FAQ","custom_url":"/pages/faq"}}]}]}
{% endschema %}

