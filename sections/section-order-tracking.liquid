<section id="CustomerCare-{{ section.id }}" class="care-tabs">
  <div class="care-tabs__layout">
    <aside class="care-tabs__side" aria-label="Customer care navigation">
      <div class="care-tabs__group"><h2>{{ section.settings.profile_heading | escape }}</h2><nav>
        {% for block in section.blocks %}{% if block.settings.group == 'profile' %}
          {% assign tab_url = block.settings.page.url | default: block.settings.custom_url %}{% assign tab_active = false %}
          {% if block.settings.page != blank and page.handle == block.settings.page.handle %}{% assign tab_active = true %}{% elsif request.path == tab_url %}{% assign tab_active = true %}{% endif %}
          {% if block.settings.label != blank %}<a class="care-tabs__link {% if tab_active %}is-active{% endif %}" href="{{ tab_url | default: '#' }}" {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span><span aria-hidden="true">→</span></a>{% endif %}
        {% endif %}{% endfor %}
      </nav></div>
      <div class="care-tabs__group"><h2>{{ section.settings.care_heading | escape }}</h2><nav>
        {% for block in section.blocks %}{% if block.settings.group == 'care' %}
          {% assign tab_url = block.settings.page.url | default: block.settings.custom_url %}{% assign tab_active = false %}
          {% if block.settings.page != blank and page.handle == block.settings.page.handle %}{% assign tab_active = true %}{% elsif request.path == tab_url %}{% assign tab_active = true %}{% endif %}
          {% if block.settings.label != blank %}<a class="care-tabs__link {% if tab_active %}is-active{% endif %}" href="{{ tab_url | default: '#' }}" {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span><span aria-hidden="true">→</span></a>{% endif %}
        {% endif %}{% endfor %}
      </nav></div>
      {% if section.settings.show_contact %}<div class="care-tabs__contact"><h2>{{ section.settings.contact_heading | escape }}</h2>{% if section.settings.phone != blank %}<a href="tel:{{ section.settings.phone | remove: ' ' | escape }}">☎ <span>{{ section.settings.phone | escape }}</span></a>{% endif %}{% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email | escape }}">✉ <span>{{ section.settings.email_label | escape }}</span></a>{% endif %}</div>{% endif %}
      {% if section.settings.legal_menu != blank %}<div class="care-tabs__contact"><h2>{{ section.settings.legal_heading | escape }}</h2>{% for link in section.settings.legal_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div>{% endif %}
    </aside>
    <main class="care-tabs__main"><header class="care-tabs__banner"><h1>{{ section.settings.content_heading | escape }}</h1></header>
      <h2>{{ section.settings.content_heading | escape }}</h2><div class="care-tabs__body rte">{{ section.settings.description }}</div>
      <form class="care-tabs__form" action="{{ section.settings.service_url | default: routes.root_url }}" method="get">
        <label>{{ section.settings.order_label | escape }}<input name="{{ section.settings.order_param | escape }}" required autocomplete="off"></label>
        <label>{{ section.settings.email_label | escape }}<input type="email" name="{{ section.settings.email_param | escape }}" required autocomplete="email"></label>
        <button type="submit">{{ section.settings.submit_label | escape }}</button>
      </form>
    </main>
  </div>
</section>
<style>
#CustomerCare-{{ section.id }}{color:#090909}.care-tabs__layout{display:grid;grid-template-columns:minmax(240px,.82fr) minmax(0,1.6fr);gap:clamp(24px,3.6vw,48px);max-width:{{ section.settings.max_width }}px;margin:auto;padding:40px 24px}.care-tabs__group h2{margin:0;padding:12px 20px;background:#4b4b4b;color:#fff;font-size:15px;text-transform:uppercase}.care-tabs__group nav{border:1px solid #dedede;border-top:0}.care-tabs__link{width:100%;min-height:51px;padding:12px 18px 12px 20px;display:flex;justify-content:space-between;align-items:center;gap:14px;border-bottom:1px solid #dedede;background:#fff;color:#080808;text-decoration:none;font-size:14px;font-weight:600;text-transform:uppercase}.care-tabs__link:last-child{border-bottom:0}.care-tabs__link:hover,.care-tabs__link.is-active{background:#000;color:#fff}.care-tabs__link span+span{font-size:25px;font-weight:300}.care-tabs__contact{margin:30px 0}.care-tabs__contact h2{margin:0 0 24px;padding-left:20px;font-size:15px;text-transform:uppercase}.care-tabs__contact a{display:block;padding:15px 20px;border-top:1px solid #dedede;color:inherit;text-decoration:none}.care-tabs__banner{display:flex;align-items:center;justify-content:center;min-height:140px;margin-bottom:26px;padding:24px;background:#f6f7f8;text-align:center}.care-tabs__banner h1{margin:0;font-size:clamp(22px,2vw,28px);font-weight:500;text-transform:uppercase}.care-tabs__main h2{font-size:16px;text-transform:uppercase}.care-tabs__body{font-size:14px;line-height:1.55}.care-tabs__form{margin-top:26px;display:grid;grid-template-columns:1fr 1fr;gap:18px 14px}.care-tabs__form label{display:grid;gap:8px;font-size:12px;text-transform:uppercase}.care-tabs__form input{height:50px;border:1px solid #d5d5d5;padding:10px;font:inherit}.care-tabs__form button{grid-column:1;min-height:52px;margin-top:10px;border:0;background:#000;color:#fff;font:inherit;font-weight:600;text-transform:uppercase;cursor:pointer}.care-tabs__notice{padding:16px;background:#f6f7f8}.care-tabs__wishlist{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:20px}.care-tabs__product{color:inherit;text-decoration:none}.care-tabs__product img{width:100%;height:auto;display:block;margin-bottom:10px}.care-tabs__product strong,.care-tabs__product span{display:block;margin-top:5px}@media(max-width:749px){.care-tabs__layout{grid-template-columns:1fr;gap:28px;padding:24px 16px}.care-tabs__banner{min-height:100px}.care-tabs__form{grid-template-columns:1fr}.care-tabs__form button{grid-column:1}}
</style>

{% schema %}
{
  "name": "Monitor your order",
  "settings": [
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Privacy and legal menu"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show contact details",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Can we help you?"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+44 330 8087718"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@example.com"
    },
    {
      "type": "text",
      "id": "email_link_label",
      "label": "Email link text",
      "default": "Send us an e-mail"
    },
    {
      "type": "text",
      "id": "legal_heading",
      "label": "Legal heading",
      "default": "Privacy information"
    },
    {
      "type": "text",
      "id": "profile_heading",
      "label": "Profile menu heading",
      "default": "Your profile"
    },
    {
      "type": "text",
      "id": "care_heading",
      "label": "Customer care menu heading",
      "default": "Customer care"
    },
    {
      "type": "text",
      "id": "content_heading",
      "label": "Content heading",
      "default": "MONITOR YOUR ORDER"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Monitor your order, even if you are not a registered user. Enter the order number and email address used to place it.</p>"
    },
    {
      "type": "url",
      "id": "service_url",
      "label": "Tracking or returns service URL"
    },
    {
      "type": "text",
      "id": "portal_note",
      "label": "Returns portal note",
      "default": "Add your returns portal URL in this section's settings to enable the return form."
    },
    {
      "type": "text",
      "id": "order_label",
      "label": "Order field label",
      "default": "Order number"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email field label",
      "default": "Order email"
    },
    {
      "type": "text",
      "id": "order_param",
      "label": "Order query parameter",
      "default": "order"
    },
    {
      "type": "text",
      "id": "email_param",
      "label": "Email query parameter",
      "default": "email"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button",
      "default": "Submit"
    },
    {
      "type": "text",
      "id": "wishlist_key",
      "label": "Wishlist local storage key",
      "default": "wishlist"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty wishlist message",
      "default": "There are no products"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content width",
      "min": 900,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1500
    }
  ],
  "presets": [
    {
      "name": "Customer care - Monitor your order",
      "blocks": [
        {
          "settings": {
            "custom_url": "/account/login",
            "group": "profile",
            "label": "Log in"
          },
          "type": "tab"
        },
        {
          "settings": {
            "custom_url": "/account/register",
            "group": "profile",
            "label": "Create account"
          },
          "type": "tab"
        },
        {
          "settings": {
            "label": "Monitor your order",
            "group": "care"
          },
          "type": "tab"
        },
        {
          "settings": {
            "label": "Online exchanges and returns",
            "group": "care"
          },
          "type": "tab"
        },
        {
          "settings": {
            "label": "Wishlist",
            "group": "care"
          },
          "type": "tab"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "select",
          "id": "group",
          "label": "Menu heading",
          "options": [
            {
              "value": "profile",
              "label": "Your profile"
            },
            {
              "value": "care",
              "label": "Customer care"
            }
          ],
          "default": "care"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tab name",
          "default": "New tab"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page to open"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom URL (optional)"
        }
      ]
    }
  ],
  "max_blocks": 30
}
{% endschema %}






