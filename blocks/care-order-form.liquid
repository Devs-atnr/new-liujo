<div data-care-content="order" {{ block.shopify_attributes }}>{% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}{% if block.settings.description != blank %}<div>{{ block.settings.description }}</div>{% endif %}<form class="care-hub__form" action="{{ block.settings.action_url | default: routes.root_url }}" method="get"><div class="care-hub__field"><label for="CareOrder-{{ block.id }}">{{ block.settings.order_label | escape }}</label><input id="CareOrder-{{ block.id }}" name="{{ block.settings.order_param | escape }}" placeholder="{{ block.settings.order_placeholder | escape }}" required></div><div class="care-hub__field"><label for="CareEmail-{{ block.id }}">{{ block.settings.email_label | escape }}</label><input id="CareEmail-{{ block.id }}" type="email" name="{{ block.settings.email_param | escape }}" placeholder="{{ block.settings.email_placeholder | escape }}" required></div><button class="care-hub__submit" type="submit">{{ block.settings.button_label | escape }}</button></form></div>
{% schema %}{"name":"Order tracking form","settings":[{"type":"text","id":"heading","label":"Form heading","default":"Monitor your order"},{"type":"richtext","id":"description","label":"Description","default":"<p>Enter your order number and email address used to place it.</p>"},{"type":"url","id":"action_url","label":"Tracking service URL"},{"type":"text","id":"order_label","label":"Order number label","default":"Order number"},{"type":"text","id":"order_placeholder","label":"Order number placeholder","default":"Enter your order number"},{"type":"text","id":"order_param","label":"Order number parameter","default":"order_number"},{"type":"text","id":"email_label","label":"Email label","default":"Order email"},{"type":"text","id":"email_placeholder","label":"Email placeholder","default":"Enter your order email"},{"type":"text","id":"email_param","label":"Email parameter","default":"email"},{"type":"text","id":"button_label","label":"Button label","default":"Submit"}],"presets":[{"name":"Order tracking form"}]}{% endschema %}
