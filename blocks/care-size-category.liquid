<div data-care-content="size" {{ block.shopify_attributes }}><label for="CareSize-{{ block.id }}">{{ block.settings.dropdown_label | escape }}</label><select class="care-hub__size-select" id="CareSize-{{ block.id }}" data-size-select><option value="">{{ block.settings.dropdown_label | escape }}</option><option value="size-{{ block.id }}">{{ block.settings.category_name | escape }}</option></select><div class="care-hub__size-panel" data-size-panel data-size-id="size-{{ block.id }}"><h3>{{ block.settings.category_name | escape }}</h3>{{ block.settings.html }}{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}{% endif %}</div></div>
{% schema %}{"name":"Size category","settings":[{"type":"text","id":"dropdown_label","label":"Dropdown label","default":"Select a size guide"},{"type":"text","id":"category_name","label":"Category name","default":"T-shirts and tops"},{"type":"html","id":"html","label":"Size chart HTML","default":"<p>Paste your size chart table or custom HTML here.</p>"},{"type":"image_picker","id":"image","label":"Optional size guide image"}],"presets":[{"name":"Size category"}]}{% endschema %}
