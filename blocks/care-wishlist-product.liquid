<div class="care-hub__product" data-care-content="wishlist" {{ block.shopify_attributes }}>{% if block.settings.product != blank %}<a href="{{ block.settings.product.url }}">{{ block.settings.product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.product.title }}<h3>{{ block.settings.product.title | escape }}</h3><span>{{ block.settings.product.price | money }}</span></a>{% else %}<p>{{ block.settings.empty_text | escape }}</p>{% endif %}</div>
{% schema %}{"name":"Wishlist product","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"empty_text","label":"Empty wishlist text","default":"There are no products"}],"presets":[{"name":"Wishlist product"}]}{% endschema %}
