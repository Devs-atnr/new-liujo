<!-- Liu Jo Share Modal Popup (Screenshot 3 Parity) -->
<div id="LiuJoShareModal" class="liujo-share-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="liujo-share-modal-backdrop" data-liujo-share-modal-close></div>
  <div class="liujo-share-modal-card">
    <button type="button" class="liujo-share-modal-close" data-liujo-share-modal-close aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <h3 class="liujo-share-modal-title">Copy Link</h3>

    <div class="liujo-share-input-group">
      <input
        type="text"
        id="LiuJoShareUrlInput"
        class="liujo-share-url-input"
        readonly
        value=""
        onclick="this.select()"
      >
      <button type="button" id="LiuJoShareCopyBtn" class="liujo-share-copy-btn" aria-label="Copy Link">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span class="liujo-share-copy-toast" id="LiuJoShareCopyToast">Copied!</span>
      </button>
    </div>

    <h4 class="liujo-share-social-title">Share</h4>

    <div class="liujo-share-social-row">
      <!-- Facebook -->
      <a href="#" target="_blank" rel="noopener noreferrer" class="liujo-share-social-btn liujo-share-btn--fb" data-share-channel="facebook" title="Share on Facebook" aria-label="Facebook">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
        </svg>
      </a>

      <!-- X / Twitter -->
