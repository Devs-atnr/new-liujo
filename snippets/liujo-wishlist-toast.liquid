{% comment %}
  LIU JO WISHLIST TOAST NOTIFICATION
  Sleek floating feedback when products are added/removed from wishlist.
{% endcomment %}

<div id="LiuJoWishlistToast" class="liujo-wishlist-toast" aria-live="polite" aria-hidden="true">
  <div class="liujo-wishlist-toast__content">
    <div class="liujo-wishlist-toast__img-wrap" id="LiuJoToastImgWrap" style="display:none;">
      <img id="LiuJoToastImg" src="" alt="Product">
    </div>
    <div class="liujo-wishlist-toast__text">
      <div class="liujo-wishlist-toast__status" id="LiuJoToastStatus">Added to Wishlist</div>
      <div class="liujo-wishlist-toast__title" id="LiuJoToastTitle"></div>
    </div>
    <button type="button" class="liujo-wishlist-toast__btn" id="LiuJoToastViewBtn">
      VIEW
    </button>
  </div>
</div>

<style>
  .liujo-wishlist-toast {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background-color: #000000;
    color: #ffffff;
    padding: 12px 18px;
    border-radius: 4px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    z-index: 100000;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.3s ease;
    max-width: 380px;
  }

  .liujo-wishlist-toast.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .liujo-wishlist-toast__content {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .liujo-wishlist-toast__img-wrap {
    width: 38px;
    height: 48px;
    flex-shrink: 0;
    background: #222;
    overflow: hidden;
    border-radius: 2px;
  }

  .liujo-wishlist-toast__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .liujo-wishlist-toast__text {
    flex: 1;
    min-width: 0;
  }

  .liujo-wishlist-toast__status {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .liujo-wishlist-toast__title {
    font-size: 11px;
    color: #bbbbbb;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
  }

  .liujo-wishlist-toast__btn {
    background: #ffffff;
    color: #000000;
    border: none;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 2px;
    cursor: pointer;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .liujo-wishlist-toast__btn:hover {
    opacity: 0.85;
  }

  @media (max-width: 767px) {
    .liujo-wishlist-toast {
      bottom: 20px;
      right: 15px;
      left: 15px;
      max-width: calc(100% - 30px);
    }
  }
</style>
