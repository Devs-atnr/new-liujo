<!-- Liu Jo Luxury Real-Time Predictive Search Drawer (Auto gets tabs from Header Menu) -->
{%- assign search_nav = header_menu -%}
{%- if search_nav == blank or search_nav.links.size == 0 -%}
  {%- assign search_nav = linklists['main-menu'] -%}
{%- endif -%}

<div class="liujo-search-backdrop" data-liujo-search-backdrop></div>

<div 
  class="liujo-search-drawer" 
  data-liujo-search-drawer 
  data-search-url="{{ routes.search_url }}"
  data-predictive-url="{{ routes.predictive_search_url }}"
  data-currency-symbol="{{ cart.currency.symbol | default: '€' }}"
  role="dialog" 
  aria-modal="true" 
  aria-label="Search"
>
  <div class="liujo-search-drawer__inner">
    <!-- Top Search Bar: Large Input + Actions -->
    <div class="liujo-search-bar">
      <form action="{{ routes.search_url }}" method="get" role="search" class="liujo-search-bar__form" data-liujo-search-form>
        <input 
          type="search" 
          name="q" 
          class="liujo-search-bar__input" 
          placeholder="SEARCH" 
          autocomplete="off" 
          autocorrect="off" 
          autocapitalize="characters" 
          spellcheck="false" 
          data-liujo-search-input
          aria-label="Search Store"
        >
        <input type="hidden" name="options[prefix]" value="last">
      </form>

      <div class="liujo-search-bar__actions">
        <!-- Clear "X" Button (shown when query typed, matching SS2) -->
        <button type="button" class="liujo-search-bar__clear" data-liujo-search-clear aria-label="Clear Search text">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <span class="liujo-search-bar__divider" data-liujo-search-clear-divider></span>

        <!-- Close Button (text button, matching SS1 & SS2) -->
        <button type="button" class="liujo-search-bar__close" data-liujo-search-close aria-label="Close search">
          CLOSE
        </button>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="liujo-search-content">
      <!-- 1. STATE 1: BEFORE SEARCH (Auto Header Menu Tabs + Suggestions & New In) -->
      <div class="liujo-search-before" data-liujo-search-before>
        <!-- Category Switcher Tabs -->
        <div class="liujo-search-tabs">
          {%- if search_nav != blank and search_nav.links.size > 0 -%}
            {%- for tab_link in search_nav.links -%}
              {%- assign tab_handle = tab_link.handle | default: tab_link.title | handleize -%}
              <button 
                type="button" 
                class="liujo-search-tab{% if forloop.first %} is-active{% endif %}" 
                data-search-tab="{{ tab_handle }}"
                data-search-tab-name="{{ tab_link.title | escape }}">
                {{ tab_link.title | upcase }}
              </button>
              {%- unless forloop.last -%}
                <span class="liujo-search-tab-divider">|</span>
              {%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            <button type="button" class="liujo-search-tab is-active" data-search-tab="women" data-search-tab-name="Women">WOMEN</button>
            <span class="liujo-search-tab-divider">|</span>
            <button type="button" class="liujo-search-tab" data-search-tab="men" data-search-tab-name="Men">MEN</button>
            <span class="liujo-search-tab-divider">|</span>
            <button type="button" class="liujo-search-tab" data-search-tab="kids" data-search-tab-name="Kids">KIDS</button>
          {%- endif -%}
        </div>

        <!-- Panels for each Category Tab (Always SUGGESTIONS & NEW IN columns) -->
        {%- if search_nav != blank and search_nav.links.size > 0 -%}
          {%- for tab_link in search_nav.links -%}
            {%- assign tab_handle = tab_link.handle | default: tab_link.title | handleize -%}
            {%- assign lower_tab = tab_handle | downcase -%}

            <div class="liujo-search-panel{% if forloop.first %} is-active{% endif %}" data-search-panel="{{ tab_handle }}"{% unless forloop.first %} style="display: none;"{% endunless %}>
              <div class="liujo-search-panel__cols">
                {%- assign new_in_child = blank -%}
                {%- if tab_link.links.size > 0 -%}
                  {%- for child in tab_link.links -%}
                    {%- assign c_title = child.title | downcase -%}
                    {%- if c_title contains 'new' or c_title contains 'novit' or c_title contains 'arrival' -%}
                      {%- assign new_in_child = child -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}

                <!-- Column 1: SUGGESTIONS -->
                <div class="liujo-search-panel__col">
                  <div class="liujo-search-panel__heading">SUGGESTIONS</div>
                  <ul class="liujo-search-panel__list">
                    {%- assign sug_rendered = 0 -%}
                    {%- if tab_link.links.size > 0 -%}
                      {%- for child in tab_link.links -%}
                        {%- if child != new_in_child and sug_rendered < 4 -%}
                          {%- assign child_url = child.url -%}
                          {%- if child_url == blank or child_url == '#' -%}
                            {%- assign child_url = routes.search_url | append: '?q=' | append: tab_link.title | append: '+' | append: child.title | url_encode -%}
                          {%- endif -%}
                          <li>
                            <a href="{{ child_url }}" class="liujo-search-link">
                              {%- if child.title contains tab_link.title -%}
                                {{ child.title }}
                              {%- else -%}
                                {{ tab_link.title }}'s {{ child.title }}
                              {%- endif -%}
                            </a>
                          </li>
                          {%- assign sug_rendered = sug_rendered | plus: 1 -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}

                    {%- if sug_rendered == 0 -%}
                      {%- if lower_tab contains 'men' and lower_tab != 'women' -%}
                        <li><a href="{{ routes.search_url }}?q=Men%27s+Sneakers" class="liujo-search-link">Men's Sneakers</a></li>
                        <li><a href="{{ routes.search_url }}?q=Men%27s+Jeans" class="liujo-search-link">Men's Jeans</a></li>
                        <li><a href="{{ routes.search_url }}?q=Men%27s+Jackets" class="liujo-search-link">Men's Jackets</a></li>
                      {%- elsif lower_tab contains 'kid' -%}
                        <li><a href="{{ routes.search_url }}?q=Baby+Clothing" class="liujo-search-link">Baby Clothing</a></li>
                        <li><a href="{{ routes.search_url }}?q=Kids+Shoes" class="liujo-search-link">Kids Shoes</a></li>
                        <li><a href="{{ routes.search_url }}?q=Girls+Dresses" class="liujo-search-link">Girls Dresses</a></li>
                      {%- elsif lower_tab contains 'women' -%}
                        <li><a href="{{ routes.search_url }}?q=Women%27s+Bag" class="liujo-search-link">Women's Bag</a></li>
                        <li><a href="{{ routes.search_url }}?q=Women%27s+Jeans" class="liujo-search-link">Women's Jeans</a></li>
                        <li><a href="{{ routes.search_url }}?q=Women%27s+Shoes" class="liujo-search-link">Women's Shoes</a></li>
                      {%- else -%}
                        <li><a href="{{ routes.search_url }}?q={{ tab_link.title | url_encode }}+Bag" class="liujo-search-link">{{ tab_link.title }}'s Bag</a></li>
                        <li><a href="{{ routes.search_url }}?q={{ tab_link.title | url_encode }}+Jeans" class="liujo-search-link">{{ tab_link.title }}'s Jeans</a></li>
                        <li><a href="{{ routes.search_url }}?q={{ tab_link.title | url_encode }}+Shoes" class="liujo-search-link">{{ tab_link.title }}'s Shoes</a></li>
                      {%- endif -%}
                    {%- endif -%}
                  </ul>
                </div>

                <!-- Column 2: NEW IN -->
                <div class="liujo-search-panel__col">
                  <div class="liujo-search-panel__heading">NEW IN</div>
                  <ul class="liujo-search-panel__list">
                    {%- if new_in_child != blank -%}
                      {%- assign new_url = new_in_child.url -%}
                      {%- if new_url == blank or new_url == '#' -%}
                        {%- assign new_url = routes.search_url | append: '?q=' | append: tab_link.title | append: '+New+Arrivals' -%}
                      {%- endif -%}
                      <li><a href="{{ new_url }}" class="liujo-search-link">{{ new_in_child.title }}</a></li>
                      {%- if new_in_child.links.size > 0 -%}
                        {%- for sub_new in new_in_child.links limit: 3 -%}
                          {%- assign sub_new_url = sub_new.url -%}
                          {%- if sub_new_url == blank or sub_new_url == '#' -%}
                            {%- assign sub_new_url = routes.search_url | append: '?q=' | append: sub_new.title | url_encode -%}
                          {%- endif -%}
                          <li><a href="{{ sub_new_url }}" class="liujo-search-link">{{ sub_new.title }}</a></li>
                        {%- endfor -%}
                      {%- endif -%}
                    {%- elsif lower_tab contains 'men' and lower_tab != 'women' -%}
                      <li><a href="{{ routes.search_url }}?q=Men%27s+New+Arrivals" class="liujo-search-link">Men's New Arrivals</a></li>
                    {%- elsif lower_tab contains 'kid' -%}
                      <li><a href="{{ routes.search_url }}?q=Kids+New+Arrivals" class="liujo-search-link">Kids New Arrivals</a></li>
                    {%- elsif lower_tab contains 'women' -%}
                      <li><a href="{{ routes.search_url }}?q=Women%27s+New+Arrivals" class="liujo-search-link">Women's New Arrivals</a></li>
                    {%- else -%}
                      <li><a href="{{ routes.search_url }}?q={{ tab_link.title | url_encode }}+New+Arrivals" class="liujo-search-link">{{ tab_link.title }}'s New Arrivals</a></li>
                    {%- endif -%}
                  </ul>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Liu Jo Fallback Panels (WOMEN, MEN, KIDS) -->
          <div class="liujo-search-panel is-active" data-search-panel="women">
            <div class="liujo-search-panel__cols">
              <div class="liujo-search-panel__col">
                <div class="liujo-search-panel__heading">SUGGESTIONS</div>
                <ul class="liujo-search-panel__list">
                  <li><a href="{{ routes.search_url }}?q=Women%27s+Bag" class="liujo-search-link">Women's Bag</a></li>
                  <li><a href="{{ routes.search_url }}?q=Women%27s+Jeans" class="liujo-search-link">Women's Jeans</a></li>
                  <li><a href="{{ routes.search_url }}?q=Women%27s+Shoes" class="liujo-search-link">Women's Shoes</a></li>
                </ul>
              </div>
              <div class="liujo-search-panel__col">
                <div class="liujo-search-panel__heading">NEW IN</div>
                <ul class="liujo-search-panel__list">
                  <li><a href="{{ routes.search_url }}?q=Women%27s+New+Arrivals" class="liujo-search-link">Women's New Arrivals</a></li>
                </ul>
              </div>
            </div>
          </div>

          <div class="liujo-search-panel" data-search-panel="men" style="display: none;">
            <div class="liujo-search-panel__cols">
              <div class="liujo-search-panel__col">
                <div class="liujo-search-panel__heading">SUGGESTIONS</div>
                <ul class="liujo-search-panel__list">
                  <li><a href="{{ routes.search_url }}?q=Men%27s+Sneakers" class="liujo-search-link">Men's Sneakers</a></li>
                  <li><a href="{{ routes.search_url }}?q=Men%27s+Jeans" class="liujo-search-link">Men's Jeans</a></li>
                  <li><a href="{{ routes.search_url }}?q=Men%27s+Jackets" class="liujo-search-link">Men's Jackets</a></li>
                </ul>
              </div>
              <div class="liujo-search-panel__col">
                <div class="liujo-search-panel__heading">NEW IN</div>
                <ul class="liujo-search-panel__list">
                  <li><a href="{{ routes.search_url }}?q=Men%27s+New+Arrivals" class="liujo-search-link">Men's New Arrivals</a></li>
                </ul>
              </div>
            </div>
          </div>

          <div class="liujo-search-panel" data-search-panel="kids" style="display: none;">
            <div class="liujo-search-panel__cols">
              <div class="liujo-search-panel__col">
                <div class="liujo-search-panel__heading">SUGGESTIONS</div>
                <ul class="liujo-search-panel__list">
                  <li><a href="{{ routes.search_url }}?q=Baby+Clothing" class="liujo-search-link">Baby Clothing</a></li>
                  <li><a href="{{ routes.search_url }}?q=Kids+Shoes" class="liujo-search-link">Kids Shoes</a></li>
                  <li><a href="{{ routes.search_url }}?q=Girls+Dresses" class="liujo-search-link">Girls Dresses</a></li>
                </ul>
              </div>
              <div class="liujo-search-panel__col">
                <div class="liujo-search-panel__heading">NEW IN</div>
                <ul class="liujo-search-panel__list">
                  <li><a href="{{ routes.search_url }}?q=Kids+New+Arrivals" class="liujo-search-link">Kids New Arrivals</a></li>
                </ul>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- 2. STATE 2: AFTER SEARCH (Real-Time Predictive Results matching SS2) -->
      <div class="liujo-search-after" data-liujo-search-after style="display: none;">
        <div class="liujo-search-after__inner">
          <!-- Left Column: Category Tabs + Suggestions For You -->
          <div class="liujo-search-after__sidebar">
            <div class="liujo-search-tabs">
              {%- if search_nav != blank and search_nav.links.size > 0 -%}
                {%- for tab_link in search_nav.links -%}
                  {%- assign tab_handle = tab_link.handle | default: tab_link.title | handleize -%}
                  <button 
                    type="button" 
                    class="liujo-search-tab{% if forloop.first %} is-active{% endif %}" 
                    data-search-after-tab="{{ tab_handle }}"
                    data-search-tab-name="{{ tab_link.title | escape }}">
                    {{ tab_link.title | upcase }}
                  </button>
                  {%- unless forloop.last -%}
                    <span class="liujo-search-tab-divider">|</span>
                  {%- endunless -%}
                {%- endfor -%}
              {%- else -%}
                <button type="button" class="liujo-search-tab is-active" data-search-after-tab="women" data-search-tab-name="Women">WOMEN</button>
                <span class="liujo-search-tab-divider">|</span>
                <button type="button" class="liujo-search-tab" data-search-after-tab="men" data-search-tab-name="Men">MEN</button>
                <span class="liujo-search-tab-divider">|</span>
                <button type="button" class="liujo-search-tab" data-search-after-tab="kids" data-search-tab-name="Kids">KIDS</button>
              {%- endif -%}
            </div>
            <div class="liujo-search-sidebar-section">
              <div class="liujo-search-panel__heading">SUGGESTIONS FOR YOU</div>
              <ul class="liujo-search-panel__list" data-liujo-search-queries-list>
                <!-- Populated dynamically via predictive search -->
              </ul>
            </div>
          </div>

          <!-- Right Column: Recommended For You & 5-Column Products Grid -->
          <div class="liujo-search-after__main">
            <div class="liujo-search-results-header">
              <div class="liujo-search-results-heading">RECOMMENDED FOR YOU</div>
              <a href="{{ routes.search_url }}" class="liujo-search-see-all" data-liujo-see-all>SEE ALL RESULTS</a>
            </div>

            <!-- Real-Time Loading Spinner -->
            <div class="liujo-search-loading" data-liujo-search-loading style="display: none;">
              <div class="liujo-search-spinner"></div>
            </div>

            <!-- Real-Time 5-Column Product Grid -->
            <div class="liujo-search-products-grid" data-liujo-search-products>
              <!-- Populated via Predictive Search AJAX -->
            </div>

            <!-- Empty State -->
            <div class="liujo-search-empty" data-liujo-search-empty style="display: none;">
              <p>No products found matching your search.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
