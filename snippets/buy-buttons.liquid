{% doc %}
  Renders a product form with add-to-cart and dynamic checkout buttons.

  @param {block} block - The buy-buttons block, whose settings control the form and whose attributes are added to the wrapper.
  @param {product} product - The product to purchase.
  @param {string} product_form_id - The product form's unique ID.
  @param {string} section_id - The section ID used to namespace the form and submit button.
  @param {boolean} [show_pickup_availability] - Whether to render pickup availability. Defaults to `false`.
  @param {object} [section] - The current section context, supplied implicitly when rendered from a section and used for IDs and pickup-availability colors.

  @example
  {% render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true %}
{% enddoc %}
<div class="product-form-block-wrapper" {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    {%- liquid
      assign gift_card_recipient_feature_active = false
      if block.settings.show_gift_card_recipient and product.gift_card?
        assign gift_card_recipient_feature_active = true
      endif

      assign show_dynamic_checkout = false
      if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
        assign show_dynamic_checkout = true
      endif
    -%}

    <product-form
      class="product-form"
      data-hide-errors="{{ gift_card_recipient_feature_active }}"
      data-section-id="{{ section.id }}"
    >
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        <span class="product-form__error-message"></span>
      </div>

      {%- assign quantity_rule_soldout = false -%}

      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          {% if product.selected_or_first_available_variant.available == false
            or quantity_rule_soldout
            or product.selected_or_first_available_variant == null
          %}
            disabled
          {% endif %}
          class="product-variant-id"
        >

        {%- if gift_card_recipient_feature_active -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
        {%- endif -%}

        {%- assign has_avail_block = false -%}
        {%- for b in section.blocks -%}
          {%- if b.type == 'availability' or b.type == 'inventory' -%}
            {%- assign has_avail_block = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- unless has_avail_block -%}
          <!-- Availability (Image 2 Parity) -->
          <div class="liujo-pdp-availability" id="LiuJoAvailability-{{ section_id }}">
            <span class="liujo-avail-label">Availability:</span>
            <span class="liujo-avail-count">
              {%- if product.selected_or_first_available_variant.available -%}
                {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                  {{ product.selected_or_first_available_variant.inventory_quantity }} In Stock
                {%- else -%}
                  In Stock
                {%- endif -%}
              {%- else -%}
                Out of Stock
              {%- endif -%}
            </span>
          </div>
        {%- endunless -%}

        <div class="product-form__buttons">
          {%- liquid
            assign check_against_inventory = true
            if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
              assign check_against_inventory = false
            endif
            if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
              assign quantity_rule_soldout = true
            endif
          -%}

          {%- liquid
            assign sel_variant = product.selected_or_first_available_variant
            assign max_qty = sel_variant.quantity_rule.max
            if sel_variant.inventory_management == 'shopify' and sel_variant.inventory_policy != 'continue'
              if sel_variant.inventory_quantity > 0
                if max_qty == null or max_qty > sel_variant.inventory_quantity
                  assign max_qty = sel_variant.inventory_quantity
                endif
              endif
            endif
          -%}

          <!-- Quantity Label & Row with Quantity Box, Heart Wishlist, and Add to Cart (Image 2 Parity) -->
          <div class="liujo-qty-label">Quantity:</div>
          <div class="liujo-pdp-cart-row">
            <!-- Quantity Box -->
            <quantity-input class="liujo-qty-box">
              <button class="quantity__button liujo-qty-btn" name="minus" type="button" aria-label="Decrease quantity">
                <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
              </button>
              <input
                class="quantity__input liujo-qty-input"
                type="number"
                name="quantity"
                id="Quantity-{{ section_id }}"
                data-min="{{ sel_variant.quantity_rule.min | default: 1 }}"
                min="{{ sel_variant.quantity_rule.min | default: 1 }}"
                {% if max_qty != null %}
                  max="{{ max_qty }}"
                {% endif %}
                data-inventory-qty="{{ sel_variant.inventory_quantity }}"
                step="{{ sel_variant.quantity_rule.increment | default: 1 }}"
                value="{{ sel_variant.quantity_rule.min | default: 1 }}"
                form="{{ product_form_id }}"
                aria-label="Quantity"
              >
              <button class="quantity__button liujo-qty-btn" name="plus" type="button" aria-label="Increase quantity">
                <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
              </button>
            </quantity-input>

            <!-- Wishlist Square Button (Heart Icon Outline) -->
            {%- if show_wishlist != false and settings.show_wishlist != false -%}
              <button
                type="button"
                class="liujo-pdp-wishlist-square"
                data-liujo-wishlist
                data-product-id="{{ product.id }}"
                aria-label="Add to Wishlist"
                title="Add to Wishlist"
              >
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
            {%- endif -%}

            <!-- ADD TO CART Button -->
            <button
              id="ProductSubmitButton-{{ section_id }}"
              type="submit"
              name="add"
              class="product-form__submit liujo-pdp-add-to-cart-btn"
              {% if product.selected_or_first_available_variant.available == false
                or quantity_rule_soldout
                or product.selected_or_first_available_variant == null
              %}
                disabled
              {% endif %}
            >
              <span>
                {%- if product.selected_or_first_available_variant == null -%}
                  {{ 'products.product.unavailable' | t }}
                {%- elsif product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                  {{ 'products.product.sold_out' | t }}
                {%- else -%}
                  ADD TO CART
                {%- endif -%}
              </span>
              {%- render 'loading-spinner' -%}
            </button>
          </div>

          <!-- BUY IT NOW Button (Image 2 Parity) -->
          <button
            type="button"
            class="liujo-pdp-buy-now-btn"
            id="LiuJoBuyNow-{{ section_id }}"
            {% if product.selected_or_first_available_variant.available == false
              or quantity_rule_soldout
              or product.selected_or_first_available_variant == null
            %}
              disabled
            {% endif %}
          >
            BUY IT NOW
          </button>
        </div>
      {%- endform -%}
    </product-form>
  {%- else -%}
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- if show_pickup_availability and block.settings.show_pickup_availability != false -%}
    {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

    {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
      | where: 'pick_up_enabled', true
    -%}

    <pickup-availability
      class="product__pickup-availabilities quick-add-hidden"
      {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
        available
      {% endif %}
      data-root-url="{{ routes.root_url }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-has-only-default-variant="{{ product.has_only_default_variant }}"
      data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
    >
      <template>
        <pickup-availability-preview class="pickup-availability-preview">
          <span class="svg-wrapper">
            {{- 'icon-unavailable.svg' | inline_asset_content -}}
          </span>
          <div class="pickup-availability-info">
            <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
            <button class="pickup-availability-button link link--text underlined-link">
              {{ 'products.product.pickup_availability.refresh' | t }}
            </button>
          </div>
        </pickup-availability-preview>
      </template>
    </pickup-availability>

    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</div>
