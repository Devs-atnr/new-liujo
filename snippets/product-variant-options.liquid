{%- doc -%}
  Renders the values for one product option as swatches, buttons, or dropdown options.

  @param {product_option} option - The product option whose values are rendered.
  @param {string} picker_type - The picker markup to render: `swatch`, `button`, `dropdown`, or `swatch_dropdown`.
  @param {block} [block] - The variant-picker block, required for swatch settings.
  @param {object} [section] - The current product section context, supplied implicitly when rendered from that section and used to namespace option inputs.

  @example
  {% render 'product-variant-options', option: option, block: block, picker_type: 'button' %}
{%- enddoc -%}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
-%}

{%- for value in option.values -%}
  {%- liquid
    assign swatch_focal_point = null
    if value.swatch.image
      assign image_url = value.swatch.image | image_url: width: 50
      assign swatch_value = 'url(' | append: image_url | append: ')'
      assign swatch_focal_point = value.swatch.image.presentation.focal_point
    elsif value.swatch.color
      assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
    else
      assign swatch_value = null
    endif

    assign option_disabled = true
    if value.available
      assign option_disabled = false
    endif
  -%}

  {%- capture input_id -%}
    {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
  {%- endcapture -%}

  {%- capture input_name -%}
    {{ option.name }}-{{ option.position }}
  {%- endcapture -%}

  {%- capture input_dataset -%}
    data-product-url="{{ value.product_url }}"
    data-option-value-id="{{ value.id }}"
    data-option-name="{{ option.name | escape }}"
  {%- endcapture -%}

  {%- capture label_unavailable -%}
    <span class="visually-hidden label-unavailable">
      {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
    </span>
  {%- endcapture -%}

  {% assign escaped_value = value | escape %}

  {%- if picker_type == 'swatch_circle' -%}
    {%- liquid
      assign swatch_color = '#111111'
      assign val_down = value | downcase
      if val_down contains 'white' or val_down contains 'bianco'
        assign swatch_color = '#ffffff'
      elsif val_down contains 'black' or val_down contains 'nero'
        assign swatch_color = '#111111'
      elsif val_down contains 'blue' or val_down contains 'denim' or val_down contains 'azzurro'
        assign swatch_color = '#436181'
      elsif val_down contains 'red' or val_down contains 'rosso' or val_down contains 'burgundy' or val_down contains 'wine'
        assign swatch_color = '#6b1724'
      elsif val_down contains 'green' or val_down contains 'verde'
        assign swatch_color = '#2e7d32'
      elsif val_down contains 'beige' or val_down contains 'camel' or val_down contains 'khaki'
        assign swatch_color = '#d4b996'
      elsif val_down contains 'brown' or val_down contains 'marrone'
        assign swatch_color = '#795548'
      elsif val_down contains 'grey' or val_down contains 'gray' or val_down contains 'grigio'
        assign swatch_color = '#9e9e9e'
      elsif val_down contains 'pink' or val_down contains 'rosa'
        assign swatch_color = '#f48fb1'
      elsif val_down contains 'yellow' or val_down contains 'giallo'
        assign swatch_color = '#fbc02d'
      elsif value.swatch.color
        assign swatch_color = 'rgb(' | append: value.swatch.color.rgb | append: ')'
      endif

      assign variant_for_val = nil
      assign val_string = value.name | default: value | escape
      for v in product.variants
        if v.option1 == val_string or v.option2 == val_string or v.option3 == val_string or v.title contains val_string or v.options contains value or v.options contains val_string
          assign variant_for_val = v
          break
        endif
      endfor

      assign swatch_img = variant_for_val.featured_media | default: variant_for_val.image | default: product.featured_media | default: product.images.first
    -%}
    <input
      type="radio"
      id="{{ input_id }}"
      name="{{ input_name | escape }}"
      value="{{ escaped_value }}"
      form="{{ product_form_id }}"
      class="liujo-swatch-radio visually-hidden"
      {% if value.selected %}checked{% endif %}
      {% if option_disabled %}class="disabled"{% endif %}
      {{ input_dataset }}
    >
    <label
      for="{{ input_id }}"
      class="liujo-swatch-circle-label"
      title="{{ value | escape }}"
      aria-label="{{ value | escape }}"
    >
      {%- if swatch_img != blank -%}
        <img
          src="{{ swatch_img | image_url: width: 80, height: 80, crop: 'center' }}"
          alt="{{ value | escape }}"
          class="liujo-swatch-circle-img"
          width="26"
          height="26"
          loading="lazy"
        >
      {%- else -%}
        <span
          class="liujo-swatch-circle-inner"
          style="background-color: {{ swatch_color }};"
        ></span>
      {%- endif -%}
    </label>
  {%- elsif picker_type == 'swatch' -%}
    {%- capture help_text -%}
      <span class="visually-hidden">{{ escaped_value }}</span>
      {{ label_unavailable }}
    {%- endcapture -%}

    {%
      render 'swatch-input',
      id: input_id,
      name: input_name,
      value: escaped_value,
      swatch: value.swatch,
      product_form_id: product_form_id,
      checked: value.selected,
      visually_disabled: option_disabled,
      shape: block.settings.swatch_shape,
      help_text: help_text,
      additional_props: input_dataset
    %}
  {%- elsif picker_type == 'button' -%}
    <input
      type="radio"
      id="{{ input_id }}"
      name="{{ input_name | escape }}"
      value="{{ escaped_value }}"
      form="{{ product_form_id }}"
      class="liujo-size-radio"
      {% if value.selected %}
        checked
      {% endif %}
      {% if option_disabled %}
        class="disabled"
      {% endif %}
      {{ input_dataset }}
    >
    <label for="{{ input_id }}" class="liujo-size-box-label">
      {{ value -}}
      {{ label_unavailable }}
    </label>
  {%- elsif picker_type == 'dropdown' or picker_type == 'swatch_dropdown' -%}
    <option
      id="{{ input_id }}"
      value="{{ escaped_value }}"
      {% if value.selected %}
        selected="selected"
      {% endif %}
      {% if swatch_value and picker_type == 'swatch_dropdown' %}
        data-option-swatch-value="{{ swatch_value }}"
        {% if swatch_focal_point %}
          data-option-swatch-focal-point="{{ swatch_focal_point }}"
        {% endif %}
      {% endif %}
      {{ input_dataset }}
    >
      {% if option_disabled -%}
        {{- 'products.product.value_unavailable' | t: option_value: value -}}
      {%- else -%}
        {{- value -}}
      {%- endif %}
    </option>
  {%- endif -%}
{%- endfor -%}
